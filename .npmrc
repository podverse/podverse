# Mobile Expo monorepo — layer 1 of 4 (see mobile-expo-monorepo skill).
# Disables npm auto-install of peer deps. Without this, expo-dev-client peers (expo@*) can pull
# latest expo@57 / react-native@0.86 to the repo root, breaking CocoaPods and Metro.
# Version pinning is separate: root package.json overrides (layer 2) + mobile toolchain devDeps
# (layer 3) + explicit expo-dev-* deps in apps/mobile/package.json (layer 4).
legacy-peer-deps=true
