# Dependencies (reinstalled inside Docker)
node_modules/

# Git
.git/
.gitignore

# Build outputs (rebuilt inside Docker)
dist/
.next/
out/
*.tsbuildinfo

# Documentation
docs/
*.md
AGENTS.md
LICENSE

# Infrastructure (not needed in app images; excludes feeds DB infra/data/dev/podcast-index-feeds from build context and image)
infra/
scripts/add-by-rss/
scripts/audit/
scripts/database/
scripts/dev/
scripts/ghcr/
scripts/git-hooks/
scripts/keyvaldb/
scripts/management/
scripts/mq/
scripts/podcast-index/
scripts/publish/

tools/

# IDE and CI
.cursor/
.github/
.vscode/
*.code-workspace

# LLM history and plans
.llm/

# Environment files (secrets - not needed in build)
# Exclude all env directories, but allow .env files needed for Docker builds
.env*
apps/*/env/
!apps/web/env/*.env
!apps/management-web/env/*.env

# Test files
coverage/
jest*.config.*

# Misc
.DS_Store
*.log
renovate.json
Makefile*
