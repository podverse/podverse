# Dependencies
node_modules/

# Build outputs
dist/
.next/
out/

# Next.js generated type declaration (regenerated by next dev/build; path flips dev vs types)
next-env.d.ts

# TypeScript incremental build cache
*.tsbuildinfo

# Local backup of env files (e.g. before make local_env_setup)
temp/

# Environment files (contain secrets - created from .env.example or env/*.env templates)
# Root-level
.env
.env.local
.env.production.local
.env.development.local

# App-specific (backend apps)
apps/*/.env
apps/*/.env.local

# OpenAI API key for i18n translations (root level, shared across apps)
.env.openai

# i18n compiled files (generated at build time from originals + overrides)
apps/*/i18n/compiled/

# Infra config files (gitignored - contain secrets)
infra/config/local/
infra/config/alpha/*
!infra/config/alpha/.gitkeep
infra/pipelines/jenkins/alpha/setup/jenkins-sync.env
dev/env-overrides/local/*.env
!dev/env-overrides/local/*.env.example

# The following ARE committed (sanitized templates without secrets):
# - apps/*/.env.example
# - apps/*/env/*.env (web app environment templates)
# - infra/config/env-templates/*.env.example
# - infra/config/test/ (test config can be committed)

# Podcast Index feeds DB (dev/test; downloaded at runtime by devPiBulkFeedsAddFromFile)
infra/data/dev/podcast-index-feeds/*.csv
infra/data/dev/podcast-index-feeds/*.db
infra/data/dev/podcast-index-feeds/*.tgz
!infra/data/dev/podcast-index-feeds/.gitkeep

# Logs
*.log
npm-debug.log*
# Ignore log files in logs directory, but allow tracking directory structure
logs/*
!logs/.gitkeep
!logs/LOGS.md

# IDE
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test coverage
coverage/

# Misc
*.tgz
.cache/

# Local test-assets overrides
tools/test-assets/config/ln-recipients.local.json

.direnv

secrets

temp/

.artifacts/

# LLM / editor: see docs/development/llm/README.md. Canonical: .llm/exports/<id>/.gitkeep, allowed-targets.mjs
# Machine-generated under each target (CI on develop writes with git add -f; do not hand-commit):
# allowlisted ids — scripts/llm/allowed-targets.mjs (ALLOWED_TARGET_IDS)
/.llm/exports/github-copilot/skills/
/.llm/exports/github-copilot/instructions/
/.llm/exports/github-copilot/copilot-instructions.md
# .copilot/
# .github/copilot-instructions.md.local
# --- other local editors (not necessarily in the allowlist) ---
# .windsurf/
# .aider*
# .cline/
