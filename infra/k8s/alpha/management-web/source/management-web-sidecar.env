# podverse-management-web-runtime-config: merge overrides for runtime-config sidecar (NEXT_PUBLIC_*).
# SSR: Next server → ClusterIP Service in the same namespace (avoids ingress/TLS for pod-to-pod).
# Browser-facing API host/protocol belong in management-web.env or your GitOps overlay (not here).

READINESS_API_EXPECTED_RELEASE=X.Y.Z-staging.N

NEXT_PUBLIC_SSR_API_PROTOCOL=http
NEXT_PUBLIC_SSR_API_HOST=podverse-management-api
NEXT_PUBLIC_SSR_API_PORT=3100
