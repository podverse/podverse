# Copy into GitOps common ConfigMap generator when extensions are enabled.
# Merge into podverse-extensions-config with extensions.env and extension-sidecar-otel.env.
# Canonical source: infra/k8s/base/extensions/source/extension-prometheus.env

# Extension Prometheus sidecar (sidecar containers only).
# Contract: docs/operations/extensions/EXTENSIONS-SIDECAR.md

PROMETHEUS_METRICS_PORT=9464
PROMETHEUS_METRICS_PATH=/extensions/prometheus/metrics
PROMETHEUS_COLLECT_PROCESS_METRICS=true
