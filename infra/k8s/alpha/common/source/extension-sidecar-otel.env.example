# Copy into GitOps common ConfigMap generator when extensions are enabled.
# Merge into podverse-extensions-config with extensions.env and extension-prometheus.env.
# Canonical source: infra/k8s/base/extensions/source/extension-sidecar-otel.env

# Extension sidecar — OpenTelemetry collector (sidecar containers only).
# Not app Observability (OTEL_TRACES_EXPORT lives in per-workload app env).
# Contract: docs/operations/extensions/EXTENSIONS-SIDECAR.md

# OTLP HTTP listen port on extension sidecars (loopback only; must match app OTEL_EXPORTER_OTLP_ENDPOINT port)
OTEL_RECEIVER_OTLP_HTTP_PORT=4318

# Sidecar trace forwarding (downstream export — distinct from app OTEL_TRACES_EXPORT)
# Forward mode: none (drop), debug (collector logs), otlp (forward to backend)
OTEL_TRACES_EXPORTER_MODE=none
# Required when OTEL_TRACES_EXPORTER_MODE=otlp (Tempo/Jaeger/vendor OTLP HTTP)
OTEL_TRACES_EXPORTER_OTLP_ENDPOINT=
# Optional comma-separated Key=Value headers for trace forward exporter
OTEL_TRACES_EXPORTER_OTLP_HEADERS=
