# Extensions (main app process) — podverse-extensions-config
# Sidecar keys: extension-sidecar-otel.env, extension-prometheus.env (same ConfigMap).
# Per-app OTEL_SERVICE_NAME stays in app ConfigMaps.
#
# Contract: docs/operations/platform/DOCS-OPERATIONS-PLATFORM.md

# OpenTelemetry export (app process)
# OTLP HTTP endpoint apps use when an extension toggle (e.g. Prometheus) is enabled.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Prometheus extension
# When true, also set OTEL_* above and per-app OTEL_SERVICE_NAME.
# Enablement requires BOTH PROMETHEUS_ENABLED=true here AND prometheus-sidecar component on each workload overlay.
PROMETHEUS_ENABLED=false
