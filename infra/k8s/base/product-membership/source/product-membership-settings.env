# Trial length (seconds), pricing (USD numbers), RSS / refresh tier caps, and tier feature flags —
# align with apps/api .env.example and apps/management-api .env.example.
# podverse-product-membership-config: consumed by api and management-api deployments (envFrom).
# Compose base/product-membership in alpha/common (or GitOps common overlay), not per workload app.
# After migration 0030, trial seconds are stored in app DB (product_membership_settings); these values seed new rows / fallback.
MEMBERSHIP_FREE_TRIAL_EXPIRATION=2678400
MEMBERSHIP_PREMIUM_COST_MONTHLY=3
MEMBERSHIP_PREMIUM_COST_ANNUALLY=30
MEMBERSHIP_TRIAL_MAX_ADD_BY_RSS_FEEDS=10
MEMBERSHIP_TRIAL_MAX_MANUAL_REFRESHES_PER_HOUR=5
MEMBERSHIP_PREMIUM_MAX_ADD_BY_RSS_FEEDS=100
MEMBERSHIP_PREMIUM_MAX_MANUAL_REFRESHES_PER_HOUR=20
MEMBERSHIP_TRIAL_ALLOW_DIRECTORY_ADD_BY_RSS=false
MEMBERSHIP_TRIAL_TRACK_STATS=false
MEMBERSHIP_TRIAL_ALLOW_NOTIFICATIONS=true
MEMBERSHIP_PREMIUM_ALLOW_DIRECTORY_ADD_BY_RSS=true
MEMBERSHIP_PREMIUM_TRACK_STATS=true
MEMBERSHIP_PREMIUM_ALLOW_NOTIFICATIONS=true
