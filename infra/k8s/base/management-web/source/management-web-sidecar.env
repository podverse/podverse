NODE_ENV=production

READINESS_API_BASE_URL=http://podverse-management-api:3100
READINESS_API_META_PATH=/api/v2/meta
READINESS_API_EXPECTED_VERSION=/v2
READINESS_API_EXPECTED_RELEASE=X.X.X-staging.N

NEXT_PUBLIC_SSR_API_PROTOCOL=https
NEXT_PUBLIC_SSR_API_HOST=management-api.example.com
NEXT_PUBLIC_SSR_API_PORT=

NEXT_PUBLIC_API_PROTOCOL=https
NEXT_PUBLIC_API_HOST=management-api.example.com
NEXT_PUBLIC_API_PORT=
NEXT_PUBLIC_API_PREFIX=/api
NEXT_PUBLIC_API_VERSION=/v2

NEXT_PUBLIC_BRAND_NAME=Example Management
NEXT_PUBLIC_BRAND_DOMAIN=example.com
# PWA + head icons: path-absolute URLs to files under public/favicon/ in the image; override with https://… for white-label.
# Manifest name/short_name come from NEXT_PUBLIC_BRAND_NAME (see app/manifest.ts).
NEXT_PUBLIC_BRAND_APP_ICON_192_URL=/favicon/web-app-manifest-192x192.png
NEXT_PUBLIC_BRAND_APP_ICON_512_URL=/favicon/web-app-manifest-512x512.png
NEXT_PUBLIC_BRAND_THEME_COLOR=#ffffff
NEXT_PUBLIC_BRAND_BACKGROUND_COLOR=#ffffff
NEXT_PUBLIC_BRAND_FAVICON_ICO_URL=/favicon/favicon.ico
NEXT_PUBLIC_BRAND_FAVICON_SVG_URL=/favicon/favicon.svg
NEXT_PUBLIC_BRAND_FAVICON_PNG_96_URL=/favicon/favicon-96x96.png
NEXT_PUBLIC_BRAND_APPLE_TOUCH_ICON_URL=/favicon/apple-touch-icon.png

NEXT_PUBLIC_FEATURES_SUPPORTED_LOCALES=all-available
NEXT_PUBLIC_FEATURES_DEFAULT_LOCALE=en-US

NEXT_PUBLIC_SUPPORTED_THEMES=all-available
NEXT_PUBLIC_DEFAULT_THEME=dark

# Trial/pricing/RSS limits: management-web loads `/api/v2/product/membership` from management-api (podverse-product-membership-config on api + management-api).
