NODE_ENV=production
USER_AGENT=Example Bot/Workers/5
LOG_LEVEL=info
LOG_DIR=
LOG_TIMER=true

DB_HOST=podverse-db
DB_PORT=5432
DB_SSL_CONNECTION=false

PODCAST_INDEX_BASE_URL=https://api.podcastindex.org/api/1.0
PODCAST_INDEX_API_RATE_LIMIT_DELAY=200
PODCAST_INDEX_API_MAX_RETRIES=3
PODCAST_INDEX_API_RETRY_BASE_DELAY_MS=5000

MESSAGE_QUEUE_PROTOCOL=amqp
MESSAGE_QUEUE_HOST=podverse-mq
MESSAGE_QUEUE_PORT=5672

BUCKET_PROVIDER=
BUCKET_REGION=
BUCKET_NAME=
BUCKET_CDN_BASE_URL=
# BUCKET_ENDPOINT: S3 API base URL (required for garage and s3-compatible; optional override elsewhere).
BUCKET_ENDPOINT=
# BUCKET_FORCE_PATH_STYLE: unset uses provider default (see docs/image-shrinking/BUCKET-PROVIDERS.md).
BUCKET_FORCE_PATH_STYLE=

IMAGE_SHRINK_WIDTH_PX=400
IMAGE_SHRINK_WEBP_QUALITY=92
IMAGE_SHRINK_BATCH_SIZE=250
IMAGE_SHRINK_CONCURRENCY=5
IMAGE_SHRINK_RPS=2
IMAGE_SHRINK_MAX_SOURCE_BYTES=20971520
IMAGE_SHRINK_RECHECK_EXPIRATION=86400
IMAGE_SHRINK_DEEP_RECHECK_EXPIRATION=604800
IMAGE_SHRINK_SOURCE_PRUNE_EXPIRATION=2592000

IMAGE_SHRINK_ORPHAN_CLEANUP_DRY_RUN=true
IMAGE_SHRINK_ORPHAN_CLEANUP_MAX_DELETE=
IMAGE_SHRINK_ORPHAN_MIN_AGE_EXPIRATION=604800
IMAGE_SHRINK_ORPHAN_CLEANUP_PAGE_SIZE=500

KEYVALDB_HOST=podverse-keyvaldb
KEYVALDB_PORT=6379
KEYVALDB_CACHE_EXPIRATION=3600
OPML_IMPORT_MAX_FEEDS_PER_HOUR=50

WEB_PROTOCOL=https
WEB_DOMAIN=web.example.com
WEB_ICON_IMAGE_PATH=https://example.com/favicon/web-app-manifest-192x192.png

BRAND_NAME=Example

GOOGLE_FIREBASE_NOTIFICATIONS_ENABLED=
GOOGLE_FIREBASE_ADMIN_JSON_KEY_PATH=

WEBPUSH_ENABLED=
WEBPUSH_VAPID_PUBLIC_KEY=
# WEBPUSH_VAPID_PRIVATE_KEY: in `podverse-workers-webpush-opaque` only (not in this ConfigMap)
WEBPUSH_VAPID_SUBJECT=mailto:contact@example.com

DEFAULT_ACCOUNT_SETTINGS_LOCALE=en-US

PARSER_ADD_REMOTE_ITEMS_TO_MQ=

PARSER_SPAM_FEED_ITEM_THRESHOLD_DEFAULT=10000
PARSER_SPAM_FEED_ITEM_THRESHOLD_SPAM_PERMITTED=100000

PARSER_MAX_FEED_BODY_BYTES=

NOTIFICATION_RETENTION_DAYS=30

# Finished scheduled_job rows; separate from the notification window above.
SCHEDULED_JOB_RETENTION_DAYS=30

# On-demand parse request records; deleteOutdatedOnDemandParserEvent -days overrides for one run.
ON_DEMAND_PARSER_EVENT_RETENTION_DAYS=30

STATS_TRACK_EVENT_RETENTION_DAYS=30

# Observability — per-app OTEL_SERVICE_NAME (see docs/operations/observability/TRACING.md).
# Shared OTEL_EXPORTER_OTLP_ENDPOINT and PROMETHEUS_* → podverse-extensions-config (alpha/common).
OTEL_SERVICE_NAME=podverse-worker
