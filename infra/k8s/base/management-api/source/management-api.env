NODE_ENV=production
BRAND_NAME=Example
LOG_LEVEL=info
LOG_DIR=

API_PORT=3100
API_PREFIX=/api
API_VERSION=/v2

COOKIE_DOMAIN=.example.com
AUTH_JWT_EXPIRATION=31536000
AUTH_ALLOW_TOKEN_IN_RESPONSE_BODY=false
API_ALLOWED_CORS_ORIGINS=http://podverse-management-web:3102

USER_AGENT=Example Bot/Management-API/5

WEB_PROTOCOL=http
WEB_DOMAIN=podverse-management-web:3102

DB_HOST=podverse-db
DB_PORT=5432
DB_SSL_CONNECTION=false
MANAGEMENT_API_EXPECTED_MIGRATION_FILENAME=0003_database_audit_log.sql
MANAGEMENT_API_SET_PASSWORD_EXPIRATION=604800
