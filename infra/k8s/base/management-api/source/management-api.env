NODE_ENV=production
BRAND_NAME=Example
LOG_LEVEL=info
LOG_DIR=

API_PORT=3100
API_PREFIX=/api
API_VERSION=/v2
API_RELEASE=X.Y.Z-staging.N

COOKIE_DOMAIN=.example.com
AUTH_JWT_EXPIRATION=31536000
# Mobile access JWT lifetime in seconds. Blank uses 900.
AUTH_MOBILE_ACCESS_TOKEN_EXPIRATION=900
# Mobile refresh JWT lifetime in seconds. Blank uses 31536000.
AUTH_MOBILE_REFRESH_TOKEN_EXPIRATION=31536000
AUTH_ALLOW_TOKEN_IN_RESPONSE_BODY=false
API_ALLOWED_CORS_ORIGINS=http://podverse-management-web:3102

USER_AGENT=Example Bot/Management-API/5

APP_WEB_PROTOCOL=http
APP_WEB_DOMAIN=podverse-web:3002
MANAGEMENT_WEB_PROTOCOL=http
MANAGEMENT_WEB_DOMAIN=podverse-management-web:3102

DB_HOST=podverse-db
DB_PORT=5432
DB_SSL_CONNECTION=false
MANAGEMENT_API_EXPECTED_MIGRATION_FILENAME=0003_billing_permissions.sql
MANAGEMENT_API_SET_PASSWORD_EXPIRATION=604800

# Membership pricing, trial bootstrap, tier caps, and feature flags: podverse-product-membership-config

#####
##### Billing
#####
# BILLING_RENEWAL_ENTITLEMENT_BUFFER_EXPIRATION: seconds past an auto-renew period end (48 hours).
BILLING_RENEWAL_ENTITLEMENT_BUFFER_EXPIRATION=172800
# BILLING_PAYMENT_FAILURE_GRACE_EXPIRATION: seconds after a failed renewal charge (7 days).
BILLING_PAYMENT_FAILURE_GRACE_EXPIRATION=604800
# BILLING_SANDBOX_ALLOWED_ACCOUNT_IDS: account ids whose sandbox purchases count in production.
BILLING_SANDBOX_ALLOWED_ACCOUNT_IDS=
# BILLING_ALLOW_TEST_ADAPTER: true registers the test processor when NODE_ENV is production.
BILLING_ALLOW_TEST_ADAPTER=
# "true" turns PayPal on; empty keeps it off.
BILLING_PAYPAL_ENABLED=
# PAYPAL_CLIENT_ID: Secret podverse-billing-paypal-opaque. Empty here leaves PayPal off.
PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET: Secret podverse-billing-paypal-opaque. Empty here leaves PayPal off.
PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID: Secret podverse-billing-paypal-opaque. Empty here leaves PayPal off.
PAYPAL_WEBHOOK_ID=
# PAYPAL_ENVIRONMENT: sandbox or live. Empty uses live when NODE_ENV is production.
PAYPAL_ENVIRONMENT=
# "true" turns Apple In-App Purchase on; empty keeps it off.
BILLING_APPLE_IAP_ENABLED=
# APPLE_IAP_ISSUER_ID: App Store Connect issuer id. Empty leaves Apple IAP off.
APPLE_IAP_ISSUER_ID=
# APPLE_IAP_KEY_ID: App Store Connect in-app purchase key id. Empty leaves Apple IAP off.
APPLE_IAP_KEY_ID=
# APPLE_IAP_PRIVATE_KEY_PATH: set /var/secrets/apple-iap/AuthKey.p8 when that secret is applied.
APPLE_IAP_PRIVATE_KEY_PATH=
# APPLE_IAP_BUNDLE_ID: iOS bundle id. This key alone does not enable Apple IAP.
APPLE_IAP_BUNDLE_ID=com.podverse.app.next
# APPLE_IAP_APP_APPLE_ID: numeric App Store app id.
APPLE_IAP_APP_APPLE_ID=
# APPLE_IAP_ENVIRONMENT: sandbox or production. Empty follows NODE_ENV.
APPLE_IAP_ENVIRONMENT=
# "true" turns Google Play on; empty keeps it off.
BILLING_GOOGLE_PLAY_ENABLED=
# GOOGLE_PLAY_PACKAGE_NAME: Android package. This key alone does not enable Google Play.
GOOGLE_PLAY_PACKAGE_NAME=com.podverse.app.next
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH: /var/secrets/google-play/service-account.json when applied.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=
# GOOGLE_PLAY_RTDN_PUSH_AUDIENCE: OIDC audience on the RTDN push subscription.
GOOGLE_PLAY_RTDN_PUSH_AUDIENCE=
# GOOGLE_PLAY_RTDN_PUSH_SERVICE_ACCOUNT_EMAIL: service account email on that push subscription.
GOOGLE_PLAY_RTDN_PUSH_SERVICE_ACCOUNT_EMAIL=

# Observability — per-app OTEL_SERVICE_NAME (see docs/operations/observability/TRACING.md).
# Shared OTEL_EXPORTER_OTLP_ENDPOINT and PROMETHEUS_* → podverse-extensions-config (alpha/common).
OTEL_SERVICE_NAME=podverse-management-api
