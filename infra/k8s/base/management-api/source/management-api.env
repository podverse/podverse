NODE_ENV=production
BRAND_NAME=Podverse
LOG_LEVEL=info
LOG_DIR=

API_PORT=3100
API_PREFIX=/api
API_VERSION=/v1

COOKIE_DOMAIN=base.podverse.fm
AUTH_JWT_EXPIRES_IN=365d
AUTH_ALLOW_TOKEN_IN_RESPONSE_BODY=false
API_ALLOWED_CORS_ORIGINS=http://podverse-management-web:3102

USER_AGENT=Podverse Bot base/Management-API/5

WEB_PROTOCOL=http
WEB_DOMAIN=podverse-management-web:3102

DB_HOST=podverse-db
DB_PORT=5432
DB_SSL_CONNECTION=
