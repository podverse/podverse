NODE_ENV=production
LOG_LEVEL=info
LOG_DIR=
SERVER_ENV=base

API_PORT=3000
API_PREFIX=/api
API_VERSION=/v2
API_RELEASE=X.X.X-staging.N
API_ALLOWED_CORS_ORIGINS=http://podverse-web:3002

USER_AGENT=Example Bot/API/5
COOKIE_DOMAIN=.example.com
AUTH_JWT_EXPIRATION=31536000
AUTH_ALLOW_TOKEN_IN_RESPONSE_BODY=false

BRAND_NAME=Example
WEB_PROTOCOL=http
WEB_DOMAIN=podverse-web:3002
WEB_ICON_IMAGE_PATH=https://example.com/favicon/web-app-manifest-192x192.png

DB_HOST=podverse-db
DB_PORT=5432
DB_SSL_CONNECTION=false
API_EXPECTED_MIGRATION_FILENAME=0020_image_shrink_last_deep_checked_at.sql

KEYVALDB_HOST=podverse-keyvaldb
KEYVALDB_PORT=6379
KEYVALDB_CACHE_EXPIRATION=86400

MESSAGE_QUEUE_PROTOCOL=amqp
MESSAGE_QUEUE_HOST=podverse-mq
MESSAGE_QUEUE_PORT=5672

PODCAST_INDEX_BASE_URL=https://api.podcastindex.org/api/1.0
PODCAST_INDEX_API_RATE_LIMIT_DELAY=200

ACCOUNT_SIGNUP_MODE=admin_only_username
PREMIUM_MEMBERSHIP_COST_MONTHLY=
PREMIUM_MEMBERSHIP_COST_ANNUALLY=
FREE_TRIAL_EXPIRATION=

MAILER_HOST=
MAILER_PORT=
# MAILER_USERNAME: secret, set in Secret `podverse-mailer-opaque` (not in this ConfigMap)
# MAILER_PASSWORD: secret, set in Secret `podverse-mailer-opaque` (not in this ConfigMap)
MAILER_FROM=

# BRAND_COLOR_PRIMARY: primary CSS accent (API email CTA, etc.)
BRAND_COLOR_PRIMARY=#2968B1
# BRAND_BANNER_IMAGE_3X1_URL: absolute URL for 3:1 brand banner (API email, etc.)
BRAND_BANNER_IMAGE_3X1_URL=https://example.com/branding/banner_3x1.png
LEGAL_NAME=Your Company Name
LEGAL_ADDRESS=Your City, State, Country

VERIFY_EMAIL_TOKEN_EXPIRATION=31540000
EMAIL_CHANGE_VERIFICATION_TOKEN_EXPIRATION=31540000
RESET_PASSWORD_TOKEN_EXPIRATION=86400

SOCIAL_FACEBOOK_PAGE_URL=
SOCIAL_FACEBOOK_IMAGE_URL=
SOCIAL_GITHUB_PAGE_URL=
SOCIAL_GITHUB_IMAGE_URL=
SOCIAL_TWITTER_PAGE_URL=
SOCIAL_TWITTER_IMAGE_URL=

# ADD_BY_RSS_CREDENTIALS_ENCRYPTION_KEY: secret, set in `podverse-workers-add-by-rss-opaque` (not in this ConfigMap)
DEFAULT_ACCOUNT_SETTINGS_LOCALE=en-US

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# METABOOST_SIGNING_KEY_PEM: optional; set in Secret `podverse-metaboost-opaque` if used (not in this ConfigMap)
# METABOOST_APP_ASSERTION_ISS: optional; set in Secret `podverse-metaboost-opaque` if used (not in this ConfigMap)

GOOGLE_FIREBASE_NOTIFICATIONS_ENABLED=
GOOGLE_FIREBASE_ADMIN_JSON_KEY_PATH=

WEBPUSH_ENABLED=
WEBPUSH_VAPID_PUBLIC_KEY=
# WEBPUSH_VAPID_PRIVATE_KEY: in `podverse-workers-webpush-opaque` only (not in this ConfigMap)
WEBPUSH_VAPID_SUBJECT=mailto:contact@example.com
