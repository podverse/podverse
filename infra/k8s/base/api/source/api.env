NODE_ENV=production
LOG_LEVEL=info
LOG_DIR=
SERVER_ENV=base

API_PORT=3000
API_PREFIX=/api
API_VERSION=/v2
API_RELEASE=X.Y.Z-staging.N
API_ALLOWED_CORS_ORIGINS=http://podverse-web:3002

USER_AGENT=Example Bot/API/5
COOKIE_DOMAIN=.example.com
# Session idle limit in seconds for every client; each use renews it. Blank uses 31536000.
AUTH_SESSION_IDLE_EXPIRATION=31536000
# Token-client (mobile) access token lifetime in seconds; refreshed silently, so not a sign-in length. Blank uses 900.
AUTH_ACCESS_TOKEN_EXPIRATION=900
AUTH_ALLOW_TOKEN_IN_RESPONSE_BODY=false
AUTH_LOGIN_MAX_PER_MINUTE=5
ACCOUNT_CREATE_MAX_PER_10_MINUTES=3
ACCOUNT_SEND_VERIFICATION_EMAIL_MAX_PER_10_MINUTES=4
ACCOUNT_VERIFY_EMAIL_MAX_PER_10_MINUTES=10
ACCOUNT_SEND_CHANGE_EMAIL_MAX_PER_10_MINUTES=4
ACCOUNT_VERIFY_EMAIL_CHANGE_MAX_PER_10_MINUTES=10
ACCOUNT_SEND_RESET_PASSWORD_EMAIL_MAX_PER_10_MINUTES=4
ACCOUNT_RESET_PASSWORD_MAX_PER_10_MINUTES=4
ACCOUNT_SET_PASSWORD_MAX_PER_10_MINUTES=4
ACCOUNT_CHANGE_PASSWORD_MAX_PER_10_MINUTES=4
ACCOUNT_DOWNLOAD_DATA_MAX_PER_DAY=3
ACCOUNT_OPML_EXPORT_MAX_PER_HOUR=10
ACCOUNT_OPML_IMPORT_ENQUEUE_MAX_PER_HOUR=10
ACCOUNT_ADD_BY_RSS_PARSE_ENQUEUE_MAX_PER_HOUR=20
ACCOUNT_ADD_BY_RSS_CHAPTERS_TRANSCRIPT_MAX_PER_MINUTE=30
ACCOUNT_ADD_BY_RSS_REMOTE_ITEM_RESOLVE_MAX_PER_MINUTE=30
ACCOUNT_CHANNEL_SEEN_READ_MAX_PER_MINUTE=60
STATS_TRACK_MAX_PER_MINUTE=60
MQ_RSS_ON_DEMAND_MAX_PER_HOUR=20

BRAND_NAME=Example
WEB_PROTOCOL=http
WEB_DOMAIN=podverse-web:3002
WEB_ICON_IMAGE_PATH=https://example.com/favicon/web-app-manifest-192x192.png

DB_HOST=podverse-db
DB_PORT=5432
DB_SSL_CONNECTION=false
API_EXPECTED_MIGRATION_FILENAME=0002_remote_stubs.sql

KEYVALDB_HOST=podverse-keyvaldb
KEYVALDB_PORT=6379
KEYVALDB_CACHE_EXPIRATION=86400

MESSAGE_QUEUE_PROTOCOL=amqp
MESSAGE_QUEUE_HOST=podverse-mq
MESSAGE_QUEUE_PORT=5672

# Milliseconds a device stays in the device menu after its account event stream closes. Required.
PLAYBACK_PRESENCE_LEAVE_GRACE_MS=5000

PODCAST_INDEX_BASE_URL=https://api.podcastindex.org/api/1.0
PODCAST_INDEX_API_RATE_LIMIT_DELAY=200
PODCAST_INDEX_API_MAX_RETRIES=3
PODCAST_INDEX_API_RETRY_BASE_DELAY_MS=5000
PODCAST_INDEX_SEARCH_MAX=50

ACCOUNT_SIGNUP_MODE=admin_only_username
# Membership pricing, trial bootstrap, tier caps, and feature flags: podverse-product-membership-config

MAILER_HOST=
MAILER_PORT=
# MAILER_USERNAME: secret, set in Secret `podverse-mailer-opaque` (not in this ConfigMap)
# MAILER_PASSWORD: secret, set in Secret `podverse-mailer-opaque` (not in this ConfigMap)
MAILER_FROM=

# BRAND_COLOR_PRIMARY: primary CSS accent (API email CTA, etc.)
BRAND_COLOR_PRIMARY=#2968B1
# BRAND_BANNER_IMAGE_3X1_URL: absolute URL for 3:1 brand banner (API email, etc.)
BRAND_BANNER_IMAGE_3X1_URL=https://example.com/branding/banner_3x1.png
LEGAL_NAME=Your Company Name
LEGAL_ADDRESS=Your City, State, Country
# Date-shaped id stored on accept. A new value re-prompts every account and is shown as Valid since.
TERMS_OF_SERVICE_VERSION=2026-10-15
# Optional mount for localized Markdown. Empty uses the files bundled in the API image.
TERMS_OF_SERVICE_CONTENT_DIR=
# Interpolated into the terms document.
CONTACT_EMAIL=contact@example.com
# Interpolated into the terms document. Empty uses 90 days.
STATS_TRACK_EVENT_RETENTION_DAYS=90
# Stored listens per listener per UTC day; each feeds the listener's Taste Profile. Empty uses 300.
STATS_LISTEN_DAILY_STORED_CAP=300
# Server seconds between one listener's new stored listens; 0 turns the check off. Empty uses 20.
STATS_LISTEN_MIN_INTERVAL_SECONDS=20
# Stored listens per listener per UTC day that count toward popularity; at most STATS_LISTEN_DAILY_STORED_CAP. Empty uses 100.
STATS_LISTEN_DAILY_POPULARITY_CAP=100
# Counted profile and playlist opens per listener per UTC day, together. Empty uses 10.
STATS_OPEN_DAILY_CAP=10
# Days in which one listener adds to an entity's all-time popularity at most once, and days after an opt-out during which new listens count toward no popularity total. Must not be above STATS_TRACK_EVENT_RETENTION_DAYS, or the API does not start. Empty uses 90.
STATS_ALL_TIME_RECOUNT_DAYS=90
# Too-soon minutes in one unbroken run (no gap over 2 minutes) that flag a listener out of popularity; items and clips under 60 seconds do not count; 0 turns it off. Empty uses 30.
STATS_FLAG_TOO_SOON_MINUTES=30
# Hours from a listener's first stored listen of a UTC day within which reaching STATS_LISTEN_DAILY_STORED_CAP flags the listener out of popularity; 0 turns it off. Empty uses 3.
STATS_FLAG_STORED_CAP_WITHIN_HOURS=3
# Date-shaped id. A new value re-prompts accounts that already accepted. The explanation does not display this id.
TASTE_PROFILE_AGREEMENT_VERSION=2026-10-21
# Optional mount for localized Markdown. Empty uses the files bundled in the API image.
TASTE_PROFILE_AGREEMENT_CONTENT_DIR=
# Optional mount for managed-copy markdown. Empty uses the files bundled in the API image.
MANAGED_COPY_CONTENT_DIR=

VERIFY_EMAIL_TOKEN_EXPIRATION=31540000
EMAIL_CHANGE_VERIFICATION_TOKEN_EXPIRATION=31540000
RESET_PASSWORD_TOKEN_EXPIRATION=86400

SOCIAL_FACEBOOK_PAGE_URL=
SOCIAL_FACEBOOK_IMAGE_URL=
SOCIAL_GITHUB_PAGE_URL=
SOCIAL_GITHUB_IMAGE_URL=
SOCIAL_TWITTER_PAGE_URL=
SOCIAL_TWITTER_IMAGE_URL=
SOCIAL_REDDIT_PAGE_URL=
SOCIAL_REDDIT_IMAGE_URL=

# ADD_BY_RSS_CREDENTIALS_ENCRYPTION_KEY: secret, set in `podverse-workers-add-by-rss-opaque` (not in this ConfigMap)
OPML_IMPORT_MAX_FEEDS_PER_HOUR=50
DEFAULT_ACCOUNT_SETTINGS_LOCALE=en-US

#####
##### Billing
#####
# BILLING_WEBHOOK_PUBLIC_BASE_URL: public HTTPS base for processor webhooks, no trailing slash.
BILLING_WEBHOOK_PUBLIC_BASE_URL=
# BILLING_SANDBOX_ALLOWED_ACCOUNT_IDS: account ids whose sandbox purchases count in production.
BILLING_SANDBOX_ALLOWED_ACCOUNT_IDS=
# BILLING_SANDBOX_GRANT_ALL: true grants Premium from every sandbox purchase on a production Node process.
BILLING_SANDBOX_GRANT_ALL=
# BILLING_ALLOW_TEST_ADAPTER: true registers the test processor when NODE_ENV is production.
BILLING_ALLOW_TEST_ADAPTER=
# "true" turns PayPal on; empty keeps it off.
BILLING_PAYPAL_ENABLED=
# PAYPAL_CLIENT_ID: Secret podverse-billing-paypal-opaque. Empty here leaves PayPal off.
PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET: Secret podverse-billing-paypal-opaque. Empty here leaves PayPal off.
PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID: Secret podverse-billing-paypal-opaque. Empty here leaves PayPal off.
PAYPAL_WEBHOOK_ID=
# PAYPAL_ENVIRONMENT: sandbox or live. Empty stays sandbox. Set live to use the PayPal live API.
PAYPAL_ENVIRONMENT=
# "true" turns Apple In-App Purchase on; empty keeps it off.
BILLING_APPLE_IAP_ENABLED=
# APPLE_IAP_ISSUER_ID: App Store Connect issuer id. Empty leaves Apple IAP off.
APPLE_IAP_ISSUER_ID=
# APPLE_IAP_KEY_ID: App Store Connect in-app purchase key id. Empty leaves Apple IAP off.
APPLE_IAP_KEY_ID=
# APPLE_IAP_PRIVATE_KEY_PATH: set /var/secrets/apple-iap/AuthKey.p8 when that secret is applied.
APPLE_IAP_PRIVATE_KEY_PATH=
# APPLE_IAP_BUNDLE_ID: iOS bundle id. This key alone does not enable Apple IAP.
APPLE_IAP_BUNDLE_ID=com.podverse.app.next
# APPLE_IAP_APP_APPLE_ID: numeric App Store app id.
APPLE_IAP_APP_APPLE_ID=
# APPLE_IAP_ENVIRONMENT: sandbox or production. Empty stays sandbox. Set production for the production App Store.
APPLE_IAP_ENVIRONMENT=
# "true" turns Google Play on; empty keeps it off.
BILLING_GOOGLE_PLAY_ENABLED=
# GOOGLE_PLAY_PACKAGE_NAME: Android package. This key alone does not enable Google Play.
GOOGLE_PLAY_PACKAGE_NAME=com.podverse.app.next
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH: /var/secrets/google-play/service-account.json when applied.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=
# GOOGLE_PLAY_RTDN_PUSH_AUDIENCE: OIDC audience on the RTDN push subscription.
GOOGLE_PLAY_RTDN_PUSH_AUDIENCE=
# GOOGLE_PLAY_RTDN_PUSH_SERVICE_ACCOUNT_EMAIL: service account email on that push subscription.
GOOGLE_PLAY_RTDN_PUSH_SERVICE_ACCOUNT_EMAIL=
# "true" turns Strike on; empty keeps it off.
BILLING_STRIKE_ENABLED=
# STRIKE_ENVIRONMENT: production or sandbox. Empty keeps Strike off.
STRIKE_ENVIRONMENT=

# METABOOST_SIGNING_KEY_PEM: optional; set in Secret `podverse-metaboost-opaque` if used (not in this ConfigMap)
# METABOOST_APP_ASSERTION_ISS: optional; set in Secret `podverse-metaboost-opaque` if used (not in this ConfigMap)

GOOGLE_FIREBASE_NOTIFICATIONS_ENABLED=
GOOGLE_FIREBASE_ADMIN_JSON_KEY_PATH=

WEBPUSH_ENABLED=
WEBPUSH_VAPID_PUBLIC_KEY=
# WEBPUSH_VAPID_PRIVATE_KEY: in `podverse-workers-webpush-opaque` only (not in this ConfigMap)
WEBPUSH_VAPID_SUBJECT=mailto:contact@example.com

# Observability — per-app OTEL_SERVICE_NAME (see docs/operations/observability/TRACING.md and observability.env.example).
# Shared OTEL_EXPORTER_OTLP_ENDPOINT and PROMETHEUS_* → podverse-extensions-config (alpha/common).
# Integrations (CLOUDFLARE_*) → podverse-integrations-config (web/management-web runtime-config sidecars only).
OTEL_SERVICE_NAME=podverse-api
