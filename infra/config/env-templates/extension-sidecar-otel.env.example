#####
##### Extension sidecar — OpenTelemetry collector
#####
# Sidecar container only. Not app Observability (OTEL_TRACES_EXPORT → observability.env.example).
# Merged into podverse-extensions-config with extensions.env + extension-prometheus.env.
#
# Local: infra/config/local/extension-sidecar-otel.env (make local_env_setup)
# K8s: infra/k8s/base/common/source/extensions/extension-sidecar-otel.env
# Package reference: extensions/sidecar-otel.env.example
#
# Used by extension sidecars that run otelcol (today: extension-prometheus).
# Apps send OTLP to OTEL_RECEIVER_OTLP_HTTP_PORT via OTEL_EXPORTER_OTLP_ENDPOINT (extensions.env).

#####
##### OTLP receiver (sidecar input)
#####

OTEL_RECEIVER_OTLP_HTTP_PORT="4318"

#####
##### Sidecar trace forwarding (downstream export)
#####
# Distinct from app OTEL_TRACES_EXPORT. Sidecar receives traces on the OTLP receiver above.
# Local dev: override OTEL_TRACES_EXPORTER_MODE=debug in infra/config/local/extension-sidecar-otel.env.

OTEL_TRACES_EXPORTER_MODE="none"
# Required when OTEL_TRACES_EXPORTER_MODE=otlp (Tempo/Jaeger/vendor OTLP HTTP)
OTEL_TRACES_EXPORTER_OTLP_ENDPOINT=
# Optional comma-separated Key=Value headers for trace forward exporter
OTEL_TRACES_EXPORTER_OTLP_HEADERS=
