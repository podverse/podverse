#####
##### Extensions (main app process)
#####
# App-facing extension toggles and OTLP transport to sidecars.
# Copied to infra/config/local/extensions.env by local_env_setup when missing.
# Kubernetes: infra/k8s/base/common/source/extensions/extensions.env → podverse-extensions-config
#
# Sidecar-only keys:
#   extension-sidecar-otel.env.example   — OTLP receiver + sidecar trace forwarding
#   extension-prometheus.env.example     — Prometheus scrape / sidecar metrics
#
# Integrations (CLOUDFLARE_WEB_ANALYTICS_*) → integrations.env.example (runtime-config sidecars only).
# Observability trace export (OTEL_TRACES_EXPORT) → observability.env.example (per-app env).
#
# Contract: docs/operations/extensions/EXTENSIONS-SIDECAR.md

#####
##### OpenTelemetry export (app process)
#####
# How apps send metrics to a collector or extension sidecar (OTLP HTTP).
# Required when PROMETHEUS_ENABLED=true (or future extension toggles).
# Per-app identity: OTEL_SERVICE_NAME in apps/*/sidecar/.env.example (web) or apps/*/.env.example (API/workers).

OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4318"

#####
##### Prometheus extension toggle
#####
# Enables extension-prometheus sidecar wiring and app OTLP export.
# When PROMETHEUS_ENABLED=true, also set OTEL_* above and per-app OTEL_SERVICE_NAME in the workload env.
# Cluster enablement also requires the prometheus sidecar Kustomize component per app.

PROMETHEUS_ENABLED="false"
