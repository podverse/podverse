##### Observability (always-on tracing)
#####
# Contract: docs/operations/observability/TRACING.md
# Web/management-web: OTEL_* in apps/*/sidecar/.env.example (synced to .env.local by local_env_setup).
# API/workers/management-api: each apps/*/.env.example and K8s workload source env.
# Not in extensions.env or integrations.env.

OTEL_SERVICE_NAME=
OTEL_TRACES_EXPORT=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=
OTEL_TRACES_SAMPLER_ARG=
