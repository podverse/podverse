#####
##### podverse-workers
##### Environment Template
#####
# This file serves as a centralized reference for Workers environment configuration.
# For the authoritative template, see: apps/workers/.env.example
# For detailed documentation, see: apps/workers/ENV.md
#
# The workers app validates env vars per-command; not all variables are required for every job.
# See apps/workers/ENV.md for per-command requirements (required vs optional by command group).
#
# Copy apps/workers/.env.example to apps/workers/.env and configure for your environment.
#####

# See apps/workers/.env.example for complete configuration template with all variables.
# See apps/workers/ENV.md for detailed documentation and per-command requirements.

#####
##### DigitalOcean
#####

DIGITAL_OCEAN_ACCESS_KEY=
DIGITAL_OCEAN_SECRET_KEY=

#####
##### Image Shrink (storage)
#####

IMAGE_CDN_REGION="nyc3"
IMAGE_CDN_BUCKET="podverse-images"
IMAGE_CDN_BASE_URL="https://podverse-images.nyc3.cdn.digitaloceanspaces.com"

#####
##### Image Shrink
#####

IMAGE_SHRINK_WIDTH_PX="300"
IMAGE_SHRINK_BATCH_SIZE="250"
IMAGE_SHRINK_CONCURRENCY="5"
IMAGE_SHRINK_RPS="2"
IMAGE_SHRINK_RECHECK_TTL_SECONDS="86400"
IMAGE_SHRINK_SOURCE_PRUNE_DAYS="30"
