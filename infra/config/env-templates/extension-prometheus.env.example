#####
##### Extension Prometheus sidecar
#####
# Sidecar container only. Merged into podverse-extensions-config with extensions.env +
# extension-sidecar-otel.env.
#
# Local: infra/config/local/extension-prometheus.env (make local_env_setup)
# K8s: infra/k8s/base/extensions/source/extension-prometheus.env
# Package reference: extensions/prometheus/.env.example
#
# When enabling in cluster/local, also configure app env (extensions.env + observability per app).

PROMETHEUS_METRICS_PORT="9464"
PROMETHEUS_METRICS_PATH="/extensions/prometheus/metrics"
PROMETHEUS_COLLECT_PROCESS_METRICS="true"

# Path to otelcol-contrib binary (set in container image; local Compose default below)
OTELCOL_CONTRIB_BINARY="/usr/local/bin/otelcol-contrib"

# Internal Prometheus exporter URL (collector → Node proxy)
PROMETHEUS_INTERNAL_METRICS_URL="http://127.0.0.1:8889/metrics"
