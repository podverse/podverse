#####
##### podverse-management-web
##### Environment Template
#####
# This file serves as a centralized reference for Management Web environment configuration.
# For environment-specific templates, see: apps/management-web/env/
#   - local.env       - Local development
#   - alpha.env       - Alpha environment
#   - beta.env        - Beta environment
#   - production.env  - Production environment
# For detailed documentation, see: apps/management-web/ENV.md
#
# These values are consumed by the runtime-config sidecar at deploy time.
#####

#####
##### Runtime Config Sidecar (app uses this to fetch config)
#####
# For local Docker: use service name. For alpha Docker: use podverse_alpha_management_web_runtime_config:3101
RUNTIME_CONFIG_URL="http://podverse_local_management_web_runtime_config:3101"

#####
##### API Configuration
#####
NEXT_PUBLIC_API_PROTOCOL="https"
NEXT_PUBLIC_API_HOST="mgmt-api.alpha.podverse.fm"
NEXT_PUBLIC_API_PORT=
NEXT_PUBLIC_API_PREFIX="/api"
NEXT_PUBLIC_API_VERSION="/v2"

#####
##### Web Configuration
#####
NEXT_PUBLIC_BRAND_NAME="Podverse Management"

#####
##### Website Features
#####
# Comma-delimited list of valid locales or "all-available"
NEXT_PUBLIC_FEATURES_SUPPORTED_LOCALES="all-available"
NEXT_PUBLIC_FEATURES_DEFAULT_LOCALE="en-US"
