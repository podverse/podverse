networks:
  podverse_alpha_network:
    external: true

services:

  podverse_alpha_api:
    image: ghcr.io/podverse/podverse/api:REPLACE_WITH_API_VERSION
    container_name: podverse_alpha_api
    env_file:
      - ../../../config/alpha/api.env
    networks:
      - podverse_alpha_network
    ports:
      - 127.0.0.1:1234:1234
    volumes:
      - ../../../../logs/api:/opt/logs
    command: npm start -w apps/api
    logging:
      driver: "syslog"
      options:
        tag: "{{.ImageName}}/{{.Name}}/{{.ID}}"
    restart: unless-stopped
