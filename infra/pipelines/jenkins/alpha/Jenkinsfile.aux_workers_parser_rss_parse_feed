pipeline {
    // Maps to <assignedNode>pv-alpha-aux</assignedNode>
    agent {
        label 'pv-alpha-aux'
    }

    // Maps to <concurrentBuild>false</concurrentBuild>
    options {
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        string(
            name: 'PODCAST_INDEX_ID', 
            description: 'The id of the feed in the Podcast Index directory.',
            trim: false
        )
    }

    stages {
        stage('Manual Feed Parse') {
            steps {
                script {
                    // Maps to 'pushd /opt/podverse/infra/docker/alpha/workers'
                    dir('/opt/podverse/infra/docker/alpha/workers') {
                        // Maps to the docker compose run command.
                        // We use triple double-quotes (""") to interpolate the Jenkins parameter.
                        // 'set -eux' is preserved to ensure we see the output (-x) and fail on error (-e).
                        sh """
                            set -eux
                            docker compose -f docker-compose.yml run --rm podverse_alpha_workers node apps/workers/dist/index.js parserRSSParseFeed -p ${params.PODCAST_INDEX_ID}
                        """
                    }
                }
            }
        }
    }
}