pipeline {
    // We set 'agent none' here because we define specific agents for each parallel stage below.
    agent none

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Stop Alpha Services') {
            parallel {
                stage('Stop on Aux') {
                    agent {
                        label 'pv-alpha-aux'
                    }
                    steps {
                        script {
                            sh 'make -f makefiles/alpha/Makefile.alpha.mk alpha_all_down'
                        }
                    }
                }

                stage('Stop on Srv') {
                    agent {
                        label 'pv-alpha-srv'
                    }
                    steps {
                        script {
                            sh 'make -f makefiles/alpha/Makefile.alpha.mk alpha_all_down'
                        }
                    }
                }
            }
        }
    }
}