pipeline {
    // Agent is set to none so we can define specific agents for parallel stages
    agent none

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        string(
            name: 'GIT_BRANCH_NAME',
            defaultValue: 'develop',
            description: 'The git branch name to check out, before pulling the latest changes for the branch.'
        )
    }

    stages {
        stage('Update Ops Repo') {
            parallel {
                stage('Update on Aux') {
                    agent {
                        label 'pv-alpha-aux'
                    }
                    steps {
                        script {
                            // Maps to logic from Jenkinsfile.aux_ops_git_pull
                            dir('/opt/podverse') {
                                // Ensure sparse checkout is enabled
                                sh '''
                                    git config core.sparseCheckout true
                                '''
                                
                                // Update sparse checkout paths to match current requirements
                                sh '''
cat > .git/info/sparse-checkout << 'EOF'
pipelines/jenkins/
infra/docker/
infra/config/
infra/database/
scripts/
Makefile
Makefile.alpha
EOF
                                '''
                                
                                sh """
                                    git checkout ${params.GIT_BRANCH_NAME}
                                    git pull origin ${params.GIT_BRANCH_NAME}
                                    
                                    # Reapply sparse checkout to ensure all paths are present
                                    git sparse-checkout reapply || git read-tree -mu HEAD
                                """
                            }
                        }
                    }
                }

                stage('Update on Srv') {
                    agent {
                        label 'pv-alpha-srv'
                    }
                    steps {
                        script {
                            // Maps to logic from Jenkinsfile.srv_ops_git_pull
                            dir('/opt/podverse') {
                                // Ensure sparse checkout is enabled
                                sh '''
                                    git config core.sparseCheckout true
                                '''
                                
                                // Update sparse checkout paths to match current requirements
                                sh '''
cat > .git/info/sparse-checkout << 'EOF'
pipelines/jenkins/
infra/docker/
infra/config/
infra/database/
scripts/
Makefile
Makefile.alpha
EOF
                                '''
                                
                                sh """
                                    git checkout ${params.GIT_BRANCH_NAME}
                                    git pull origin ${params.GIT_BRANCH_NAME}
                                    
                                    # Reapply sparse checkout to ensure all paths are present
                                    git sparse-checkout reapply || git read-tree -mu HEAD
                                """
                            }
                        }
                    }
                }
            }
        }
    }
}
