pipeline {
    // Maps to <assignedNode>pv-alpha-aux</assignedNode>
    agent {
        label 'pv-alpha-aux'
    }

    // Maps to <concurrentBuild>false</concurrentBuild>
    options {
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Flag Dead Feeds') {
            steps {
                script {
                    // Maps to 'pushd /opt/podverse/infra/docker/alpha/workers'
                    dir('/opt/podverse/infra/docker/alpha/workers') {
                        // Maps to the docker compose command.
                        // We use triple single-quotes to preserve 'set -eux' behavior strictly.
                        sh '''
                            set -eux
                            docker compose -f docker-compose.yml run --rm podverse_alpha_workers node apps/workers/dist/index.js podcastIndexDeadFeedsFlagAndMerge
                        '''
                    }
                }
            }
        }
    }
}