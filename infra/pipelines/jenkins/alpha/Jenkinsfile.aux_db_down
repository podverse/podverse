pipeline {
    // Maps to <assignedNode>pv-alpha-aux</assignedNode>
    agent {
        label 'pv-alpha-aux'
    }

    // Maps to <concurrentBuild>false</concurrentBuild>
    options {
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Stop Alpha DB') {
            steps {
                script {
                    // Maps to 'pushd /opt/podverse'
                    dir('/opt/podverse') {
                        // Maps to 'make alpha_db_down'
                        sh 'make -f makefiles/alpha/Makefile.alpha.mk alpha_db_down'
                    }
                }
            }
        }
    }
}