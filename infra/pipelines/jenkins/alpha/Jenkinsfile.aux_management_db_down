pipeline {
    agent {
        label 'pv-alpha-aux'
    }

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Stop Alpha Management Database') {
            steps {
                script {
                    dir('/opt/podverse') {
                        sh 'make -f makefiles/alpha/Makefile.alpha.mk alpha_management_db_down'
                    }
                }
            }
        }
    }
}
