pipeline {
    // Maps to <assignedNode>pv-alpha-aux</assignedNode>
    agent {
        label 'pv-alpha-aux'
    }

    // Maps to <concurrentBuild>false</concurrentBuild>
    options {
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Stop Alpha MQ') {
            steps {
                // Run make in workspace so we use the checked-out repo; /opt/podverse may not exist on aux.
                sh '''
                    set -ux
                    make -f makefiles/alpha/Makefile.alpha.mk alpha_mq_down
                '''
            }
        }
    }
}