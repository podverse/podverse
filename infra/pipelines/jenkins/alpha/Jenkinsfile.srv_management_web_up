pipeline {
    // Maps to <assignedNode>pv-alpha-srv</assignedNode>
    agent {
        label 'pv-alpha-srv'
    }

    // Maps to <concurrentBuild>false</concurrentBuild>
    options {
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        string(
            name: 'IMAGE_VERSION',
            defaultValue: 'alpha',
            description: 'Specify the podverse_management_web alpha docker image version.'
        )

        choice(
            name: 'GHCR_IMAGE_PATH',
            choices: ['podverse/podverse/management-web-deploy'],
            description: 'The path to the image hosted in GHCR.'
        )

        string(
            name: 'GHCR_REGISTRY_TOKEN',
            defaultValue: 'ghcr_pat_read_only_packages',
            description: 'The Jenkins credential ID containing the GHCR PAT'
        )
    }

    stages {
        stage('Prepare Configuration') {
            steps {
                script {
                    dir("${env.WORKSPACE}/infra/docker/alpha/management-web") {
                        // Maps to the templating logic.
                        // We use triple single quotes (''') so that shell variables (like $WEB_VERSION)
                        // are evaluated by bash, not Groovy. Parameters (like $IMAGE_VERSION) 
                        // are automatically injected as environment variables.
                        def webVersion
                        if (params.IMAGE_VERSION == 'alpha') {
                                withEnv(["GHCR_IMAGE_PATH=${params.GHCR_IMAGE_PATH}"]) {
                                    withCredentials([string(credentialsId: params.GHCR_REGISTRY_TOKEN, variable: 'GHCR_REGISTRY_TOKEN')]) {
                                        webVersion = sh(script: "${env.WORKSPACE}/scripts/ghcr/getLatestAlphaTag.sh", returnStdout: true).trim()
                                    }
                                }
                                if (!webVersion) {
                                        error('ERROR: No alpha tag found from getLatestAlphaTag.sh')
                                }
                        } else {
                                webVersion = params.IMAGE_VERSION
                        }

                        echo "Using MANAGEMENT_WEB_VERSION=${webVersion}"

                        sh '''#!/bin/bash
                            set -euo pipefail
                            sed -e "s|REPLACE_WITH_MANAGEMENT_WEB_VERSION|''' + webVersion + '''|g" \
                                -e "s|REPLACE_WITH_MANAGEMENT_WEB_RUNTIME_CONFIG_VERSION|''' + webVersion + '''|g" \
                                docker-compose.yml.template > docker-compose.yml
                        '''
                    }
                }
            }
        }

        stage('Start Alpha Management Web') {
            steps {
                script {
                    sh 'make -f makefiles/alpha/Makefile.alpha.mk alpha_management_web_up'
                }
            }
        }
    }
}
