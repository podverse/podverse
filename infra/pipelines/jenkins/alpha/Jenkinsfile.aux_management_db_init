pipeline {
    agent {
        label 'pv-alpha-aux'
    }

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Initialize Alpha Management Database') {
            steps {
                // Run make in workspace so we use the checked-out repo; /opt/podverse may not exist on aux.
                sh 'make -f makefiles/alpha/Makefile.alpha.mk alpha_management_db_init'
            }
        }
    }
}
