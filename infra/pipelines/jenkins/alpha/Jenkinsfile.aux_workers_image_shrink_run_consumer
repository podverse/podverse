pipeline {
    // Maps to <assignedNode>pv-alpha-aux</assignedNode>
    agent {
        label 'pv-alpha-aux'
    }

    // Maps to <concurrentBuild>false</concurrentBuild>
    options {
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Start Image Shrink Consumer') {
            steps {
                script {
                    // Maps to 'pushd /opt/podverse/infra/docker/alpha/workers'
                    dir('/opt/podverse/infra/docker/alpha/workers') {
                        // Maps to the docker compose run command.
                        // We use 'set -eux' to match the XML.
                        // Note: '-d' runs this in the background, so the Jenkins job will
                        // finish successfully as soon as the container starts.
                        sh '''
                            set -eux
                            docker compose -f docker-compose.yml run -d --name podverse_alpha_workers_image_shrink_consumer podverse_alpha_workers node apps/workers/dist/index.js imageShrinkRunConsumer
                        '''
                    }
                }
            }
        }
    }
}
