pipeline {
    // Maps to <assignedNode>pv-alpha-aux</assignedNode>
    agent {
        label 'pv-alpha-aux'
    }

    // Maps to <concurrentBuild>false</concurrentBuild>
    options {
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Start Alpha MQ') {
            steps {
                script {
                    // Maps to 'pushd /opt/podverse'
                    dir('/opt/podverse') {
                        // Maps to 'make alpha_mq_up'
                        // Preserving 'set -ux' for verbose logging and unset variable checks.
                        sh '''
                            set -ux
                            make -f makefiles/alpha/Makefile.alpha.mk alpha_mq_up
                        '''
                    }
                }
            }
        }
    }
}