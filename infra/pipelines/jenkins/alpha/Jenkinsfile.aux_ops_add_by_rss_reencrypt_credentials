pipeline {
    agent {
        label 'pv-alpha-aux'
    }

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        password(
            name: 'OLD_KEY',
            description: 'Current add-by-RSS credential encryption key (64 hex characters). Will be used to decrypt existing credentials.',
            trim: true
        )
        password(
            name: 'NEW_KEY',
            description: 'New add-by-RSS credential encryption key (64 hex characters). Generate with: openssl rand -hex 32. Credentials will be re-encrypted with this key.',
            trim: true
        )
    }

    stages {
        stage('Re-encrypt add-by-RSS credentials') {
            steps {
                script {
                    dir('/opt/podverse/infra/docker/alpha/workers') {
                        sh """
                            set -eu
                            docker compose -f docker-compose.yml run --rm \\
                                -e ADD_BY_RSS_CREDENTIALS_ENCRYPTION_KEY='${params.NEW_KEY}' \\
                                -e ADD_BY_RSS_CREDENTIALS_ENCRYPTION_KEY_OLD='${params.OLD_KEY}' \\
                                podverse_alpha_workers \\
                                node apps/workers/dist/index.js reencryptAddByRSSCredentials
                        """
                    }
                }
            }
        }
    }
}
