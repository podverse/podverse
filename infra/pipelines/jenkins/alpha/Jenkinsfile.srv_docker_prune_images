pipeline {
    // Maps to <assignedNode>pv-alpha-srv</assignedNode>
    agent {
        label 'pv-alpha-srv'
    }

    // Maps to <concurrentBuild>false</concurrentBuild>
    options {
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Prune Docker Images') {
            steps {
                script {
                    sh 'make -f makefiles/alpha/Makefile.alpha.mk docker_prune_images'
                }
            }
        }
    }
}
