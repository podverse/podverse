pipeline {
    // Maps to <assignedNode>pv-alpha-srv</assignedNode>
    agent {
        label 'pv-alpha-srv'
    }

    // Maps to <concurrentBuild>false</concurrentBuild>
    options {
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Stop Alpha API') {
            steps {
                script {
                    sh 'make -f makefiles/alpha/Makefile.alpha.mk alpha_api_down'
                }
            }
        }
    }
}