pipeline {
    agent {
        label 'pv-alpha-srv'
    }

    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        skipDefaultCheckout(true)
    }

    parameters {
        string(
            name: 'IMAGE_VERSION',
            defaultValue: 'alpha',
            description: 'Docker image version to deploy (default: alpha = latest alpha tag)'
        )
        string(
            name: 'GIT_BRANCH_NAME',
            defaultValue: 'develop',
            description: 'Git branch to checkout and pull for ops repo'
        )
    }

    stages {
        stage('1. Create network (srv + aux)') {
            parallel {
                stage('Network (srv)') {
                    steps {
                        build job: 'pipelines/alpha/srv_network_create', wait: true, propagate: true
                    }
                }
                stage('Network (aux)') {
                    steps {
                        build job: 'pipelines/alpha/aux_network_create', wait: true, propagate: true
                    }
                }
            }
        }

        stage('2. Git Pull (srv)') {
            steps {
                build job: 'pipelines/alpha/srv_ops_git_pull',
                      wait: true,
                      propagate: true,
                      parameters: [
                          string(name: 'GIT_BRANCH_NAME', value: params.GIT_BRANCH_NAME)
                      ]
            }
        }

        stage('3. Git Pull (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_ops_git_pull',
                      wait: true,
                      propagate: true,
                      parameters: [
                          string(name: 'GIT_BRANCH_NAME', value: params.GIT_BRANCH_NAME)
                      ]
            }
        }

        stage('4. Start Postgres (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_db_up', wait: true, propagate: true
            }
        }

        stage('5. Init App DB (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_db_init', wait: true, propagate: true
            }
        }

        stage('6. Init Management DB (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_management_db_init', wait: true, propagate: true
            }
        }

        stage('7. Start KeyValDB (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_keyvaldb_up', wait: true, propagate: true
            }
        }

        stage('8. Start MQ (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_mq_up', wait: true, propagate: true
            }
        }

        stage('9. Pull Workers (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_workers_pull', wait: true, propagate: true
            }
        }

        stage('10. Start Parsers (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_workers_mq_rss_run_parsers_all', wait: true, propagate: true
            }
        }

        stage('11. Start Live Item Listener (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_workers_mq_rss_run_live_item_listener', wait: true, propagate: true
            }
        }

        stage('12. Start DLQ Consumer (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_workers_mq_rss_run_dlq_consumer', wait: true, propagate: true
            }
        }

        stage('13. Start Image Shrink Consumer (aux)') {
            steps {
                build job: 'pipelines/alpha/aux_workers_image_shrink_run_consumer', wait: true, propagate: true
            }
        }

        stage('14. Start API (srv)') {
            steps {
                build job: 'pipelines/alpha/srv_api_up',
                      wait: true,
                      propagate: true,
                      parameters: [
                          string(name: 'IMAGE_VERSION', value: params.IMAGE_VERSION)
                      ]
            }
        }

        stage('15. Start Management API (srv)') {
            steps {
                build job: 'pipelines/alpha/srv_management_api_up',
                      wait: true,
                      propagate: true,
                      parameters: [
                          string(name: 'IMAGE_VERSION', value: params.IMAGE_VERSION)
                      ]
            }
        }

        stage('16. Start Web (srv)') {
            steps {
                build job: 'pipelines/alpha/srv_web_up',
                      wait: true,
                      propagate: true,
                      parameters: [
                          string(name: 'IMAGE_VERSION', value: params.IMAGE_VERSION)
                      ]
            }
        }

        stage('17. Start Management Web (srv)') {
            steps {
                build job: 'pipelines/alpha/srv_management_web_up',
                      wait: true,
                      propagate: true,
                      parameters: [
                          string(name: 'IMAGE_VERSION', value: params.IMAGE_VERSION)
                      ]
            }
        }
    }

    post {
        success {
            echo '✅ Alpha rebuild completed successfully!'
        }
        failure {
            echo '❌ Alpha rebuild failed! Check the failed stage above.'
        }
        always {
            echo "Rebuild finished at: ${new Date()}"
        }
    }
}
