pipeline {
    // Maps to <assignedNode>pv-alpha-aux</assignedNode>
    agent {
        label 'pv-alpha-aux'
    }

    // Maps to <concurrentBuild>false</concurrentBuild>
    options {
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        stage('Run Image Shrink Backfill') {
            steps {
                script {
                    // Maps to 'pushd /opt/podverse/infra/docker/alpha/workers'
                    dir('/opt/podverse/infra/docker/alpha/workers') {
                        // Maps to the docker compose run command.
                        // We use triple double-quotes (""") to interpolate the Jenkins parameters.
                        sh """
                            set -eux
                            docker compose -f docker-compose.yml run --rm podverse_alpha_workers node apps/workers/dist/index.js imageShrinkBackfill
                        """
                    }
                }
            }
        }
    }
}
