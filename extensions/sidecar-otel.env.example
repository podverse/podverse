#####
##### Extension sidecar — OpenTelemetry collector
#####
# Canonical template: infra/config/env-templates/extension-sidecar-otel.env.example
# Sidecar process only — not app Observability (see observability.env.example).

#####
##### OTLP receiver (sidecar input)
#####

OTEL_RECEIVER_OTLP_HTTP_PORT="4318"

#####
##### Sidecar trace forwarding (downstream export)
#####
# Distinct from app OTEL_TRACES_EXPORT.

OTEL_TRACES_EXPORTER_MODE="none"
OTEL_TRACES_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_EXPORTER_OTLP_HEADERS=
