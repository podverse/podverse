# Cursor Ignore Configuration
# This file controls what files the AI can access

# Allow .env template files to be visible to Cursor
# (These contain example/template values, not real secrets)
!.env.example
!*.env.example
!env/*.env

# Note: Actual .env files with secrets should remain hidden
# The patterns below are commented out - uncomment if you want Cursor to see them
!.env
# !.env.local
# !.env.*


# Optional human LLM history workflow (archived policy text; not agent instructions)
docs/development/llm/LLM-HISTORY-WORKFLOW-ARCHIVE.md

# Mobile native build output (generated; never index)
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/android/.gradle/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/.expo/
apps/mobile/node_modules/

# Mobile generated assets / bundles
apps/mobile/**/*.hbc
apps/mobile/ios/*.xcworkspace/xcuserdata/
