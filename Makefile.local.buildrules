# ==========================================
# Lock file sync (required for npm ci in Dockerfiles)
# ==========================================
# Updates package-lock.json to match all workspace package.json files. Run after
# adding/removing/renaming workspace packages, or when Docker build fails with
# "Missing X from lock file". Then commit package-lock.json.
.PHONY: sync_lockfile
sync_lockfile:
	npm install --ignore-scripts

# ==========================================
# Docker Image Building
# ==========================================

# Build base API image (tag -base so wrapper always uses local build), then local wrapper (socat entrypoint so localhost:2111 -> test-assets for transcript/chapters).
.PHONY: local_build_api
local_build_api: sync_lockfile
	docker build -f apps/api/Dockerfile -t podverse-api-base:latest .
	docker build -f infra/docker/local/api/Dockerfile -t podverse-api:latest .

# Build base workers image (tag -base so wrapper always uses local build), then local wrapper (socat entrypoint so localhost:2111 -> test-assets).
.PHONY: local_build_workers
local_build_workers: sync_lockfile
	docker build -f apps/workers/Dockerfile -t podverse-workers-base:latest .
	docker build -f infra/docker/local/workers/Dockerfile -t podverse-workers:latest .

# Build base management-api image (tag -base so wrapper always uses local build), then local wrapper (socat entrypoint so localhost:2111 -> test-assets; parity with API).
.PHONY: local_build_management_api
local_build_management_api: sync_lockfile
	docker build -f apps/management-api/Dockerfile -t podverse-management-api-base:latest .
	docker build -f infra/docker/local/management-api/Dockerfile -t podverse-management-api:latest .

.PHONY: local_build_web_base
local_build_web_base: sync_lockfile
	docker build -f apps/web/Dockerfile.base -t ghcr.io/podverse/podverse/web-base:alpha .

.PHONY: local_build_management_web_base
local_build_management_web_base: sync_lockfile
	docker build -f apps/management-web/Dockerfile.base -t ghcr.io/podverse/podverse/management-web-base:alpha .

# Build base web image (tag -base so wrapper always uses local build), then local wrapper (socat entrypoint so localhost:2111 -> test-assets for SSR proxy/images).
.PHONY: local_build_web
local_build_web: local_build_web_base
	docker build -f apps/web/Dockerfile -t podverse-web-base:latest .
	docker build -f infra/docker/local/web/Dockerfile -t podverse-web:latest .

.PHONY: local_build_web_runtime_config
local_build_web_runtime_config: sync_lockfile
	docker build -f apps/web/sidecar/Dockerfile -t podverse-web-runtime-config:latest .

# Build base management-web image (tag -base so wrapper always uses local build), then local wrapper (socat entrypoint so localhost:2111 -> test-assets for SSR; parity with web).
.PHONY: local_build_management_web
local_build_management_web: local_build_management_web_base
	docker build -f apps/management-web/Dockerfile -t podverse-management-web-base:latest .
	docker build -f infra/docker/local/management-web/Dockerfile -t podverse-management-web:latest .

.PHONY: local_build_management_web_runtime_config
local_build_management_web_runtime_config: sync_lockfile
	docker build -f apps/management-web/sidecar/Dockerfile -t podverse-management-web-runtime-config:latest .

.PHONY: local_build_all
local_build_all: local_build_api local_build_workers local_build_management_api local_build_web local_build_web_runtime_config local_build_management_web local_build_management_web_runtime_config local_build_test_assets
	@echo "All Docker images built successfully"

# ==========================================
# Docker Image Testing
# ==========================================

.PHONY: local_test_docker_builds
local_test_docker_builds:
	@echo "Building all Docker images..."
	@$(MAKE) local_build_all
	@echo ""
	@echo "Image sizes:"
	@docker images podverse-*:latest --format "table {{.Repository}}\t{{.Tag}}\t{{.Size}}"
	@echo ""
	@echo "Verifying image contents..."
	@docker run --rm podverse-api:latest test -d /opt/packages/helpers/src && echo "ERROR: src found in API image" || echo "✓ API: No src files"
	@docker run --rm podverse-api:latest test -d /opt/packages/helpers/dist && echo "✓ API: dist files present" || echo "ERROR: dist missing in API image"
	@echo ""
	@echo "All Docker builds verified!"
