#!/bin/bash

# Podverse Pre-Commit Hook
# Outputs to stderr so messages appear in GUI error dialogs

YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

CODE_CHANGES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx)$' | grep -E '^(packages|apps|tools)/' || true)
INFRA_CHANGES=$(echo "$STAGED_FILES" | grep -E '^(infra|scripts|pipelines)/' || true)
HISTORY_UPDATED=$(echo "$STAGED_FILES" | grep -E '^\.llm/history/' || true)
DOCS_UPDATED=$(echo "$STAGED_FILES" | grep -E '^(docs/|\.llm/context/)' || true)

if [[ -n "$CODE_CHANGES" || -n "$INFRA_CHANGES" ]]; then
    if [[ -z "$HISTORY_UPDATED" && -z "$DOCS_UPDATED" ]]; then
        echo "" >&2
        echo -e "${YELLOW}╔════════════════════════════════════════════════════════════╗${NC}" >&2
        echo -e "${YELLOW}║  📝 DOCUMENTATION REMINDER                                  ║${NC}" >&2
        echo -e "${YELLOW}╠════════════════════════════════════════════════════════════╣${NC}" >&2
        echo -e "${YELLOW}║  You're committing code changes without updating:          ║${NC}" >&2
        echo -e "${YELLOW}║  - .llm/history/active/*.md (LLM session history)          ║${NC}" >&2
        echo -e "${YELLOW}║  - docs/ or .llm/context/ (documentation)                  ║${NC}" >&2
        echo -e "${YELLOW}╚════════════════════════════════════════════════════════════╝${NC}" >&2
        echo "" >&2
        
        if [ -t 0 ]; then
            echo -e "${CYAN}Options:${NC} [Enter] Continue | [d] Checklist | [a] Abort" >&2
            read -p "Choice: " -n 1 -r REPLY
            echo "" >&2
            case $REPLY in
                [dD]) echo "□ .llm/history/active/[feature].md" >&2; echo "□ docs/" >&2; exit 1 ;;
                [aA]) echo "Aborted." >&2; exit 1 ;;
            esac
        else
            # Non-interactive (GUI) - block commit
            echo "❌ Commit blocked: Code/infra changes require LLM history or docs update." >&2
            echo "   Use terminal to commit with interactive options, or stage history/docs files." >&2
            exit 1
        fi
    fi
fi
exit 0
