#!/bin/bash

# Podverse Pre-Commit Hook
# Outputs to stderr so messages appear in GUI error dialogs
#
# ============================================================================
# BYPASS OPTIONS FOR NON-LLM DEVELOPMENT
# ============================================================================
# If you're developing WITHOUT LLM assistance (manual coding, quick fixes,
# external contributors not using Cursor/LLM tools), you can bypass this check:
#
#   SKIP_HISTORY_CHECK=1 git commit -m "your message"
#
# This is the expected workflow for non-LLM work. No history entry is needed.
# ============================================================================

# Check for bypass environment variable
if [[ "$SKIP_HISTORY_CHECK" == "1" ]]; then
    exit 0
fi

YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
NC='\033[0m'

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

CODE_CHANGES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx)$' | grep -E '^(packages|apps|tools)/' || true)
INFRA_CHANGES=$(echo "$STAGED_FILES" | grep -E '^(infra|scripts|pipelines)/' || true)
HISTORY_UPDATED=$(echo "$STAGED_FILES" | grep -E '^\.llm/history/' || true)
DOCS_UPDATED=$(echo "$STAGED_FILES" | grep -E '^(docs/|\.llm/context/)' || true)

if [[ -n "$CODE_CHANGES" || -n "$INFRA_CHANGES" ]]; then
    if [[ -z "$HISTORY_UPDATED" && -z "$DOCS_UPDATED" ]]; then
        echo "" >&2
        echo -e "${YELLOW}╔════════════════════════════════════════════════════════════╗${NC}" >&2
        echo -e "${YELLOW}║  📝 LLM HISTORY CHECK                                       ║${NC}" >&2
        echo -e "${YELLOW}╠════════════════════════════════════════════════════════════╣${NC}" >&2
        echo -e "${YELLOW}║  You're committing code changes without updating:          ║${NC}" >&2
        echo -e "${YELLOW}║  - .llm/history/active/*.md (LLM session history)          ║${NC}" >&2
        echo -e "${YELLOW}║  - docs/ or .llm/context/ (documentation)                  ║${NC}" >&2
        echo -e "${YELLOW}╠════════════════════════════════════════════════════════════╣${NC}" >&2
        echo -e "${YELLOW}║  If NOT using LLM, run:                                    ║${NC}" >&2
        echo -e "${YELLOW}║  ${CYAN}SKIP_HISTORY_CHECK=1 git commit -m \"message\"${YELLOW}              ║${NC}" >&2
        echo -e "${YELLOW}╚════════════════════════════════════════════════════════════╝${NC}" >&2
        echo "" >&2
        
        if [ -t 0 ]; then
            # Interactive terminal - require explicit override
            echo -e "${CYAN}Options:${NC}" >&2
            echo -e "  Type ${GREEN}override${NC} - Continue without history update (LLM work)" >&2
            echo -e "  Type ${GREEN}checklist${NC} - Show what to update" >&2
            echo -e "  Press ${GREEN}Enter${NC} or anything else - Abort" >&2
            echo "" >&2
            read -p "Choice: " -r REPLY
            echo "" >&2
            case $REPLY in
                override)
                    echo -e "${YELLOW}⚠️  Proceeding without history update. Remember to update it later!${NC}" >&2
                    exit 0
                    ;;
                checklist)
                    echo "□ .llm/history/active/[feature].md - Add session entry" >&2
                    echo "□ docs/ - Update if architecture/API changed" >&2
                    echo "□ .llm/context/ - Update if conventions changed" >&2
                    exit 1
                    ;;
                *)
                    echo "Commit aborted." >&2
                    exit 1
                    ;;
            esac
        else
            # Non-interactive (GUI) - always block
            echo -e "${RED}❌ Commit blocked: Code/infra changes detected without LLM history update.${NC}" >&2
            echo "" >&2
            echo "If using LLM: Stage your .llm/history/active/*.md file" >&2
            echo "If NOT using LLM: Run in terminal with:" >&2
            echo "  SKIP_HISTORY_CHECK=1 git commit -m \"message\"" >&2
            exit 1
        fi
    fi
fi
exit 0
