{
  "name": "@podverse/v4v-btc-ln",
  "version": "5.4.10",
  "description": "Bitcoin Lightning (LN) V4V helpers: lnaddress, keysend/blip10, web payments",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-data": {
      "types": "./dist/test-data/ln-recipients-config.d.ts",
      "default": "./dist/test-data/ln-recipients-config.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "npm run lint && tsc",
    "build:prod": "tsc",
    "build:watch": "tsc --build --watch --preserveWatchOutput",
    "lint": "eslint ./src --max-warnings 0",
    "lint:fix": "eslint ./src --fix",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "license": "AGPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@podverse/helpers": "*",
    "@podverse/helpers-requests": "*",
    "@podverse/v4v-helpers": "*"
  },
  "type": "module",
  "sideEffects": false
}
