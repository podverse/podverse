{
  "name": "@podverse/notifications",
  "version": "5.6.0",
  "description": "Push notification helper module for Podverse use cases",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "npm run lint && tsc --build",
    "build:prod": "tsc --build",
    "build:watch": "tsc --build --watch --preserveWatchOutput",
    "lint": "eslint ./src --max-warnings 0",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "license": "AGPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@podverse/external-services-firebase": "*",
    "@podverse/helpers": "*",
    "web-push": "^4.0.0",
    "@podverse/helpers-backend": "*",
    "@podverse/helpers-validation": "*"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
