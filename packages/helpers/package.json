{
  "name": "@podverse/helpers",
  "version": "5.4.8",
  "type": "module",
  "sideEffects": false,
  "description": "Shared utilities and DTOs for Podverse applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "npm run lint && tsc",
    "build:prod": "tsc",
    "build:watch": "tsc --build --watch --preserveWatchOutput",
    "lint": "eslint ./src --max-warnings 0",
    "lint:fix": "eslint ./src --fix",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "license": "AGPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "he": "^1.2.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/node": "^24.12.0"
  }
}
