{
  "name": "@podverse/helpers",
  "version": "5.2.0",
  "description": "Shared utilities and DTOs for Podverse applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "npm run lint && tsc",
    "build:prod": "tsc",
    "build:watch": "tsc --build --watch --preserveWatchOutput",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "license": "AGPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "bignumber.js": "^9.3.1",
    "date-fns": "^4.1.0",
    "he": "^1.2.0",
    "joi": "^18.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.17.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/node": "^24.4.0"
  }
}
