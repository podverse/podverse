{
  "name": "@podverse/helpers",
  "version": "5.5.3",
  "type": "module",
  "sideEffects": false,
  "description": "Shared utilities and DTOs for Podverse applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./locales": {
      "types": "./dist/lib/constants/locales.d.ts",
      "default": "./dist/lib/constants/locales.js"
    },
    "./configValidation": {
      "types": "./dist/lib/configValidation.d.ts",
      "default": "./dist/lib/configValidation.js"
    },
    "./timeFormatter": {
      "types": "./dist/lib/i18n/timeFormatter.d.ts",
      "default": "./dist/lib/i18n/timeFormatter.js"
    },
    "./error": {
      "types": "./dist/lib/error/index.d.ts",
      "default": "./dist/lib/error/index.js"
    },
    "./guards": {
      "types": "./dist/lib/guards.d.ts",
      "default": "./dist/lib/guards.js"
    },
    "./html": {
      "types": "./dist/lib/html.d.ts",
      "default": "./dist/lib/html.js"
    },
    "./math": {
      "types": "./dist/lib/math.d.ts",
      "default": "./dist/lib/math.js"
    },
    "./pagination": {
      "types": "./dist/lib/pagination.d.ts",
      "default": "./dist/lib/pagination.js"
    },
    "./opml": {
      "types": "./dist/lib/opml/opmlImportErrors.d.ts",
      "default": "./dist/lib/opml/opmlImportErrors.js"
    },
    "./time": {
      "types": "./dist/lib/time.d.ts",
      "default": "./dist/lib/time.js"
    },
    "./dto": {
      "types": "./dist/dtos/index.d.ts",
      "default": "./dist/dtos/index.js"
    },
    "./medium": {
      "types": "./dist/lib/medium.d.ts",
      "default": "./dist/lib/medium.js"
    },
    "./queue": {
      "types": "./dist/lib/queue/queue.d.ts",
      "default": "./dist/lib/queue/queue.js"
    },
    "./queue/abridged": {
      "types": "./dist/lib/queue/queueResourceAbridged.d.ts",
      "default": "./dist/lib/queue/queueResourceAbridged.js"
    },
    "./addByRSS/ids": {
      "types": "./dist/lib/addByRSS/ids.d.ts",
      "default": "./dist/lib/addByRSS/ids.js"
    },
    "./item/itemEnclosure": {
      "types": "./dist/lib/item/itemEnclosure.d.ts",
      "default": "./dist/lib/item/itemEnclosure.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "npm run lint && tsc",
    "build:prod": "tsc",
    "build:watch": "tsc --build --watch --preserveWatchOutput",
    "lint": "eslint ./src --max-warnings 0",
    "lint:fix": "eslint ./src --fix",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "AGPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "he": "^1.2.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/node": "^24.12.0",
    "vitest": "^4.1.10"
  }
}
