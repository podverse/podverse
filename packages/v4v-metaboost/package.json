{
  "name": "@podverse/v4v-metaboost",
  "version": "5.4.33",
  "description": "V4V MetaBoost feed types and mbrss-v1 helper utilities",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "npm run lint && tsc",
    "build:prod": "tsc",
    "build:watch": "tsc --build --watch --preserveWatchOutput",
    "lint": "eslint ./src --max-warnings 0",
    "lint:fix": "eslint ./src --fix",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "AGPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@podverse/helpers": "*",
    "@podverse/helpers-validation": "*"
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  },
  "type": "module",
  "sideEffects": false
}
