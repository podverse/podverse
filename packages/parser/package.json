{
  "name": "@podverse/parser",
  "version": "5.2.0",
  "description": "RSS/Atom feed parser for Podverse",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "npm run lint && tsc && tsc-alias",
    "build:prod": "tsc && tsc-alias",
    "build:watch": "tsc --build --watch --preserveWatchOutput",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "license": "AGPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@podverse/external-services": "*",
    "@podverse/helpers": "*",
    "@podverse/orm": "*",
    "podverse-partytime": "^5.0.0"
  },
  "devDependencies": {
    "tsc-alias": "^1.8.16"
  }
}
