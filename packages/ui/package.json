{
  "name": "@podverse/ui",
  "version": "5.5.2",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Shared UI components for Podverse applications",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/variables": "./src/styles/_variables.scss",
    "./styles/variables-root": "./src/styles/_variables-root.scss",
    "./styles/breakpoints": "./src/styles/_breakpoints.scss",
    "./styles/mixins": "./src/styles/_mixins.scss",
    "./styles/themes": "./src/styles/_themes.scss",
    "./styles/font-faces": "./src/styles/_font-faces.scss",
    "./styles": "./src/styles/index.scss",
    "./toast": {
      "types": "./src/components/feedback/Toast/index.ts",
      "import": "./src/components/feedback/Toast/index.ts",
      "default": "./src/components/feedback/Toast/index.ts"
    },
    "./custom-themes/server": {
      "types": "./src/lib/customThemes/enrichRuntimeConfigWithCustomThemes.ts",
      "import": "./src/lib/customThemes/enrichRuntimeConfigWithCustomThemes.ts",
      "default": "./src/lib/customThemes/enrichRuntimeConfigWithCustomThemes.ts"
    }
  },
  "scripts": {
    "lint": "eslint ./src --max-warnings 0",
    "lint:fix": "eslint ./src --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "AGPL-3.0",
  "peerDependencies": {
    "next": "^16.2.7",
    "react": "^19.2.7",
    "react-virtuoso": "^4.18.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.2",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^26.1.0",
    "next": "^16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-virtuoso": "^4.18.3",
    "sass": "^1.98.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@podverse/helpers": "*",
    "@podverse/helpers-config": "*",
    "classnames": "^2.5.1",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.1",
    "sanitize-html": "^2.17.4"
  }
}
