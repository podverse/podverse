{
  "name": "@podverse/ui",
  "version": "5.4.26",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Shared UI components for Podverse applications",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/variables": "./src/styles/_variables.scss",
    "./styles/variables-root": "./src/styles/_variables-root.scss",
    "./styles/breakpoints": "./src/styles/_breakpoints.scss",
    "./styles/mixins": "./src/styles/_mixins.scss",
    "./styles/themes": "./src/styles/_themes.scss",
    "./styles/font-faces": "./src/styles/_font-faces.scss",
    "./styles": "./src/styles/index.scss"
  },
  "scripts": {
    "lint": "eslint ./src --max-warnings 0",
    "lint:fix": "eslint ./src --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "AGPL-3.0",
  "peerDependencies": {
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.11",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^26.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sass": "^1.98.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.1"
  }
}
