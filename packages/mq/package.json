{
  "name": "@podverse/mq",
  "version": "5.5.2",
  "description": "Message queue module for Podverse",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "npm run lint && tsc && tsc-alias",
    "build:prod": "tsc && tsc-alias",
    "build:watch": "tsc --build --watch --preserveWatchOutput & tsc-alias --watch",
    "lint": "eslint ./src --max-warnings 0",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "license": "AGPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@podverse/external-services-podcast-index": "*",
    "@podverse/helpers": "*",
    "@podverse/helpers-backend": "*",
    "@podverse/helpers-requests": "*",
    "@podverse/helpers-validation": "*",
    "@podverse/observability": "*",
    "@podverse/orm": "*",
    "@podverse/parser": "*",
    "module-alias": "^2.3.3",
    "rhea": "^3.0.4",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/module-alias": "^2.0.4",
    "@types/ws": "^8.18.1",
    "tsc-alias": "^1.8.16",
    "vitest": "^4.1.9"
  },
  "type": "module"
}
