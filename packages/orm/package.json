{
  "name": "@podverse/orm",
  "version": "5.3.1",
  "description": "TypeORM entities and database utilities for Podverse",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "npm run lint && tsc && tsc-alias",
    "build:prod": "tsc && tsc-alias",
    "build:watch": "tsc --build --watch --preserveWatchOutput & tsc-alias --watch",
    "lint": "eslint ./src --max-warnings 0",
    "lint:fix": "eslint ./src --fix",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "license": "AGPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@podverse/helpers": "*",
    "async-mutex": "^0.5.0",
    "bcrypt": "^6.0.0",
    "nanoid": "^5.1.6",
    "pg": "^8.16.3",
    "typeorm": "^0.3.26",
    "typeorm-naming-strategies": "^4.1.0",
    "@podverse/helpers-backend": "*",
    "@podverse/helpers-validation": "*",
    "module-alias": "^2.3.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "tsc-alias": "^1.8.16",
    "@types/module-alias": "^2.0.4"
  },
  "type": "module"
}
