{
  "name": "@podverse/external-services-apple-app-store",
  "version": "5.6.0",
  "description": "Apple App Store Server integration for Podverse",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "npm run lint && tsc --build",
    "build:prod": "tsc --build",
    "build:watch": "tsc --build --watch --preserveWatchOutput",
    "lint": "eslint ./src --max-warnings 0",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "license": "AGPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@podverse/helpers": "*"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  },
  "type": "module"
}
