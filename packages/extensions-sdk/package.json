{
  "name": "@podverse/extensions-sdk",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "description": "Typed contract for Podverse extensions and hosts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "npm run lint && tsc",
    "build:prod": "tsc",
    "build:watch": "tsc --build --watch --preserveWatchOutput",
    "lint": "eslint ./src --max-warnings 0",
    "lint:fix": "eslint ./src --fix",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "AGPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "joi": "^18.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "vitest": "^3.2.4"
  }
}
