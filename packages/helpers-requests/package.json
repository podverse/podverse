{
  "name": "@podverse/helpers-requests",
  "version": "5.5.1",
  "sideEffects": false,
  "description": "API client utilities for Podverse web application",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./outbound-requests": {
      "types": "./dist/_requestOutbound.d.ts",
      "import": "./dist/_requestOutbound.js",
      "default": "./dist/_requestOutbound.js"
    },
    "./outbound-http-policy": {
      "types": "./dist/outboundHttpPolicy.d.ts",
      "import": "./dist/outboundHttpPolicy.js",
      "default": "./dist/outboundHttpPolicy.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "npm run lint && tsc",
    "build:prod": "tsc",
    "build:watch": "tsc --build --watch --preserveWatchOutput",
    "lint": "eslint ./src --max-warnings 0",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "license": "AGPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@podverse/helpers": "*",
    "@podverse/http-request-core": "*",
    "@podverse/observability": "*",
    "axios": "^1.16.1",
    "ipaddr.js": "^2.3.0"
  },
  "type": "module",
  "devDependencies": {
    "vitest": "^4.1.9"
  }
}
