@@ edit refs
@@ file apps/mobile/src/screens/home/HomeMediaTypeList.tsx
@@ find
  loadFeedRef.current = loadFeed;
@@ replace
  loadFeedRef.current = loadFeed;

  // A hidden list never reads. Anything that would reload it marks it stale instead, and it reloads
  // quietly when shown again.
  const isActiveRef = useRef(isActive);
  isActiveRef.current = isActive;
  const isStaleRef = useRef(false);
@@ end

