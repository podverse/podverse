@@ edit can mark all seen + reveal
@@ file apps/mobile/src/screens/home/HomeMediaTypeList.tsx
@@ find
  useEffect(() => {
    onCanMarkAllSeenChange(canMarkAllSeen);
  }, [canMarkAllSeen, onCanMarkAllSeenChange]);
@@ replace
  useEffect(() => {
    if (isActive) {
      onCanMarkAllSeenChange(canMarkAllSeen);
    }
  }, [canMarkAllSeen, isActive, onCanMarkAllSeenChange]);

  // Leaving a list before its first read lands abandons that read, the same way a newer read does;
  // the list reads again when it is shown.
  useEffect(() => {
    if (isActive || hasCompletedFeedRead) {
      return;
    }
    feedRequestIdRef.current += 1;
    isStaleRef.current = true;
  }, [hasCompletedFeedRead, isActive]);

  // Showing a kept list picks up a filter typed on another chip's list, and reloads it quietly if
  // anything changed while it was hidden.
  useEffect(() => {
    if (!isActive) {
      return;
    }
    setFilterTerm(readHomeFilterTerm());
    if (isStaleRef.current) {
      isStaleRef.current = false;
      void loadFeed(hasCompletedFeedRead ? 'synced' : 'initial');
    }
  }, [isActive]);
@@ end

