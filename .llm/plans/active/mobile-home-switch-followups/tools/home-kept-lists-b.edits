  const storeListPrefs = useCallback((next: HomeListPrefsState) => {
    setPrefsByType((current) => {
      const existing = current[next.mediaType];
      return existing !== undefined && isSameListPrefs(existing, next)
        ? current
        : { ...current, [next.mediaType]: next };
    });
  }, []);

