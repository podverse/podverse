    navigation.setOptions({
@@ replace
  // Lists past the limit are dropped only once taps pause, so no switch pays for an unmount.
  useEffect(() => {
    if (keptMediaTypes.length <= HOME_KEPT_LIST_POLICY.limit) {
      return;
    }
    const handle = setTimeout(() => {
      setKeptMediaTypes((kept) => trimKeptLists(kept, HOME_KEPT_LIST_POLICY.limit));
    }, HOME_KEPT_LIST_POLICY.evictDelayMs);
    return () => clearTimeout(handle);
  }, [keptMediaTypes]);

  useEffect(() => {
    const subscription = AppState.addEventListener('memoryWarning', () => {
      setKeptMediaTypes((kept) => trimKeptLists(kept, 1));
    });
    return () => subscription.remove();
  }, []);

  // Hidden lists hold rows read for one account in one mode; a change to either drops them rather
  // than risk showing them.
  const listIdentity = `${status}|${account?.id_text ?? ''}|${offlineModeEnabled ? 'offline' : 'online'}`;
  const listIdentityRef = useRef(listIdentity);
  useEffect(() => {
    if (listIdentityRef.current === listIdentity) {
      return;
    }
    listIdentityRef.current = listIdentity;
    setKeptMediaTypes((kept) => trimKeptLists(kept, 1));
  }, [listIdentity]);

  useLayoutEffect(() => {
    navigation.setOptions({
@@ end

