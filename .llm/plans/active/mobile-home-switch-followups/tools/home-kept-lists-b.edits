export function HomeScreen() {
@@ replace
type HomePrefsByType = Partial<Record<HomeMediaType, HomeListPrefsState>>;

const HOME_KEPT_LIST_POLICY = keptListPolicy(isMobileE2eFromEnv());

const isSameListPrefs = (a: HomeListPrefsState, b: HomeListPrefsState): boolean =>
  a.range === b.range && a.sort === b.sort && a.viewMode === b.viewMode;

/** Applies a choice to one media type's remembered prefs; a type not read yet stays unread. */
const patchListPrefs = (
  current: HomePrefsByType,
  mediaType: HomeMediaType,
  patch: Partial<Omit<HomeListPrefsState, 'mediaType'>>
): HomePrefsByType => {
  const existing = current[mediaType];
  return existing === undefined ? current : { ...current, [mediaType]: { ...existing, ...patch } };
};

export function HomeScreen() {
@@ end

@@ lines state
@@ file apps/mobile/src/screens/home/HomeScreen.tsx
@@ from   const [selectedMediaType, setSelectedMediaType] =
@@ through   const listRef = useRef<HomeMediaTypeListHandle>(null);
@@ replace
  const { account, status } = useAuth();
  const { enabled: offlineModeEnabled } = useOfflineMode();
  const [selectedMediaType, setSelectedMediaType] =
    useState<HomeMediaType>(DEFAULT_HOME_MEDIA_TYPE);
  const [isMediaTypeHydrated, setIsMediaTypeHydrated] = useState<boolean>(false);
  // Lists stay mounted after their chip is left, most recently shown first; the first is on screen.
  const [keptMediaTypes, setKeptMediaTypes] = useState<HomeMediaType[]>(() => [
    DEFAULT_HOME_MEDIA_TYPE,
  ]);
  const [prefsByType, setPrefsByType] = useState<HomePrefsByType>({});
  const { addToPlaylistSheet, requestAddToPlaylist } = useAddToPlaylist();
  const [canMarkAllSeen, setCanMarkAllSeen] = useState<boolean>(false);
  const activeListRef = useRef<HomeMediaTypeListHandle>(null);
@@ end

@@ lines prefs resolution
@@ file apps/mobile/src/screens/home/HomeScreen.tsx
@@ from   // Defaults until AsyncStorage catches up, so the list can paint from SQLite on the first frame.
@@ through   const arePrefsHydrated = listPrefs !== null && listPrefs.mediaType === selectedMediaType;
@@ replace
  // Defaults until AsyncStorage catches up, so a list can paint from SQLite on the first frame.
  // Remembered sort applies when it arrives and the list rereads locally — never behind a spinner.
  // Until then the layout follows the list the user came from, so rows do not change shape.
  const previousMediaType = keptMediaTypes[1];
  const carriedViewMode =
    previousMediaType === undefined ? undefined : prefsByType[previousMediaType]?.viewMode;
  const resolvePrefs = (mediaType: HomeMediaType): HomeListPrefsState =>
    prefsByType[mediaType] ?? {
      mediaType,
      range: DEFAULT_HOME_RANGE,
      sort: DEFAULT_HOME_SORT,
      viewMode: carriedViewMode ?? DEFAULT_HOME_VIEW_MODE,
    };
  const resolvedPrefs = resolvePrefs(selectedMediaType);
@@ end

