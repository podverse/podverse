#####
##### podverse-api (Lighthouse)
##### .env.api.example
#####
# Copy this file to .env.api and fill in the values.
# See ENV.md for detailed documentation of each variable.
#
# NOTE:
# Use lowercase true to enable properties.
# Leave value blank or comment out to disable properties.

#####
##### General
#####

NODE_ENV="development"
LOG_LEVEL="info"
# No default. Leave empty for console-only (e.g. local/dev or container without file logging).
# When using Docker with a log volume, set to the container path (e.g. /opt/logs).
LOG_DIR=

# Must be one of: prod, beta, alpha, local
SERVER_ENV="local"

#####
##### API Configuration
#####

API_PORT="1111"
API_PREFIX="/api"
API_VERSION="/v2"

# Comma-separated list of allowed CORS origins
API_ALLOWED_CORS_ORIGINS="http://localhost:3111"

#####
##### Auth & Security
#####

# Must be a valid UUID - generate with: uuidgen
AUTH_JWT_SECRET="00000000-0000-0000-0000-000000000000"

# JWT/cookie session length. When blank, default 365d.
AUTH_JWT_EXPIRES_IN="365d"

# When true, login JSON may include `token` if the client sends includeTokenInResponseBody. When blank/false, omit.
AUTH_ALLOW_TOKEN_IN_RESPONSE_BODY=

# When blank, API builds from BRAND_NAME (format: BrandName Bot Local/API/5)
USER_AGENT="Example Bot/API/5"

# Use the public facing domain, not the internal docker network ip address.
COOKIE_DOMAIN="localhost"

#####
##### Web Configuration
#####

WEB_PROTOCOL="http"
WEB_DOMAIN="localhost:3111"

#####
##### Database (Postgres)
#####

DB_HOST="localhost"
DB_PORT="5111"
DB_APP_NAME="postgres"
DB_APP_READ_USER="podverse_app_read"
DB_APP_READ_PASSWORD="your_read_password"
DB_APP_READ_WRITE_USER="podverse_app_read_write"
DB_APP_READ_WRITE_PASSWORD="your_read_write_password"
# Set to true for SSL connection
DB_SSL_CONNECTION="false"

#####
##### Key-value (Valkey / Redis)
#####

KEYVALDB_HOST="127.0.0.1"
KEYVALDB_PORT="6381"
KEYVALDB_PASSWORD="mysecretpw"
KEYVALDB_CACHE_TTL_SECONDS="86400"

#####
##### Message Queue (RabbitMQ)
#####

MESSAGE_QUEUE_PROTOCOL="amqp"
MESSAGE_QUEUE_HOST="localhost"
MESSAGE_QUEUE_USERNAME="user"
MESSAGE_QUEUE_PASSWORD="mysecretpw"
MESSAGE_QUEUE_PORT="5673"

#####
##### Podcast Index
#####

PODCAST_INDEX_BASE_URL="https://api.podcastindex.org/api/1.0"
PODCAST_INDEX_AUTH_KEY="test"
PODCAST_INDEX_SECRET_KEY="test"

#####
##### Account / Membership
#####

# Must be one of: "admin_only_username", "admin_only_email", "user_signup_email"
# "admin_only_username" - accounts created by management admin only, username-only (no email required)
# "admin_only_email" - accounts created by management admin only, requires email
# "user_signup_email" - enables public user registration with email (requires mailer config)
ACCOUNT_SIGNUP_MODE="admin_only_email"

# Optional premium membership costs (set to 0 for free signups)
PREMIUM_MEMBERSHIP_COST_MONTHLY="3" # USD
PREMIUM_MEMBERSHIP_COST_ANNUALLY="30" # USD
FREE_TRIAL_EXPIRATION="31" # days

#####
##### Mailer (Required when ACCOUNT_SIGNUP_MODE uses email flows)
#####

MAILER_SERVICE=
MAILER_HOST="smtp.example.com"
MAILER_PORT="587"
MAILER_USERNAME="your_smtp_username"
MAILER_PASSWORD="your_smtp_password"
MAILER_FROM="noreply@example.com"

#####
##### Email Template (Required when ACCOUNT_SIGNUP_MODE uses email flows)
#####

EMAIL_BRAND_COLOR="#2968B1"
EMAIL_HEADER_IMAGE_URL="https://example.com/images/logo.png"
LEGAL_NAME="Your Company Name"
LEGAL_ADDRESS="Your City, State, Country"

#####
##### Token Expiration (Required when ACCOUNT_SIGNUP_MODE uses email flows)
#####

# Values in seconds
VERIFY_EMAIL_TOKEN_EXPIRATION="31540000"
EMAIL_CHANGE_VERIFICATION_TOKEN_EXPIRATION="31540000"
RESET_PASSWORD_TOKEN_EXPIRATION="86400"

#####
##### Social Media (Optional, used in email templates)
#####

SOCIAL_FACEBOOK_PAGE_URL=
SOCIAL_FACEBOOK_IMAGE_URL=
SOCIAL_GITHUB_PAGE_URL=
SOCIAL_GITHUB_IMAGE_URL=
SOCIAL_TWITTER_PAGE_URL=
SOCIAL_TWITTER_IMAGE_URL=

#####
##### PayPal (Optional, for payment processing)
#####

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
