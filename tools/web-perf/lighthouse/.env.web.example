#####
##### podverse-web (Lighthouse)
##### .env.web.example
#####
# Copy this file to .env.web and fill in the values.
# Or copy from env/local.env for local development.
# See ENV.md for detailed documentation of each variable.

#####
##### Runtime Config Sidecar
#####
RUNTIME_CONFIG_PORT="3001"
RUNTIME_CONFIG_URL="http://localhost:3001"

#####
##### API Configuration (SSR)
#####
NEXT_PUBLIC_SSR_API_PROTOCOL="http"
# Use host.docker.internal to access host machine from Docker container
NEXT_PUBLIC_SSR_API_HOST="localhost"
NEXT_PUBLIC_SSR_API_PORT="3000"

#####
##### API Configuration (Client)
#####
NEXT_PUBLIC_API_PROTOCOL="http"
NEXT_PUBLIC_API_HOST="localhost"
NEXT_PUBLIC_API_PORT="3000"
NEXT_PUBLIC_API_PREFIX="/api"
NEXT_PUBLIC_API_VERSION="/v2"

#####
##### Web Configuration
#####
NEXT_PUBLIC_WEB_PROTOCOL="http"
NEXT_PUBLIC_WEB_DOMAIN="localhost:3111"
NEXT_PUBLIC_BRAND_NAME="Podverse"
NEXT_PUBLIC_POLLING_INTERVAL_MS="3000"

#####
##### Lightning Keysend (Optional)
#####
NEXT_PUBLIC_APP_VALUE_LIGHTNING_NODE_NAME=
NEXT_PUBLIC_APP_VALUE_LIGHTNING_NODE_ADDRESS=
NEXT_PUBLIC_APP_VALUE_LIGHTNING_NODE_CUSTOM_KEY=
NEXT_PUBLIC_APP_VALUE_LIGHTNING_NODE_CUSTOM_VALUE=

#####
##### Lightning LNAddress (Optional)
#####
NEXT_PUBLIC_APP_VALUE_LIGHTNING_LNADDRESS_NAME=
NEXT_PUBLIC_APP_VALUE_LIGHTNING_LNADDRESS_ADDRESS=

#####
##### App MetaBoost (Optional)
#####
NEXT_PUBLIC_APP_VALUE_METABOOST_STANDARD=
NEXT_PUBLIC_APP_VALUE_METABOOST_NODE=

#####
##### Website Features
#####
# Comma-delimited list of valid locales or "all-available"
NEXT_PUBLIC_FEATURES_SUPPORTED_LOCALES="all-available"
NEXT_PUBLIC_FEATURES_DEFAULT_LOCALE="en-US"

#####
##### Theme Configuration
#####
# Comma-delimited list of valid themes or "all-available"
# Valid themes: dark, light, dracula
NEXT_PUBLIC_SUPPORTED_THEMES="all-available"
NEXT_PUBLIC_DEFAULT_THEME="dark"

#####
##### Web Push (Optional)
#####
# Native browser push notifications using W3C Push API
# Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_WEBPUSH_VAPID_PUBLIC_KEY=

#####
##### Account / Membership
#####
# Must be one of: "admin_only_username", "admin_only_email", "user_signup_email"
# "admin_only_username" - accounts created by management admin only, username-only (no email required)
# "admin_only_email" - accounts created by management admin only, requires email
# "user_signup_email" - enables public user registration with email (requires mailer config)
NEXT_PUBLIC_ACCOUNT_SIGNUP_MODE="admin_only_email"

#####
##### Contact & Social Media Links (Optional)
#####
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SOCIAL_ACTIVITY_PUB=
NEXT_PUBLIC_SOCIAL_DISCORD=
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_MATRIX=
NEXT_PUBLIC_SOCIAL_X=

#####
##### Server Environment
#####
# Must be one of: prod, beta, alpha, local
NEXT_PUBLIC_SERVER_ENV="local"

#####
##### Proxy Configuration
#####
# User-Agent string sent when proxying external image requests
# Format: BrandName Bot Environment/AppName/Version
NEXT_PUBLIC_PROXY_USER_AGENT="Example Bot local/Web-API/5"
