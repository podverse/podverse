# Lighthouse-only Environment Variables
# Copy this file to .env.lighthouse and update with your values

# Number of Lighthouse runs per scenario - median is used
LIGHTHOUSE_MEDIAN_RUNS="5"

# Browser context mode: "fresh" (new context per run) or "single" (reuse context)
LIGHTHOUSE_CONTEXT_MODE="fresh"

# Web runtime (used by Lighthouse runner only, not app validation)
WEB_PORT="3111"
NODE_ENV="production"

# Allow localhost proxy for test assets
ALLOW_LOCALHOST_PROXY="true"

# Skip Next.js env validation in Lighthouse runs
SKIP_ENV_VALIDATION="true"
