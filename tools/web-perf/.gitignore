# Dependencies
bundle-analyzer/node_modules/
lighthouse/node_modules/

# Build outputs
bundle-analyzer/dist/
lighthouse/dist/

# Generated assets (lighthouse)
lighthouse/assets/*.jpg
lighthouse/assets/*.jpeg
lighthouse/assets/*.mp3
lighthouse/assets/*.mp4

# Keep RSS feeds and asset documentation
!lighthouse/assets/*.rss
!lighthouse/assets/README.md

# Environment files
bundle-analyzer/.env
lighthouse/.env

# TypeScript build info
bundle-analyzer/tsconfig.tsbuildinfo
lighthouse/tsconfig.tsbuildinfo

# Logs
*.log
