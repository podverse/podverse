{
  "name": "@podverse/management-api",
  "version": "5.4.29",
  "type": "module",
  "description": "Management API for Podverse administration",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run lint && tsc && tsc-alias",
    "build:dev": "tsc && tsc-alias",
    "build:prod": "tsc -p tsconfig.prod.json && tsc-alias -p tsconfig.prod.json",
    "dev": "tsc && tsc-alias && node ./dist/index.js",
    "dev:watch": "tsc --build --watch --preserveWatchOutput & tsc-alias --watch & nodemon --delay 1000ms --watch dist --watch ../../packages/helpers/dist --watch ../../packages/orm/dist --watch ../../packages/notifications/dist --watch ../../packages/parser/dist --watch ../../packages/mq/dist dist/index.js",
    "lint": "eslint ./src --max-warnings 0",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest run",
    "start": "node ./dist/index.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "@podverse/external-services-object-storage": "*",
    "@podverse/helpers": "*",
    "@podverse/helpers-backend": "*",
    "@podverse/helpers-config": "*",
    "@podverse/orm": "*",
    "@podverse/worker-commands": "*",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.21.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.26",
    "typeorm-naming-strategies": "^4.1.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.54.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.12.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.4",
    "tsc-alias": "^1.8.16",
    "vitest": "^3.2.4"
  }
}
