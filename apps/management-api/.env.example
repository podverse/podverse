#####
##### podverse-management-api
##### .env.example
#####
# Copy this file to .env and fill in the values.
# See ENV.md for detailed documentation of each variable.

#####
##### General
#####

NODE_ENV="development"
LOG_LEVEL="info"
# Optional: Leave empty for localhost (no file logging), set for file logging with rotation
# For alpha/production, set to path where logs should be saved (e.g., "/app/logs")
LOG_DIR=

#####
##### API Configuration
#####

API_PORT="1999"
API_PREFIX="/api"
API_VERSION="/v1"

# Use the public facing domain, not the internal docker network ip address.
COOKIE_DOMAIN="localhost"

# Comma-separated list of allowed CORS origins
API_ALLOWED_CORS_ORIGINS="http://localhost:3999"

#####
##### Auth & Security
#####

# Must be a valid UUID - generate with: uuidgen
AUTH_JWT_SECRET="00000000-0000-0000-0000-000000000000"

# Format: BrandName Bot Environment/AppName/Version
USER_AGENT="Podverse Bot Local/Management-API/5"

#####
##### Web Configuration
#####

WEB_PROTOCOL="http"
WEB_DOMAIN="localhost:3999"

#####
##### Database (Postgres - Management Database)
#####

DB_HOST="localhost"
DB_PORT="5999"
DB_READ_USERNAME="read"
DB_READ_PASSWORD="your_read_password"
DB_READ_WRITE_USERNAME="read_write"
DB_READ_WRITE_PASSWORD="your_read_write_password"
DB_DATABASE="postgres"
# Set to true for SSL connection
DB_SSL_CONNECTION="false"
