#####
##### podverse-management-api
#####
# Copy this file to .env and fill in the values.
# See ENV.md for detailed documentation of each variable.

#####
##### General
#####

NODE_ENV="development"
LOG_LEVEL="info"
# No default. Leave empty for console-only (e.g. local/dev or container without file logging).
# When using Docker with a log volume, set to the container path (e.g. /opt/logs).
LOG_DIR=

#####
##### API Configuration
#####

API_PORT="3100"
API_PREFIX="/api"
API_VERSION="/v2"
API_RELEASE="X.Y.Z-staging.N"

# Use the public facing domain, not the internal docker network ip address.
COOKIE_DOMAIN="localhost"

# Comma-separated list of allowed CORS origins
API_ALLOWED_CORS_ORIGINS="http://localhost:3102"

#####
##### Auth & Security
#####

# Must be a valid UUID - generate with: uuidgen
AUTH_JWT_SECRET="00000000-0000-0000-0000-000000000000"

# Session idle limit in seconds for every management client (web cookie, mobile refresh token). Each use renews it. When blank, default 31536000 (365d).
AUTH_SESSION_IDLE_EXPIRATION="31536000"

# Access token lifetime in seconds for token clients such as the mobile app (not the web cookie). Clients refresh it silently, so it does not change how long anyone stays signed in. When blank, default 900 (15 minutes).
AUTH_ACCESS_TOKEN_EXPIRATION="900"

# When true, login JSON may include `token` if the client sends includeTokenInResponseBody. When blank/false, omit.
AUTH_ALLOW_TOKEN_IN_RESPONSE_BODY="false"

# When blank, built at runtime from BRAND_NAME (format: BrandName Bot Local/Management-API/5)
USER_AGENT="Example Bot/Management-API/5"
# Set from dev/env-overrides/local/brand.env by local_env_setup
BRAND_NAME=

# Days an admin_session row is kept after its idle expiry.
# A revoked row keeps its idle expiry.
ADMIN_SESSION_RETENTION_DAYS="30"

#####
##### Web configuration (two origins)
#####

# Main app web (apps/web): invite / password-reset links for regular users — POST /account/set-password via main API.
APP_WEB_PROTOCOL="http"
APP_WEB_DOMAIN="localhost:3002"

# Management web app: admin invite links — redeem route exists only on apps/management-web.
MANAGEMENT_WEB_PROTOCOL="http"
MANAGEMENT_WEB_DOMAIN="localhost:3102"

#####
##### User Management
#####

# Set-password invite link lifetime in seconds (e.g. 604800 = 7 days; code default 604800).
MANAGEMENT_API_SET_PASSWORD_EXPIRATION="604800"

#####
##### Database (one Postgres: shared host/port; separate DB_APP_* and DB_MANAGEMENT_* credentials)
#####
# `podverse_app` and `podverse_management` are two databases in the same instance.
# Set DB_HOST/DB_PORT once, then DB_APP_* for the main app and DB_MANAGEMENT_* for admin data.

DB_HOST="localhost"
DB_PORT="5432"
# Set to true for SSL (shared for both logical databases on this host)
DB_SSL_CONNECTION="false"

# Main app database
DB_APP_NAME="podverse_app"
DB_APP_READ_USER="podverse_app_read"
DB_APP_READ_PASSWORD=
DB_APP_READ_WRITE_USER="podverse_app_read_write"
DB_APP_READ_WRITE_PASSWORD=

# Management (admin) database
DB_MANAGEMENT_NAME="podverse_management"
DB_MANAGEMENT_READ_USER="podverse_management_read"
DB_MANAGEMENT_READ_PASSWORD=
DB_MANAGEMENT_READ_WRITE_USER="podverse_management_read_write"
DB_MANAGEMENT_READ_WRITE_PASSWORD=

# KeyValDB (Valkey): the management API publishes account events (new notifications) here.
KEYVALDB_HOST="localhost"
KEYVALDB_PORT="6379"
KEYVALDB_PASSWORD=

# Optional: align with main API — trial length (seconds) and display pricing
# MEMBERSHIP_FREE_TRIAL_EXPIRATION: blank = 31 days in code; example 31 days in seconds.
# Same bootstrap semantics as api: product_membership_settings row wins when present.
MEMBERSHIP_FREE_TRIAL_EXPIRATION="2678400"
MEMBERSHIP_MAX_ADD_BY_RSS_FEEDS="100"
MEMBERSHIP_TRIAL_ALLOW_DIRECTORY_ADD_BY_RSS="false"
MEMBERSHIP_TRIAL_TRACK_STATS="false"
MEMBERSHIP_TRIAL_ALLOW_NOTIFICATIONS="true"
MEMBERSHIP_PREMIUM_ALLOW_DIRECTORY_ADD_BY_RSS="true"
MEMBERSHIP_PREMIUM_COST_MONTHLY="3"
MEMBERSHIP_PREMIUM_COST_ANNUALLY="30"
MEMBERSHIP_PREMIUM_TRACK_STATS="true"
MEMBERSHIP_PREMIUM_ALLOW_NOTIFICATIONS="true"

#####
##### Object storage (optional — management storage browser)
#####
# When BUCKET_PROVIDER is unset, storage routes stay disabled.
# When set, validate the same bucket contract as workers (see apps/workers/.env.example and docs/image-shrinking/BUCKET-PROVIDERS.md).

# BUCKET_PROVIDER: digitalocean | aws-s3 | backblaze-b2 | garage | s3-compatible
BUCKET_PROVIDER=
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_REGION=
BUCKET_NAME=
BUCKET_CDN_BASE_URL=
# BUCKET_ENDPOINT: required for garage and s3-compatible (S3 API base URL); optional override elsewhere.
BUCKET_ENDPOINT=
# BUCKET_FORCE_PATH_STYLE: true | false | unset (unset = provider default).
BUCKET_FORCE_PATH_STYLE=

#####
##### Billing (optional — account resync refetches recorded purchases)
#####
# Each processor runs only when its *_ENABLED flag is "true"; empty keeps it off.
# Local overrides: dev/env-overrides/local/billing.env, paypal.env, billing-apple.env,
# billing-google-play.env
# Comma-separated account ids or id_text values whose sandbox purchases count in production
BILLING_SANDBOX_ALLOWED_ACCOUNT_IDS=
# "true" grants Premium from every sandbox purchase while NODE_ENV is production.
# Empty leaves production on the allowlist above. Live purchases always grant.
BILLING_SANDBOX_GRANT_ALL=
# "true" registers the test processor even when NODE_ENV is production.
BILLING_ALLOW_TEST_ADAPTER=
# "true" turns PayPal on (credentials below are then required); empty keeps it off
BILLING_PAYPAL_ENABLED=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox or live. Empty stays sandbox. Set live to use the PayPal live API.
PAYPAL_ENVIRONMENT=
PAYPAL_WEBHOOK_ID=
# "true" turns Apple In-App Purchase on (credentials below are then required); empty keeps it off
BILLING_APPLE_IAP_ENABLED=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY_PATH=
APPLE_IAP_BUNDLE_ID=
APPLE_IAP_APP_APPLE_ID=
# sandbox or production. Empty stays sandbox. Set production for the production App Store.
APPLE_IAP_ENVIRONMENT=
# "true" turns Google Play on (credentials below are then required); empty keeps it off
BILLING_GOOGLE_PLAY_ENABLED=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=
GOOGLE_PLAY_RTDN_PUSH_AUDIENCE=
GOOGLE_PLAY_RTDN_PUSH_SERVICE_ACCOUNT_EMAIL=
# "true" turns Strike on (credentials below are then required); empty keeps it off
BILLING_STRIKE_ENABLED=
STRIKE_API_KEY=
STRIKE_WEBHOOK_SECRET=
# production or sandbox
STRIKE_ENVIRONMENT=

#####
##### Observability
#####
# Contract: docs/operations/observability/TRACING.md
# Template: infra/config/env-templates/observability.env.example
OTEL_SERVICE_NAME="podverse-management-api"
OTEL_TRACES_EXPORT="none"
OTEL_EXPORTER_OTLP_ENDPOINT=

#####
##### Extensions (sidecar — separate container)
#####
# Shared keys: infra/config/env-templates/extensions.env.example
# Contract: docs/operations/extensions/EXTENSIONS-SIDECAR.md
OTEL_RESOURCE_ATTRIBUTES=

#####
##### Prometheus extension
#####
# Enables extension-prometheus sidecar + app OTLP export. When true, set OTEL_* above.
PROMETHEUS_ENABLED=
