#####
##### podverse-management-api
##### .env.example
#####
# Copy this file to .env and fill in the values.
# See ENV.md for detailed documentation of each variable.

#####
##### General
#####

NODE_ENV="development"
LOG_LEVEL="info"
# No default. Leave empty for console-only (e.g. local/dev or container without file logging).
# When using Docker with a log volume, set to the container path (e.g. /opt/logs).
LOG_DIR=

#####
##### API Configuration
#####

API_PORT="1999"
API_PREFIX="/api"
API_VERSION="/v1"

# Use the public facing domain, not the internal docker network ip address.
COOKIE_DOMAIN="localhost"

# Comma-separated list of allowed CORS origins
API_ALLOWED_CORS_ORIGINS="http://localhost:3999"

#####
##### Auth & Security
#####

# Must be a valid UUID - generate with: uuidgen
AUTH_JWT_SECRET="00000000-0000-0000-0000-000000000000"

# When blank, built at runtime from BRAND_NAME (format: BrandName Bot Local/Management-API/5)
USER_AGENT=
# Set from dev/env-overrides/local/brand.env by local_env_setup
BRAND_NAME=

#####
##### Web Configuration
#####

WEB_PROTOCOL="http"
WEB_DOMAIN="localhost:3999"

#####
##### Database (Postgres - Management Database)
#####

DB_HOST="localhost"
DB_PORT="5999"
DB_READ_USERNAME="read"
DB_READ_PASSWORD=
DB_READ_WRITE_USERNAME="read_write"
DB_READ_WRITE_PASSWORD=
DB_DATABASE="podverse_management"
# Set to true for SSL connection
DB_SSL_CONNECTION="false"
