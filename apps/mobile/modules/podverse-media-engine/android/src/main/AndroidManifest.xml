<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    Foreground media service for background audio survival and Android Auto (Track 12).
    This is a Media3 MediaLibraryService (NOT a throwaway Service) so Android Auto connects to the
    service, not the Activity (12.11-12.13). FOREGROUND_SERVICE* permissions are declared in the app
    manifest (app.config.ts). The android.media.browse.MediaBrowserService action makes the service
    discoverable by Android Auto / DHU; the browse tree grows from the native cache in 12.12-12.14.
  -->
  <application>
    <!--
      12.11 — declares Podverse as an Android Auto MEDIA app. This module manifest merges into the
      app manifest at prebuild, so the app is recognized as a media app for Android Auto / the DHU
      without hand-editing the generated app manifest. The res/xml/automotive_app_desc.xml resource
      ships with this module. The Play Console "Android Auto" declaration is a separate operator
      step (12.16 / ANDROID-AUTO-DECLARATION.md).
    -->
    <meta-data
      android:name="com.google.android.gms.car.application"
      android:resource="@xml/automotive_app_desc"/>
    <service
      android:name="expo.modules.podversemediaengine.PodverseMediaLibraryService"
      android:exported="true"
      android:foregroundServiceType="mediaPlayback">
      <intent-filter>
        <action android:name="androidx.media3.session.MediaLibraryService"/>
        <action android:name="android.media.browse.MediaBrowserService"/>
      </intent-filter>
    </service>
  </application>
</manifest>
