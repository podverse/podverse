# Optional shared base URL for both platforms.
# If set, this takes precedence over platform-specific values.
EXPO_PUBLIC_MOBILE_API_BASE_URL=

# Local API-backed dev defaults (include /api/v2 path).
EXPO_PUBLIC_MOBILE_API_BASE_URL_IOS="http://localhost:4230/api/v2"
EXPO_PUBLIC_MOBILE_API_BASE_URL_ANDROID="http://10.0.2.2:4230/api/v2"

# E2E mode: set to 1 for Maestro-friendly auth inputs and strict env validation.
EXPO_PUBLIC_MOBILE_E2E=
