# Optional shared base URL for both platforms.
# If set, this takes precedence over platform-specific values.
EXPO_PUBLIC_MOBILE_API_BASE_URL=

# E2E-oriented examples (include /api/v2 path).
# Day-to-day local dev can differ after `make local_env_setup` because that command derives
# values from shared `LOCAL_API_*` overrides (often host localhost on port 3000).
# For API-backed Maestro runs, `npm run mobile:dev:e2e` exports 4230 URLs that override `.env`.
# For a physical Android phone, use `npm run mobile:dev:device` (LAN IP; does not rewrite this file).
EXPO_PUBLIC_MOBILE_API_BASE_URL_IOS="http://localhost:4230/api/v2"
EXPO_PUBLIC_MOBILE_API_BASE_URL_ANDROID="http://10.0.2.2:4230/api/v2"

# E2E mode: set to 1 for Maestro-friendly auth inputs and strict env validation.
EXPO_PUBLIC_MOBILE_E2E=

# Push provider for this build flavor (`fcm` for playstore, `none` for no push transport).
EXPO_PUBLIC_MOBILE_PUSH_PROVIDER="fcm"
# UnifiedPush registration payload (used when EXPO_PUBLIC_MOBILE_PUSH_PROVIDER="unifiedpush").
EXPO_PUBLIC_MOBILE_UNIFIEDPUSH_ENDPOINT=
EXPO_PUBLIC_MOBILE_UNIFIEDPUSH_AUTH_KEY=

# Optional public web base URL (full URL, e.g. "https://podverse.fm"). Used to build share links and
# the universal / app link prefixes; app.config.ts derives the associated-domains host from it.
# When unset, falls back to WEB_BASE_URL and then https://podverse.fm.
EXPO_PUBLIC_MOBILE_WEB_BASE_URL=

# Optional custom URL scheme(s) for deep links, comma- or space-delimited (no "://").
# When unset, defaults to "podverse-next podverse" (beta scheme + legacy alias so an eventual
# in-place v4 -> v5 upgrade still resolves old podverse:// links). Forks set their own scheme(s),
# e.g. "myapp" or "myapp-next myapp". Registered natively (app.config.ts) and as JS linking prefixes.
EXPO_PUBLIC_MOBILE_DEEP_LINK_SCHEMES=
