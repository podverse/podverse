# Generated native projects and Expo local state
.expo/
dist/
web-build/

# Native build output (prebuild generates apps/mobile/ios and apps/mobile/android).
# Anchored so committed native modules under modules/*/ios and modules/*/android are NOT ignored.
/ios/
/android/

# Local module native build caches (source under modules/*/ios|android stays tracked)
modules/*/android/.gradle/
modules/*/android/build/
modules/*/ios/build/

# Metro / bundler
.metro-health-check*

# OS / IDE
.DS_Store
*.pem
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Debug
npm-debug.*
yarn-debug.*
yarn-error.*

# TypeScript
*.tsbuildinfo
