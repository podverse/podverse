# Maestro timeout ladder (ms). Prefer the fastest tier that can reasonably succeed.
# Wired into Maestro via scripts/mobile/e2e-test.sh (-e flags). Reference in YAML as ${TIMEOUT_*}.
TIMEOUT_FASTEST=2000
TIMEOUT_FASTER=3000
TIMEOUT_FAST=5000
TIMEOUT_SLOW=8000
TIMEOUT_SLOWER=12000
TIMEOUT_SLOWEST=20000
