{
  "cli": {
    "appVersionSource": "remote",
    "version": ">= 16.0.0"
  },
  "build": {
    "base": {
      "node": "24.15.0"
    },
    "internal": {
      "extends": "base",
      "android": {
        "autoIncrement": true,
        "buildType": "apk"
      },
      "channel": "internal",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "autoIncrement": true,
        "simulator": false
      }
    },
    "beta": {
      "extends": "base",
      "android": {
        "autoIncrement": true
      },
      "channel": "beta",
      "distribution": "store",
      "ios": {
        "autoIncrement": true
      }
    },
    "production": {
      "extends": "base",
      "android": {
        "autoIncrement": true
      },
      "channel": "production",
      "distribution": "store",
      "ios": {
        "autoIncrement": true
      }
    }
  },
  "submit": {
    "beta": {
      "android": {
        "releaseStatus": "draft",
        "track": "internal"
      },
      "ios": {}
    },
    "beta-rollout": {
      "android": {
        "releaseStatus": "completed",
        "track": "internal"
      }
    },
    "production": {
      "android": {},
      "ios": {}
    }
  }
}
