{
  "name": "@podverse/mobile",
  "version": "5.5.3",
  "private": true,
  "description": "Podverse next-generation mobile app (React Native + Expo prebuild)",
  "main": "index.js",
  "scripts": {
    "prestart": "npm run i18n-compile",
    "preios": "npm run i18n-compile",
    "preandroid": "npm run i18n-compile",
    "start": "expo start --dev-client",
    "prestart:clear": "npm run i18n-compile",
    "start:clear": "expo start --dev-client --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "i18n-compile": "ts-node --project ../../packages/i18n-catalog/tsconfig.scripts.json ../../packages/i18n-catalog/scripts/i18n-compile.ts",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@podverse/design-tokens": "file:../../packages/design-tokens",
    "@podverse/helpers": "file:../../packages/helpers",
    "@podverse/helpers-requests": "file:../../packages/helpers-requests",
    "@podverse/helpers-validation": "file:../../packages/helpers-validation",
    "@podverse/http-request-core": "file:../../packages/http-request-core",
    "@podverse/parser-mapping": "file:../../packages/parser-mapping",
    "@podverse/playback-core": "file:../../packages/playback-core",
    "@podverse/v4v-metaboost": "file:../../packages/v4v-metaboost",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.8",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "axios": "^1.16.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "expo": "52.0.49",
    "expo-build-properties": "^0.13.3",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.20",
    "expo-dev-launcher": "5.0.35",
    "expo-dev-menu": "6.0.25",
    "expo-dev-menu-interface": "1.9.3",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-localization": "~16.0.1",
    "expo-manifests": "~0.15.8",
    "expo-notifications": "~0.29.14",
    "expo-secure-store": "~14.0.1",
    "expo-splash-screen": "~0.29.24",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.1",
    "expo-updates-interface": "~1.0.0",
    "expo-web-browser": "~14.0.2",
    "he": "^1.2.0",
    "i18next": "^26.3.4",
    "joi": "^18.0.1",
    "react": "18.3.1",
    "react-i18next": "^17.0.8",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-safe-area-context": "~4.12.0",
    "react-native-screens": "~4.4.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "expo": "52.0.49",
    "react-native": "0.76.9",
    "@expo/dom-webview": {
      "expo": "52.0.49",
      "react-native": "0.76.9"
    },
    "expo-dev-launcher": {
      "expo": "52.0.49"
    },
    "expo-dev-menu": {
      "expo": "52.0.49"
    },
    "expo-dev-menu-interface": {
      "expo": "52.0.49"
    },
    "expo-manifests": {
      "expo": "52.0.49"
    },
    "expo-updates-interface": {
      "expo": "52.0.49"
    },
    "@xmldom/xmldom": "0.8.10",
    "tar": "6.2.1"
  }
}
