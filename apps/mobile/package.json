{
  "name": "@podverse/mobile",
  "version": "5.5.3",
  "private": true,
  "description": "Podverse next-generation mobile app (React Native + Expo prebuild)",
  "main": "index.js",
  "scripts": {
    "prestart": "npm run i18n-compile",
    "preios": "npm run i18n-compile",
    "preandroid": "npm run i18n-compile",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "i18n-compile": "ts-node --project ../../packages/i18n-catalog/tsconfig.scripts.json ../../packages/i18n-catalog/scripts/i18n-compile.ts"
  },
  "dependencies": {
    "@podverse/design-tokens": "*",
    "@podverse/helpers": "*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~52.0.46",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.20",
    "expo-dev-launcher": "5.0.35",
    "expo-dev-menu": "6.0.25",
    "expo-dev-menu-interface": "1.9.3",
    "expo-localization": "~16.0.1",
    "expo-manifests": "~0.15.8",
    "expo-status-bar": "~2.0.1",
    "expo-updates-interface": "~1.0.0",
    "i18next": "^26.3.4",
    "react": "18.3.1",
    "react-i18next": "^17.0.8",
    "react-native": "0.76.9"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.9.2"
  }
}
