{
  "name": "@podverse/mobile",
  "version": "5.6.0",
  "private": true,
  "description": "Podverse next-generation mobile app (React Native + Expo prebuild)",
  "main": "index.js",
  "scripts": {
    "prestart": "npm run i18n-compile",
    "preios": "npm run i18n-compile",
    "preandroid": "npm run i18n-compile",
    "start": "expo start --dev-client",
    "prestart:clear": "npm run i18n-compile",
    "start:clear": "expo start --dev-client --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "i18n-compile": "ts-node --project ../../packages/i18n-catalog/tsconfig.scripts.json ../../packages/i18n-catalog/scripts/i18n-compile.ts",
    "eas-build-pre-install": "bash ../../scripts/mobile/eas-build-pre-install.sh",
    "eas-build-post-install": "npm run i18n-compile",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@formatjs/intl-pluralrules": "^6.3.16",
    "@formatjs/intl-relativetimeformat": "^12.3.16",
    "@podverse/design-tokens": "file:../../packages/design-tokens",
    "@podverse/helpers": "file:../../packages/helpers",
    "@podverse/helpers-requests": "file:../../packages/helpers-requests",
    "@podverse/helpers-validation": "file:../../packages/helpers-validation",
    "@podverse/http-request-core": "file:../../packages/http-request-core",
    "@podverse/parser-mapping": "file:../../packages/parser-mapping",
    "@podverse/playback-core": "file:../../packages/playback-core",
    "@podverse/v4v-metaboost": "file:../../packages/v4v-metaboost",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.8",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "axios": "^1.16.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "expo": "^58.0.0",
    "expo-background-fetch": "~58.0.11",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-iap": "^5.0.0",
    "expo-image": "~58.0.15",
    "expo-localization": "~58.0.4",
    "expo-notifications": "~58.1.5",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-task-manager": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "he": "^1.2.0",
    "i18next": "^26.3.4",
    "joi": "^18.0.1",
    "react": "19.3.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tldts": "^7.4.15",
    "transcriptator": "^1.1.4",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "expo": "^58.0.0",
    "react-native": "0.88.0",
    "@xmldom/xmldom": "0.8.10"
  }
}
