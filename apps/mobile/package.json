{
  "name": "@podverse/mobile",
  "version": "5.5.3",
  "private": true,
  "description": "Podverse next-generation mobile app (React Native + Expo prebuild)",
  "main": "index.js",
  "scripts": {
    "prestart": "npm run i18n-compile",
    "preios": "npm run i18n-compile",
    "preandroid": "npm run i18n-compile",
    "start": "expo start --dev-client",
    "prestart:clear": "npm run i18n-compile",
    "start:clear": "expo start --dev-client --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "i18n-compile": "ts-node --project ../../packages/i18n-catalog/tsconfig.scripts.json ../../packages/i18n-catalog/scripts/i18n-compile.ts",
    "eas-build-pre-install": "bash ../../scripts/mobile/eas-build-pre-install.sh",
    "eas-build-post-install": "npm run i18n-compile",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@podverse/design-tokens": "file:../../packages/design-tokens",
    "@podverse/helpers": "file:../../packages/helpers",
    "@podverse/helpers-requests": "file:../../packages/helpers-requests",
    "@podverse/helpers-validation": "file:../../packages/helpers-validation",
    "@podverse/http-request-core": "file:../../packages/http-request-core",
    "@podverse/parser-mapping": "file:../../packages/parser-mapping",
    "@podverse/playback-core": "file:../../packages/playback-core",
    "@podverse/v4v-metaboost": "file:../../packages/v4v-metaboost",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.8",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "axios": "^1.16.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.0",
    "expo-background-fetch": "~57.0.21",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-iap": "^5.0.0",
    "expo-image": "~57.0.5",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "he": "^1.2.0",
    "i18next": "^26.3.4",
    "joi": "^18.0.1",
    "react": "19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "tldts": "^7.4.15",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "expo": "~57.0.0",
    "react-native": "0.86.3",
    "@xmldom/xmldom": "0.8.10"
  }
}
