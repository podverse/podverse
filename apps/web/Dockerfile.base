# Standalone deps image for web. Published by the Alpha workflow as web-base;
# used as the builder base for web-deploy (see apps/web/Dockerfile).
# Build context: repo root (.).
FROM node:26-slim
WORKDIR /opt

COPY package*.json tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/web/package*.json ./apps/web/

# Install all dependencies (devDependencies like @types/* needed for TypeScript compilation)
# --ignore-scripts skips the prepare script that tries to install git hooks
RUN npm ci --ignore-scripts
