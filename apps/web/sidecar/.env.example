#####
##### podverse-web env catalog
#####
# Canonical list for local web stack env. Copied to apps/web/sidecar/.env and
# infra/config/local/web-sidecar.env by make local_env_setup.
# Runtime-config sidecar process: Integrations + NEXT_PUBLIC_* (+ LOG_LEVEL).
# Next.js main app process: Observability + Extensions (synced to .env.local by setup.sh).
# Kubernetes: split across podverse-web-config, podverse-web-runtime-config,
# podverse-integrations-config, podverse-extensions-config.

#####
##### Observability
#####
OTEL_SERVICE_NAME="podverse-web"
OTEL_TRACES_EXPORT="none"
OTEL_TRACES_SAMPLER=
OTEL_TRACES_SAMPLER_ARG=

#####
##### Integrations (built-in — default image)
#####
# Local dev: set Cloudflare keys here on the runtime-config sidecar.
# Kubernetes: CLOUDFLARE_WEB_ANALYTICS_* → podverse-integrations-config (alpha/common).
# Template: infra/config/env-templates/integrations.env.example

CLOUDFLARE_WEB_ANALYTICS_ENABLED=
CLOUDFLARE_WEB_ANALYTICS_TOKEN=

#####
##### API Configuration (SSR)
#####
NEXT_PUBLIC_SSR_API_PROTOCOL="http"
NEXT_PUBLIC_SSR_API_HOST="localhost"
NEXT_PUBLIC_SSR_API_PORT="3000"

#####
##### API Configuration (Client)
#####
NEXT_PUBLIC_API_PROTOCOL="http"
NEXT_PUBLIC_API_HOST="localhost"
NEXT_PUBLIC_API_PORT="3000"
NEXT_PUBLIC_API_PREFIX="/api"
NEXT_PUBLIC_API_VERSION="/v2"

#####
##### Web
#####
NEXT_PUBLIC_WEB_PROTOCOL="http"
NEXT_PUBLIC_WEB_DOMAIN="localhost:3002"
NEXT_PUBLIC_POLLING_INTERVAL_MS="3000"
NEXT_PUBLIC_SIDEBAR_GROUP_ORDER="podcasts,music,addByRSS,library"

#####
##### Legal
#####
# Mirrors API LEGAL_NAME (synced by local_env_setup from legal.env)
NEXT_PUBLIC_LEGAL_NAME="Podverse LLC"
# Mirrors API TERMS_OF_SERVICE_VERSION
NEXT_PUBLIC_TERMS_OF_SERVICE_VERSION="2026-05-28"
# Mirrors workers STATS_TRACK_EVENT_RETENTION_DAYS (default 30 days)
NEXT_PUBLIC_STATS_TRACK_EVENT_RETENTION_DAYS="30"
# Set to "true" to show cookie consent banner (default off)
NEXT_PUBLIC_COOKIE_CONSENT_BANNER_ENABLED=

#####
##### Brand
#####
# Identity & header logos (from dev/env-overrides/local/brand.env via local_env_setup)
NEXT_PUBLIC_BRAND_NAME="Podverse"
NEXT_PUBLIC_BRAND_DOMAIN="podverse.fm"
NEXT_PUBLIC_BRAND_LOGO_DARK=
NEXT_PUBLIC_BRAND_LOGO_LIGHT=
# Full-size square mark. Canonical CDN asset: brand-square.png
NEXT_PUBLIC_BRAND_LOGO_SQUARE=
# Canonical CDN asset: brand-square-100x100.png
NEXT_PUBLIC_BRAND_LOGO_SQUARE_100X100=
# Navbar/sidebar/footer rectangular wordmark: layout expects 144×25. Set to "true" when the logo
# is not that ratio so height={25} is not applied to the brand <img> (width stays 144px).
NEXT_PUBLIC_BRAND_RECTANGULAR_LOGO_DISABLE_HEIGHT_ENFORCEMENT=

# App + document chrome (optional): install/manifest icons, theme, background, tab & touch icons.
# Installable app name/short_name use NEXT_PUBLIC_BRAND_NAME. Path-absolute values match
# public/favicon/; override with https://… for white-label.
NEXT_PUBLIC_BRAND_APP_ICON_192_URL=/favicon/web-app-manifest-192x192.png
NEXT_PUBLIC_BRAND_APP_ICON_512_URL=/favicon/web-app-manifest-512x512.png
NEXT_PUBLIC_BRAND_THEME_COLOR=#ffffff
NEXT_PUBLIC_BRAND_BACKGROUND_COLOR=#ffffff
NEXT_PUBLIC_BRAND_FAVICON_ICO_URL=/favicon/favicon.ico
NEXT_PUBLIC_BRAND_FAVICON_SVG_URL=/favicon/favicon.svg
NEXT_PUBLIC_BRAND_FAVICON_PNG_96_URL=/favicon/favicon-96x96.png
NEXT_PUBLIC_BRAND_APPLE_TOUCH_ICON_URL=/favicon/apple-touch-icon.png

#####
##### App Lightning Node (Optional)
#####
NEXT_PUBLIC_APP_VALUE_LIGHTNING_NODE_NAME=
NEXT_PUBLIC_APP_VALUE_LIGHTNING_NODE_ADDRESS=
NEXT_PUBLIC_APP_VALUE_LIGHTNING_NODE_CUSTOM_KEY=
NEXT_PUBLIC_APP_VALUE_LIGHTNING_NODE_CUSTOM_VALUE=

#####
##### App Lightning LNAddress (Optional)
#####
NEXT_PUBLIC_APP_VALUE_LIGHTNING_LNADDRESS_NAME=
NEXT_PUBLIC_APP_VALUE_LIGHTNING_LNADDRESS_ADDRESS=

#####
##### App MetaBoost (Optional)
#####
NEXT_PUBLIC_APP_VALUE_METABOOST_STANDARD=
NEXT_PUBLIC_APP_VALUE_METABOOST_NODE=

#####
##### Website Features
#####
NEXT_PUBLIC_FEATURES_SUPPORTED_LOCALES="all-available"
NEXT_PUBLIC_FEATURES_DEFAULT_LOCALE="en-US"

#####
##### Theme Configuration
#####
NEXT_PUBLIC_SUPPORTED_THEMES="all-available"
NEXT_PUBLIC_DEFAULT_THEME="dark"
# Optional remote custom theme pack URL. Allowed formats: https://... or local http://localhost:.../themes/*.json
NEXT_PUBLIC_CUSTOM_THEMES_URL=

#####
##### Web Push (Optional)
#####
NEXT_PUBLIC_WEBPUSH_VAPID_PUBLIC_KEY=

#####
##### Account / Membership
#####
NEXT_PUBLIC_ACCOUNT_SIGNUP_MODE="admin_only_email"

#####
##### Contact & Social Media Links (Optional)
#####
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SOCIAL_ACTIVITY_PUB=
NEXT_PUBLIC_SOCIAL_DISCORD=
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_MATRIX=
NEXT_PUBLIC_SOCIAL_X=

#####
##### Server Environment
#####
NEXT_PUBLIC_SERVER_ENV="local"

#####
##### Logging (optional)
#####
LOG_LEVEL=

#####
##### Proxy Configuration
#####
# Leave unset or "false" to load RSS/third-party artwork directly in the browser (no /api/proxy).
# Set to "true" to proxy external images and require NEXT_PUBLIC_PROXY_USER_AGENT below.
NEXT_PUBLIC_IMAGE_PROXY_ENABLED=
# Next.js Image Optimization (`/_next/image`), not /api/proxy. Unset/false = optimizer off (default).
NEXT_PUBLIC_NEXT_IMAGE_OPTIMIZATION_ENABLED=
NEXT_PUBLIC_PROXY_RESPONSE_CACHE_MAX_AGE_SECONDS="86400"
NEXT_PUBLIC_PROXY_USER_AGENT=

#####
##### Extensions
#####
PROMETHEUS_ENABLED="false"
OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4318"
OTEL_RESOURCE_ATTRIBUTES=
