{
  "name": "@podverse/web",
  "version": "5.5.3",
  "description": "Website for the Podverse podcast app",
  "private": true,
  "scripts": {
    "prebuild": "npm run i18n-compile",
    "build": "next build",
    "predev": "npm run i18n-compile",
    "dev": "next dev -p 3002",
    "dev:sidecar": "env PORT=3001 DOTENV_CONFIG_PATH=sidecar/.env node -r dotenv/config sidecar/dist/server.js",
    "dev:watch": "nodemon",
    "lint": "eslint ./src ./e2e --max-warnings 0",
    "lint:fix": "eslint ./src ./e2e --fix",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:cloudflare-enabled": "playwright test -c playwright.cloudflare-web-analytics-enabled.config.ts",
    "test:e2e:cookie-consent-enabled": "playwright test -c playwright.cookie-consent-enabled.config.ts",
    "test:e2e:signup-enabled": "playwright test -c playwright.signup-enabled.config.ts",
    "test:e2e:custom-themes-native": "playwright test -c playwright.custom-themes-native.config.ts",
    "test:e2e:custom-themes-remote": "playwright test -c playwright.custom-themes-remote.config.ts",
    "test:e2e:custom-themes-combo": "playwright test -c playwright.custom-themes-combo.config.ts",
    "start": "next start",
    "postbuild:standalone": "mkdir -p .next/standalone/apps/web/.next && cp -r .next/static .next/standalone/apps/web/.next/static && cp -r public .next/standalone/apps/web/public",
    "start:standalone": "node .next/standalone/apps/web/server.js",
    "clean": "rm -rf .next",
    "type-check": "tsc --noEmit -p .",
    "validate-env": "ts-node --project tsconfig.scripts.json scripts/validate-env.ts",
    "i18n-compile": "ts-node --project ../../packages/i18n-catalog/tsconfig.scripts.json ../../packages/i18n-catalog/scripts/i18n-compile.ts",
    "i18n-llm-translations": "ts-node --project ../../packages/i18n-catalog/tsconfig.scripts.json ../../packages/i18n-catalog/scripts/i18n-translate.ts"
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@podverse/extension-metrics-sdk": "*",
    "@podverse/helpers": "*",
    "@podverse/helpers-backend": "*",
    "@podverse/helpers-browser": "*",
    "@podverse/helpers-config": "*",
    "@podverse/helpers-requests": "*",
    "@podverse/helpers-validation": "*",
    "@podverse/integrations-web": "*",
    "@podverse/observability": "*",
    "@podverse/parser-mapping": "*",
    "@podverse/playback-core": "*",
    "@podverse/ui": "*",
    "@podverse/v4v-btc-ln": "*",
    "@podverse/v4v-helpers": "*",
    "@podverse/v4v-metaboost": "*",
    "classnames": "^2.5.1",
    "next": "^16.3.1",
    "next-intl": "^4.13.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-virtuoso": "^4.18.12",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "transcriptator": "^1.1.4",
    "uuid": "^14.0.2",
    "video.js": "^8.24.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.2",
    "@types/video.js": "^7.3.58",
    "@vitejs/plugin-react": "^5.1.1",
    "axios": "^1.19.0",
    "dotenv": "^17.2.2",
    "jsdom": "^26.1.0",
    "nodemon": "^3.1.14",
    "openai": "^6.27.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "webpack": "^5.105.4"
  }
}
