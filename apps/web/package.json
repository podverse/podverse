{
  "name": "@podverse/web",
  "version": "5.2.5",
  "description": "Website for the Podverse podcast app",
  "private": true,
  "scripts": {
    "prebuild": "npm run validate-env && npm run i18n-compile",
    "build": "next build --webpack",
    "predev": "npm run validate-env && npm run i18n-compile",
    "dev": "next dev --webpack",
    "dev:watch": "nodemon",
    "lint": "eslint ./src --max-warnings 0",
    "lint:fix": "eslint ./src --fix",
    "start": "next start",
    "clean": "rm -rf .next",
    "validate-env": "ts-node --project tsconfig.scripts.json scripts/validate-env.ts",
    "i18n-compile": "ts-node --project tsconfig.scripts.json scripts/i18n/i18n-compile.ts",
    "i18n-llm-translations": "ts-node --project tsconfig.scripts.json scripts/i18n/i18n-llm-translations.ts"
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@podverse/helpers": "*",
    "@podverse/helpers-browser": "*",
    "@podverse/helpers-config": "*",
    "@podverse/helpers-requests": "*",
    "@podverse/helpers-validation": "*",
    "classnames": "^2.5.1",
    "isomorphic-dompurify": "^2.28.0",
    "next": "^16.1.6",
    "next-intl": "^4.3.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.14.1",
    "sass": "^1.92.1",
    "sharp": "^0.34.5",
    "transcriptator": "^1.1.4",
    "uuid": "^13.0.0",
    "video.js": "^8.23.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "webpack": "^5.0.0",
    "@types/node": "^25.0.10",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.2.2",
    "@types/video.js": "^7.3.58",
    "axios": "^1.13.4",
    "dotenv": "^17.2.2",
    "nodemon": "^3.1.10",
    "openai": "^6.16.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
