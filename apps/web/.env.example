#####
##### podverse-web
#####
# Copy this file to .env.local and set RUNTIME_CONFIG_URL.
# When using the runtime-config sidecar, this is the only var the app process needs;
# all other config is loaded from the sidecar at runtime.
# For the full variable list (sidecar or run-without-sidecar), see:
#   apps/web/sidecar/.env.example
#   ENV.md

#####
##### Runtime Config Sidecar
#####
# Internal URL for the runtime-config sidecar (e.g. http://localhost:3001)
RUNTIME_CONFIG_URL="http://localhost:3001"
