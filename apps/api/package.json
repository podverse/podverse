{
  "name": "@podverse/api",
  "version": "5.4.1",
  "type": "module",
  "description": "Data API, database migration scripts, and backend services for Podverse",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run lint && tsc && tsc-alias",
    "build:prod": "tsc -p tsconfig.prod.json && tsc-alias -p tsconfig.prod.json",
    "dev": "tsc && tsc-alias && node ./dist/index.js",
    "dev:watch": "tsc --build --watch --preserveWatchOutput & tsc-alias --watch & nodemon --delay 1000ms --watch dist --watch ../../packages/helpers/dist --watch ../../packages/external-services-firebase/dist --watch ../../packages/external-services-paypal/dist --watch ../../packages/external-services-podcast-index/dist --watch ../../packages/orm/dist --watch ../../packages/notifications/dist --watch ../../packages/parser/dist --watch ../../packages/mq/dist dist/index.js",
    "dev:inspect": "tsc && node --inspect ./dist/index.js",
    "dev:inspect:watch": "tsc --build --watch --preserveWatchOutput & tsc-alias --watch & nodemon --inspect --delay 1000ms --watch dist --watch ../../packages/helpers/dist --watch ../../packages/external-services-firebase/dist --watch ../../packages/external-services-paypal/dist --watch ../../packages/external-services-podcast-index/dist --watch ../../packages/orm/dist --watch ../../packages/notifications/dist --watch ../../packages/parser/dist --watch ../../packages/mq/dist dist/index.js",
    "lint": "eslint ./src --max-warnings 0",
    "lint:fix": "eslint ./src --fix",
    "start": "node ./dist/index.js",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "@podverse/external-services-firebase": "*",
    "@podverse/external-services-paypal": "*",
    "@podverse/external-services-podcast-index": "*",
    "@podverse/helpers": "*",
    "@podverse/mq": "*",
    "@podverse/notifications": "*",
    "@podverse/orm": "*",
    "@podverse/parser": "*",
    "@podverse/parser-mapping": "*",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.0",
    "ioredis": "^5.10.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "uuid": "^13.0.0",
    "@podverse/helpers-backend": "*",
    "@podverse/helpers-config": "*",
    "@podverse/helpers-requests": "*"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.49.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.12",
    "@types/nodemailer": "^7.0.10",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16"
  }
}
