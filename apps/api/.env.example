#####
##### podverse-api
##### .env.example
#####
# Copy this file to .env and fill in the values.
# See ENV.md for detailed documentation of each variable.

# NOTE:
# Use lowercase true to enable properties.
# Leave value blank or comment out to disable properties.

#####
##### App / General
#####

NODE_ENV="development"
LOG_LEVEL="info"

# Must be one of: prod, beta, alpha, local
SERVER_ENV="local"

#####
##### API Configuration
#####

API_PORT="1234"
API_PREFIX="/api"
API_VERSION="/v2"

# Comma-separated list of allowed CORS origins
API_ALLOWED_CORS_ORIGINS="http://localhost:3000"

#####
##### Auth & Security
#####

# Must be a valid UUID - generate with: uuidgen
AUTH_JWT_SECRET="00000000-0000-0000-0000-000000000000"

# Format: BrandName Bot Environment/AppName/Version
USER_AGENT="Podverse Bot Local/API/5"

# Use the public facing domain, not the internal docker network ip address.
COOKIE_DOMAIN="localhost"

#####
##### Web Configuration
#####

WEB_PROTOCOL="http"
WEB_DOMAIN="localhost:3000"

#####
##### Database (Postgres)
#####

DB_HOST="localhost"
DB_PORT="5432"
DB_READ_USERNAME="read"
DB_READ_PASSWORD="your_read_password"
DB_READ_WRITE_USERNAME="read_write"
DB_READ_WRITE_PASSWORD="your_read_write_password"
DB_DATABASE="postgres"
# Set to true for SSL connection
DB_SSL_CONNECTION=""

#####
##### Key-Value Database (Redis)
#####

KEYVALDB_HOST="localhost"
KEYVALDB_PORT="6379"
KEYVALDB_PASSWORD="your_redis_password"
KEYVALDB_CACHE_TTL_SECONDS="3600"

#####
##### Message Queue (RabbitMQ)
#####

MESSAGE_QUEUE_PROTOCOL="amqp"
MESSAGE_QUEUE_HOST="localhost"
MESSAGE_QUEUE_USERNAME="user"
MESSAGE_QUEUE_PASSWORD="your_mq_password"
MESSAGE_QUEUE_PORT="5672"

#####
##### Podcast Index
#####

PODCAST_INDEX_BASE_URL="https://api.podcastindex.org/api/1.0"
PODCAST_INDEX_AUTH_KEY="your_podcast_index_auth_key"
PODCAST_INDEX_SECRET_KEY="your_podcast_index_secret_key"

#####
##### Account / Membership
#####

# Must be either "sign-up" or "contact-only"
# "sign-up" - enables user registration (requires mailer config below)
# "contact-only" - disables user registration
ACCOUNT_SIGNUP_MODE="contact-only"

# Optional premium membership costs (set to 0 for free signups)
PREMIUM_MEMBERSHIP_COST_MONTHLY=""
PREMIUM_MEMBERSHIP_COST_ANNUALLY=""
FREE_TRIAL_EXPIRATION=""

#####
##### Mailer (Required when ACCOUNT_SIGNUP_MODE=sign-up)
#####

# Set to true to disable mailer
MAILER_DISABLED="true"
MAILER_HOST="smtp.example.com"
MAILER_PORT="587"
MAILER_USERNAME="your_smtp_username"
MAILER_PASSWORD="your_smtp_password"
MAILER_FROM="noreply@example.com"

#####
##### Email Template (Required when ACCOUNT_SIGNUP_MODE=sign-up)
#####

EMAIL_BRAND_COLOR="#2968B1"
EMAIL_HEADER_IMAGE_URL="https://example.com/images/logo.png"
LEGAL_NAME="Your Company Name"
LEGAL_ADDRESS="Your City, State, Country"

#####
##### Token Expiration (Required when ACCOUNT_SIGNUP_MODE=sign-up)
#####

# Values in seconds
VERIFY_EMAIL_TOKEN_EXPIRATION="31540000"
EMAIL_CHANGE_VERIFICATION_TOKEN_EXPIRATION="31540000"
RESET_PASSWORD_TOKEN_EXPIRATION="86400"

#####
##### Page Paths (Required when ACCOUNT_SIGNUP_MODE=sign-up)
#####

VERIFY_EMAIL_PAGE_PATH="/verify-email?token="
EMAIL_CHANGE_VERIFICATION_PAGE_PATH="/verify-email-change?token="
RESET_PASSWORD_PAGE_PATH="/reset-password?token="

#####
##### Social Media (Optional, used in email templates)
#####

SOCIAL_FACEBOOK_PAGE_URL=""
SOCIAL_FACEBOOK_IMAGE_URL=""
SOCIAL_GITHUB_PAGE_URL=""
SOCIAL_GITHUB_IMAGE_URL=""
SOCIAL_TWITTER_PAGE_URL=""
SOCIAL_TWITTER_IMAGE_URL=""

#####
##### PayPal (Optional, for payment processing)
#####

PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
