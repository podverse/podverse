#####
##### podverse-api
#####
# Copy this file to .env and fill in the values.
# See ENV.md for detailed documentation of each variable.

# NOTE:
# Use lowercase true to enable properties.
# Leave value blank or comment out to disable properties.

#####
##### General
#####

NODE_ENV="development"
LOG_LEVEL="info"
# No default. Leave empty for console-only (e.g. local/dev or container without file logging).
# When using Docker with a log volume, set to the container path (e.g. /opt/logs).
LOG_DIR=

# Must be one of: prod, beta, alpha, local
SERVER_ENV="local"

#####
##### API Configuration
#####

API_PORT="3000"
API_PREFIX="/api"
API_VERSION="/v2"
API_RELEASE="X.X.X-staging.N"

# Comma-separated list of allowed CORS origins
API_ALLOWED_CORS_ORIGINS="http://localhost:3002"

#####
##### Auth & Security
#####

# Set by local_env_setup (valid UUID); when running without setup, generate with: uuidgen
AUTH_JWT_SECRET=

# JWT/cookie session length in seconds (jsonwebtoken `expiresIn` as seconds / cookie max-age). When blank, default 31536000 (365d).
AUTH_JWT_EXPIRATION="31536000"

# When true, login JSON may include `token` if the client sends includeTokenInResponseBody. When blank/false, omit.
AUTH_ALLOW_TOKEN_IN_RESPONSE_BODY="false"

# When blank, built at runtime from BRAND_NAME (format: BrandName Bot Local/API/5)
USER_AGENT="Example Bot/API/5"

# Use the public facing domain, not the internal docker network ip address.
COOKIE_DOMAIN="localhost"

#####
##### Web Configuration
#####
# Set from dev/env-overrides/local/brand.env by local_env_setup
BRAND_NAME=
BRAND_COLOR_PRIMARY="#2968B1"
BRAND_BANNER_IMAGE_3X1_URL="http://localhost:3002/branding/banner_3x1.png"
WEB_PROTOCOL="http"
WEB_DOMAIN="localhost:3002"
WEB_ICON_IMAGE_PATH="http://localhost:3002/favicon/web-app-manifest-192x192.png"

#####
##### Database (Postgres)
#####
# Role names match postgres users from `make local_db_init` / infra (see docs/QUICKSTART.md).

DB_HOST="localhost"
DB_PORT="5432"
DB_APP_NAME="podverse_app"
DB_APP_READ_USER="podverse_app_read"
DB_APP_READ_PASSWORD=
DB_APP_READ_WRITE_USER="podverse_app_read_write"
DB_APP_READ_WRITE_PASSWORD=
# Set to true for SSL connection
DB_SSL_CONNECTION="false"

#####
##### Key-value (Valkey / Redis)
#####

KEYVALDB_HOST="localhost"
KEYVALDB_PORT="6379"
KEYVALDB_PASSWORD=
KEYVALDB_CACHE_EXPIRATION="86400"

#####
##### Message Queue (RabbitMQ)
#####

MESSAGE_QUEUE_PROTOCOL="amqp"
MESSAGE_QUEUE_HOST="localhost"
MESSAGE_QUEUE_USERNAME="user"
MESSAGE_QUEUE_PASSWORD=
MESSAGE_QUEUE_PORT="5672"

#####
##### Podcast Index
#####

PODCAST_INDEX_BASE_URL="https://api.podcastindex.org/api/1.0"
PODCAST_INDEX_AUTH_KEY=
PODCAST_INDEX_SECRET_KEY=
# Optional: Delay in milliseconds between Podcast Index API requests
# Default is 200ms if not specified. Set to 0 to disable.
PODCAST_INDEX_API_RATE_LIMIT_DELAY="200"

#####
##### Account / Membership
#####

# Must be one of: "admin_only_username", "admin_only_email", "user_signup_email"
# "admin_only_username" - accounts created by management admin only, username-only (no email required)
# "admin_only_email" - accounts created by management admin only, requires email
# "user_signup_email" - enables public user registration with email (requires mailer config below)
ACCOUNT_SIGNUP_MODE="admin_only_email"

# Optional premium membership costs (set to 0 for free signups)
PREMIUM_MEMBERSHIP_COST_MONTHLY="3"
PREMIUM_MEMBERSHIP_COST_ANNUALLY="30"
# Free trial duration in days
FREE_TRIAL_EXPIRATION="31"

#####
##### Mailer (Required when ACCOUNT_SIGNUP_MODE uses email flows)
#####

MAILER_HOST=
MAILER_PORT=
MAILER_USERNAME=
MAILER_PASSWORD=
MAILER_FROM=

#####
##### Legal entity (Required when ACCOUNT_SIGNUP_MODE uses email flows)
#####
# Local overrides: dev/env-overrides/local/legal.env (see legal.env.example)
LEGAL_NAME="Podverse LLC"
LEGAL_ADDRESS="Chicago, IL, USA"

#####
##### Token Expiration (Required when ACCOUNT_SIGNUP_MODE uses email flows)
#####

# Values in seconds
VERIFY_EMAIL_TOKEN_EXPIRATION="31540000"
EMAIL_CHANGE_VERIFICATION_TOKEN_EXPIRATION="31540000"
RESET_PASSWORD_TOKEN_EXPIRATION="86400"

#####
##### Social Media (Optional, used in email templates)
#####
# Customize via dev/env-overrides/local/socials.env (make local_env_setup to apply)
SOCIAL_FACEBOOK_PAGE_URL="https://facebook.com/podverse"
SOCIAL_FACEBOOK_IMAGE_URL="https://podverse.fm/images/social-facebook-128x128.png"
SOCIAL_GITHUB_PAGE_URL="https://github.com/podverse"
SOCIAL_GITHUB_IMAGE_URL="https://podverse.fm/images/social-github-128x128.png"
SOCIAL_TWITTER_PAGE_URL="https://twitter.com/podverse"
SOCIAL_TWITTER_IMAGE_URL="https://podverse.fm/images/social-twitter-128x128.png"

#####
##### Add-by-RSS
#####
# Basic Auth credentials for add-by-RSS feeds are stored per-feed in the database
# (account_following_add_by_rss_channel). Required: 64 hex characters (32 bytes)
# for AES-256-GCM encryption at rest. Generate with: openssl rand -hex 32
ADD_BY_RSS_CREDENTIALS_ENCRYPTION_KEY=

#####
##### Default Account Settings
#####
# These are used as default values when creating new accounts.
DEFAULT_ACCOUNT_SETTINGS_LOCALE="en-US"

#####
##### MetaBoost Standard Endpoint (mbrss-v1 AppAssertion) — optional integration
#####
# Mint requires a logged-in user (session cookie or bearer JWT); without auth the API returns 401.
# Both METABOOST_* vars below must be set to enable minting; otherwise the endpoint returns 503.
# Ed25519 PKCS#8 PEM for signing AppAssertion JWTs (server-only). Align with public key in https://github.com/v4v-io/metaboost-registry.
METABOOST_SIGNING_KEY_PEM=
# Registered MetaBoost app_id (iss). No default—omit when Metaboost is not configured.
METABOOST_APP_ASSERTION_ISS=

#####
##### PayPal (Optional, for payment processing)
#####

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

#####
##### WebPush (optional)
#####
# Match apps/workers/.env when WebPush is enabled (see ENV.md).
# Set to true to enable WebPush notifications
WEBPUSH_ENABLED=
# Required if WebPush enabled — generate with: npx web-push generate-vapid-keys
WEBPUSH_VAPID_PUBLIC_KEY=
# Local/dev: set here to match workers. Kubernetes: same Secret as workers — `podverse-workers-webpush-opaque`
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=
