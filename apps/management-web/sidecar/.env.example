#####
##### podverse-management-web env catalog
#####
# Canonical list for local management-web stack env. Copied to apps/management-web/sidecar/.env
# and infra/config/local/management-web-sidecar.env by make local_env_setup.
# Runtime-config sidecar process: Integrations + NEXT_PUBLIC_*.
# Next.js main app process: Observability + Extensions (synced to .env.local by setup.sh).
# Kubernetes: split across management-web ConfigMaps (see infra/k8s/base/management-web/source/).

#####
##### Observability
#####
OTEL_SERVICE_NAME="podverse-management-web"
OTEL_TRACES_EXPORT="none"
OTEL_TRACES_SAMPLER=
OTEL_TRACES_SAMPLER_ARG=

#####
##### Integrations (built-in — default image)
#####
# Local dev: set Cloudflare keys here on the runtime-config sidecar.
# Kubernetes: CLOUDFLARE_WEB_ANALYTICS_* → podverse-integrations-config (alpha/common).
# Template: infra/config/env-templates/integrations.env.example

CLOUDFLARE_WEB_ANALYTICS_ENABLED=
CLOUDFLARE_WEB_ANALYTICS_TOKEN=

#####
##### API Configuration (SSR)
#####
NEXT_PUBLIC_SSR_API_PROTOCOL="http"
NEXT_PUBLIC_SSR_API_HOST="localhost"
NEXT_PUBLIC_SSR_API_PORT="3100"

#####
##### API Configuration (Client)
#####
NEXT_PUBLIC_API_PROTOCOL="http"
NEXT_PUBLIC_API_HOST="localhost"
NEXT_PUBLIC_API_PORT="3100"
NEXT_PUBLIC_API_PREFIX="/api"
NEXT_PUBLIC_API_VERSION="/v2"

#####
##### Brand
#####
# Identity (from dev/env-overrides/local/brand.env: MANAGEMENT_BRAND_NAME, BRAND_DOMAIN via local_env_setup)
NEXT_PUBLIC_BRAND_NAME="Podverse"
NEXT_PUBLIC_BRAND_DOMAIN="podverse.fm"

# App + document chrome (optional): install/manifest icons, theme, background, tab & touch icons.
# Installable app name/short_name use NEXT_PUBLIC_BRAND_NAME. Path-absolute values match
# public/favicon/; override with https://… for white-label.
NEXT_PUBLIC_BRAND_APP_ICON_192_URL=/favicon/web-app-manifest-192x192.png
NEXT_PUBLIC_BRAND_APP_ICON_512_URL=/favicon/web-app-manifest-512x512.png
NEXT_PUBLIC_BRAND_THEME_COLOR=#ffffff
NEXT_PUBLIC_BRAND_BACKGROUND_COLOR=#ffffff
NEXT_PUBLIC_BRAND_FAVICON_ICO_URL=/favicon/favicon.ico
NEXT_PUBLIC_BRAND_FAVICON_SVG_URL=/favicon/favicon.svg
NEXT_PUBLIC_BRAND_FAVICON_PNG_96_URL=/favicon/favicon-96x96.png
NEXT_PUBLIC_BRAND_APPLE_TOUCH_ICON_URL=/favicon/apple-touch-icon.png

#####
##### Website Features
#####
NEXT_PUBLIC_FEATURES_SUPPORTED_LOCALES="all-available"
NEXT_PUBLIC_FEATURES_DEFAULT_LOCALE="en-US"

#####
##### UI theme
#####
NEXT_PUBLIC_SUPPORTED_THEMES="all-available"
NEXT_PUBLIC_DEFAULT_THEME="dark"
# Optional remote custom theme pack URL. Allowed formats: https://... or local http://localhost:.../themes/*.json
NEXT_PUBLIC_CUSTOM_THEMES_URL=

#####
##### Extensions
#####
PROMETHEUS_ENABLED="false"
OTEL_EXPORTER_OTLP_ENDPOINT="http://127.0.0.1:4318"
OTEL_RESOURCE_ATTRIBUTES=
