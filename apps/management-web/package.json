{
  "name": "@podverse/management-web",
  "version": "5.5.3",
  "description": "Administrative management interface for Podverse",
  "private": true,
  "scripts": {
    "prebuild": "npm run i18n-compile",
    "build": "next build",
    "predev": "npm run i18n-compile",
    "dev": "next dev -p 3102",
    "dev:sidecar": "env PORT=3101 DOTENV_CONFIG_PATH=sidecar/.env node -r dotenv/config sidecar/dist/server.js",
    "lint": "eslint ./src ./e2e --max-warnings 0",
    "lint:fix": "eslint ./src ./e2e --fix",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:storage-enabled": "playwright test -c playwright.storage-enabled.config.ts",
    "test:e2e:cloudflare-enabled": "playwright test -c playwright.cloudflare-web-analytics-enabled.config.ts",
    "start": "next start",
    "postbuild:standalone": "mkdir -p .next/standalone/apps/management-web/.next && cp -r .next/static .next/standalone/apps/management-web/.next/static && cp -r public .next/standalone/apps/management-web/public",
    "start:standalone": "node .next/standalone/apps/management-web/server.js",
    "clean": "rm -rf .next",
    "type-check": "tsc --noEmit -p .",
    "validate-env": "ts-node --project tsconfig.scripts.json scripts/validate-env.ts",
    "i18n-compile": "ts-node --project ../../packages/i18n-catalog/tsconfig.scripts.json ../../packages/i18n-catalog/scripts/i18n-compile.ts",
    "i18n-llm-translations": "ts-node --project ../../packages/i18n-catalog/tsconfig.scripts.json ../../packages/i18n-catalog/scripts/i18n-translate.ts"
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@podverse/extension-metrics-sdk": "*",
    "@podverse/helpers": "*",
    "@podverse/helpers-backend": "*",
    "@podverse/helpers-browser": "*",
    "@podverse/integrations-web": "*",
    "@podverse/management-api-requests": "*",
    "@podverse/observability": "*",
    "@podverse/ui": "*",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.16.1",
    "classnames": "^2.5.1",
    "next": "^16.2.10",
    "next-intl": "^4.13.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.3",
    "sass": "^1.98.0",
    "sharp": "^0.35.3",
    "transcriptator": "^1.1.4",
    "uuid": "^14.0.1",
    "video.js": "^8.23.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@podverse/helpers-config": "*",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.2",
    "@types/video.js": "^7.3.58",
    "dotenv": "^17.2.2",
    "nodemon": "^3.1.14",
    "openai": "^6.27.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
