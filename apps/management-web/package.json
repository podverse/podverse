{
  "name": "@podverse/management-web",
  "version": "5.4.13",
  "description": "Administrative management interface for Podverse",
  "private": true,
  "scripts": {
    "prebuild": "npm run i18n-compile",
    "build": "next build",
    "predev": "npm run i18n-compile",
    "dev": "next dev -p 3102",
    "dev:sidecar": "env PORT=3101 DOTENV_CONFIG_PATH=sidecar/.env node -r dotenv/config sidecar/dist/server.js",
    "lint": "eslint ./src --max-warnings 0",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "next start",
    "clean": "rm -rf .next",
    "type-check": "tsc --noEmit -p .",
    "validate-env": "ts-node --project tsconfig.scripts.json scripts/validate-env.ts",
    "i18n-compile": "ts-node --project tsconfig.scripts.json scripts/i18n/i18n-compile.ts",
    "i18n-llm-translations": "ts-node --project tsconfig.scripts.json scripts/i18n/i18n-llm-translations.ts"
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@podverse/helpers": "*",
    "@podverse/helpers-backend": "*",
    "@podverse/helpers-browser": "*",
    "@podverse/ui": "*",
    "@tanstack/react-query": "^5.99.2",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.13.6",
    "classnames": "^2.5.1",
    "isomorphic-dompurify": "^3.0.0",
    "next": "^16.1.6",
    "next-intl": "^4.8.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.3",
    "sass": "^1.98.0",
    "sharp": "^0.34.5",
    "transcriptator": "^1.1.4",
    "uuid": "^14.0.0",
    "video.js": "^8.23.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.11",
    "@types/react-dom": "^19.2.2",
    "@types/video.js": "^7.3.58",
    "dotenv": "^17.2.2",
    "nodemon": "^3.1.14",
    "openai": "^6.27.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
