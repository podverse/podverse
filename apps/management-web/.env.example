#####
##### podverse-management-web
#####
# Copy this file to .env.local and fill in the values.
# Or copy from env/local.env for local development.
# See ENV.md for detailed documentation of each variable.

#####
##### General
#####
# Set to "production" in Docker/infra; use "development" for local .env.local
NODE_ENV="development"

#####
##### Runtime Config Sidecar
#####
# Internal URL for the runtime-config sidecar (e.g. http://localhost:3101)
RUNTIME_CONFIG_URL="http://localhost:3101"

#####
##### API Configuration (SSR)
#####
# Server-side requests (e.g. from Next.js server). Use Docker service name in infra/config/local when running in Compose.
NEXT_PUBLIC_SSR_API_PROTOCOL="http"
NEXT_PUBLIC_SSR_API_HOST="localhost"
NEXT_PUBLIC_SSR_API_PORT="1999"

#####
##### API Configuration (Client)
#####
NEXT_PUBLIC_API_PROTOCOL="http"
NEXT_PUBLIC_API_HOST="localhost"
NEXT_PUBLIC_API_PORT="1999"
NEXT_PUBLIC_API_PREFIX="/api"
NEXT_PUBLIC_API_VERSION="/v2"

#####
##### Web Configuration
#####
# Set from dev/env-overrides/local/brand.env (MANAGEMENT_BRAND_NAME) by local_env_setup
NEXT_PUBLIC_BRAND_NAME=

#####
##### Website Features
#####
# Comma-delimited list of valid locales or "all-available"
NEXT_PUBLIC_FEATURES_SUPPORTED_LOCALES="all-available"
NEXT_PUBLIC_FEATURES_DEFAULT_LOCALE="en-US"
