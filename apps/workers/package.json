{
  "name": "@podverse/workers",
  "version": "5.2.2",
  "description": "Background workers and CLI tools for Podverse",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run lint && tsc && tsc-alias",
    "build:prod": "tsc && tsc-alias",
    "lint": "eslint ./src --max-warnings 0",
    "lint:fix": "eslint ./src --fix",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "start": "node ./dist/index.js",
    "archive_all": "ts-node -r tsconfig-paths/register ./src/index.ts archiveAll",
    "mq_rss_add": "ts-node -r tsconfig-paths/register ./src/index.ts mqRSSAdd",
    "mq_rss_add_all": "ts-node -r tsconfig-paths/register ./src/index.ts mqRSSAddAll",
    "mq_rss_add_recently_updated_feeds_from_podcast_index": "ts-node -r tsconfig-paths/register ./src/index.ts mqRSSAddRecentlyUpdatedFeedsFromPodcastIndex",
    "mq_rss_run_live_item_listener": "ts-node -r tsconfig-paths/register ./src/index.ts mqRSSRunLiveItemListener",
    "mq_rss_run_parser": "ts-node -r tsconfig-paths/register ./src/index.ts mqRSSRunParser",
    "mq_rss_run_dlq_consumer": "ts-node -r tsconfig-paths/register ./src/index.ts mqRSSRunDlqConsumer",
    "orm_feed_update_flag_status": "ts-node -r tsconfig-paths/register ./src/index.ts ormFeedUpdateFlagStatus",
    "orm_on_demand_parser_event_delete_outdated": "ts-node -r tsconfig-paths/register ./src/index.ts deleteOutdatedOnDemandParserEvent",
    "orm_on_demand_parser_event_generate_reports": "ts-node -r tsconfig-paths/register ./src/index.ts generateOnDemandParserEventReports",
    "parser_rss_parse_feed": "ts-node -r tsconfig-paths/register ./src/index.ts parserRSSParseFeed",
    "podcast_index_dead_feeds_delete_cache": "ts-node -r tsconfig-paths/register ./src/index.ts podcastIndexDeadFeedsDeleteCache",
    "podcast_index_dead_feeds_flag_and_merge": "ts-node -r tsconfig-paths/register ./src/index.ts podcastIndexDeadFeedsFlagAndMerge",
    "podcast_index_trending_podcasts_get": "ts-node -r tsconfig-paths/register ./src/index.ts podcastIndexTrendingPodcastsGet",
    "podcast_index_value_update_all": "ts-node -r tsconfig-paths/register ./src/index.ts podcastIndexValueUpdateAll",
    "stats_update_aggregated": "ts-node -r tsconfig-paths/register ./src/index.ts statsUpdateAggregated"
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "@podverse/external-services": "*",
    "@podverse/helpers": "*",
    "@podverse/mq": "*",
    "@podverse/notifications": "*",
    "@podverse/orm": "*",
    "@podverse/parser": "*",
    "amqplib": "^0.10.9",
    "axios": "^1.13.4",
    "pg": "^8.16.3",
    "typeorm": "^0.3.26",
    "typeorm-naming-strategies": "^4.1.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "@podverse/helpers-backend": "*",
    "@podverse/helpers-config": "*"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.49.0",
    "@types/node": "^25.0.10",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0"
  }
}
