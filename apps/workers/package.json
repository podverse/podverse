{
  "name": "@podverse/workers",
  "version": "5.3.1",
  "type": "module",
  "description": "Background workers and CLI tools for Podverse",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run lint && tsc && tsc-alias",
    "build:prod": "tsc && tsc-alias",
    "build:watch": "tsc --build --watch --preserveWatchOutput & tsc-alias --watch",
    "lint": "eslint ./src --max-warnings 0",
    "lint:fix": "eslint ./src --fix",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "start": "node ./dist/index.js",
    "archive_all": "node ./dist/index.js archiveAll",
    "mq_rss_add": "node ./dist/index.js mqRSSAdd",
    "mq_rss_add_all": "node ./dist/index.js mqRSSAddAll",
    "mq_rss_add_recently_updated_feeds_from_podcast_index": "node ./dist/index.js mqRSSAddRecentlyUpdatedFeedsFromPodcastIndex",
    "mq_rss_run_live_item_listener": "node ./dist/index.js mqRSSRunLiveItemListener",
    "mq_rss_run_parser": "node ./dist/index.js mqRSSRunParser",
    "mq_add_by_rss_run_parser": "node ./dist/index.js mqAddByRSSRunParser",
    "mq_rss_run_dlq_consumer": "node ./dist/index.js mqRSSRunDlqConsumer",
    "orm_feed_update_flag_status": "node ./dist/index.js ormFeedUpdateFlagStatus",
    "orm_on_demand_parser_event_delete_outdated": "node ./dist/index.js deleteOutdatedOnDemandParserEvent",
    "orm_on_demand_parser_event_generate_reports": "node ./dist/index.js generateOnDemandParserEventReports",
    "parser_rss_parse_feed": "node ./dist/index.js parserRSSParseFeed",
    "podcast_index_dead_feeds_delete_cache": "node ./dist/index.js podcastIndexDeadFeedsDeleteCache",
    "podcast_index_dead_feeds_flag_and_merge": "node ./dist/index.js podcastIndexDeadFeedsFlagAndMerge",
    "podcast_index_trending_podcasts_get": "node ./dist/index.js podcastIndexTrendingPodcastsGet",
    "podcast_index_value_update_all": "node ./dist/index.js podcastIndexValueUpdateAll",
    "stats_update_aggregated": "node ./dist/index.js statsUpdateAggregated"
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "@podverse/external-services-firebase": "*",
    "@podverse/external-services-podcast-index": "*",
    "@podverse/helpers": "*",
    "@podverse/helpers-backend": "*",
    "@podverse/helpers-config": "*",
    "@podverse/mq": "*",
    "@podverse/notifications": "*",
    "@podverse/orm": "*",
    "@podverse/parser": "*",
    "amqplib": "^0.10.9",
    "axios": "^1.13.5",
    "ioredis": "^5.9.2",
    "pg": "^8.16.3",
    "typeorm": "^0.3.26",
    "typeorm-naming-strategies": "^4.1.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.49.0",
    "@types/node": "^24.10.12",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0"
  }
}
