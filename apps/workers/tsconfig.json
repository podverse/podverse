{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "./src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": "./",
    "paths": {
      "@workers/*": ["src/*"],
      "@podverse/orm": ["../../packages/orm/src/index.ts"]
    }
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../../packages/helpers" },
    { "path": "../../packages/external-services-firebase" },
    { "path": "../../packages/external-services-paypal" },
    { "path": "../../packages/external-services-apple-app-store" },
    { "path": "../../packages/external-services-google-play" },
    { "path": "../../packages/external-services-podcast-index" },
    { "path": "../../packages/orm" },
    { "path": "../../packages/mq" },
    { "path": "../../packages/notifications" },
    { "path": "../../packages/billing" },
    { "path": "../../packages/parser" }
  ]
}
