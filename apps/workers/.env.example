#####
##### podverse-workers
#####
# Copy this file to .env and fill in the values.
# See ENV.md for detailed documentation of each variable.

#####
##### General
#####

NODE_ENV="development"

# When blank, built at runtime from BRAND_NAME (format: BrandName Bot Local/Workers/5)
USER_AGENT=

#####
##### Logs
#####

LOG_LEVEL="info"
# No default. Leave empty for console-only (e.g. local/dev or container without file logging).
# When using Docker with a log volume, set to the container path (e.g. /opt/logs for workers compose).
LOG_DIR=
# Set to true to enable log timers
LOG_TIMER="true"

#####
##### Database (Postgres)
#####

DB_HOST="localhost"
DB_PORT="5432"
DB_READ_USERNAME="read"
DB_READ_PASSWORD=
DB_READ_WRITE_USERNAME="read_write"
DB_READ_WRITE_PASSWORD=
DB_DATABASE="podverse_app"
# Set to true for SSL connection
DB_SSL_CONNECTION=

#####
##### Podcast Index
#####

PODCAST_INDEX_BASE_URL="https://api.podcastindex.org/api/1.0"
PODCAST_INDEX_AUTH_KEY=
PODCAST_INDEX_SECRET_KEY=
# Optional: Delay in milliseconds between Podcast Index API requests
# Default is 200ms if not specified. Set to 0 to disable.
PODCAST_INDEX_API_RATE_LIMIT_DELAY="200"

#####
##### Message Queue (RabbitMQ)
#####

MESSAGE_QUEUE_PROTOCOL="amqp"
MESSAGE_QUEUE_HOST="localhost"
MESSAGE_QUEUE_USERNAME="user"
MESSAGE_QUEUE_PASSWORD=
MESSAGE_QUEUE_PORT="5672"

#####
##### Image Shrink (storage)
#####

BUCKET_PROVIDER=
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_REGION=
BUCKET_NAME=
BUCKET_CDN_BASE_URL=

#####
##### Image Shrink
#####

IMAGE_SHRINK_WIDTH_PX="300"
IMAGE_SHRINK_BATCH_SIZE="250"
IMAGE_SHRINK_CONCURRENCY="5"
IMAGE_SHRINK_RPS="2"
IMAGE_SHRINK_RECHECK_TTL_SECONDS="86400"
IMAGE_SHRINK_SOURCE_PRUNE_DAYS="30"

#####
##### Image Shrink Orphan Cleanup
#####

IMAGE_SHRINK_ORPHAN_CLEANUP_DRY_RUN="true"
IMAGE_SHRINK_ORPHAN_CLEANUP_MAX_DELETE=
IMAGE_SHRINK_ORPHAN_CLEANUP_MIN_AGE_DAYS="7"
IMAGE_SHRINK_ORPHAN_CLEANUP_PAGE_SIZE="500"

#####
##### KeyValDB (Redis)
#####

KEYVALDB_HOST="localhost"
KEYVALDB_PORT="6379"
KEYVALDB_PASSWORD=
KEYVALDB_CACHE_TTL_SECONDS="86400"

#####
##### Web Configuration
#####

WEB_PROTOCOL="http"
WEB_DOMAIN="localhost:3000"
WEB_ICON_IMAGE_PATH="/favicon/web-app-manifest-192x192.png"

#####
##### Brand
#####
# Set from dev/env-overrides/local/brand.env by local_env_setup

BRAND_NAME=

#####
##### Google / Firebase (Optional, for push notifications)
#####

# Set to true to enable Firebase notifications
GOOGLE_FIREBASE_NOTIFICATIONS_ENABLED=
# Required if Firebase notifications enabled - absolute path to Firebase admin JSON key file
GOOGLE_FIREBASE_ADMIN_JSON_KEY_PATH=

#####
##### WebPush Notifications (Optional)
#####

# Set to true to enable WebPush notifications
WEBPUSH_ENABLED=
# Required if WebPush enabled - generate with: npx web-push generate-vapid-keys
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=

#####
##### Add-by-RSS
#####
# Required: 64 hex characters (32 bytes) for AES-256-GCM encryption of Basic Auth
# credentials at rest. Generate with: openssl rand -hex 32
ADD_BY_RSS_CREDENTIALS_ENCRYPTION_KEY=

#####
##### Default Account Settings
#####
# These are used as default values when creating new accounts.
DEFAULT_ACCOUNT_SETTINGS_LOCALE="en-US"

#####
##### Parser
#####

# When true, the parser will add remote items to the message queue for processing.
# The parser will recursively follow all remote items until it runs out.
PARSER_ADD_REMOTE_ITEMS_TO_MQ=
