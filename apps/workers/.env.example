#####
##### podverse-workers
#####
# Copy this file to .env and fill in the values.
# See ENV.md for detailed documentation of each variable.

#####
##### General
#####

NODE_ENV="development"

# When blank, built at runtime from BRAND_NAME (format: BrandName Bot Local/Workers/5)
USER_AGENT="Example Bot/Workers/5"

#####
##### Logs
#####

LOG_LEVEL="info"
# No default. Leave empty for console-only (e.g. local/dev or container without file logging).
# When using Docker with a log volume, set to the container path (e.g. /opt/logs for workers compose).
LOG_DIR=
# Set to true to enable log timers
LOG_TIMER="true"

#####
##### Database (Postgres)
#####
# Role names match postgres users from `make local_db_init` / infra (see docs/QUICKSTART.md).

DB_HOST="localhost"
DB_PORT="5432"
DB_APP_NAME="podverse_app"
DB_APP_READ_USER="podverse_app_read"
DB_APP_READ_PASSWORD=
DB_APP_READ_WRITE_USER="podverse_app_read_write"
DB_APP_READ_WRITE_PASSWORD=
# Set to true for SSL connection
DB_SSL_CONNECTION="false"

#####
##### Podcast Index
#####

PODCAST_INDEX_BASE_URL="https://api.podcastindex.org/api/1.0"
PODCAST_INDEX_AUTH_KEY=
PODCAST_INDEX_SECRET_KEY=
# Optional: Delay in milliseconds between Podcast Index API requests
# Default is 200ms if not specified. Set to 0 to disable.
PODCAST_INDEX_API_RATE_LIMIT_DELAY="200"
# Optional: Retries after the first failed Podcast Index API request (default 3).
PODCAST_INDEX_API_MAX_RETRIES="3"
# Optional: Base delay in milliseconds for exponential backoff between retries (default 5000).
PODCAST_INDEX_API_RETRY_BASE_DELAY_MS="5000"

#####
##### Message Queue (RabbitMQ)
#####

MESSAGE_QUEUE_PROTOCOL="amqp"
MESSAGE_QUEUE_HOST="localhost"
MESSAGE_QUEUE_USERNAME="user"
MESSAGE_QUEUE_PASSWORD=
MESSAGE_QUEUE_PORT="5672"

#####
##### Image Shrink (storage)
#####

# BUCKET_PROVIDER: digitalocean | aws-s3 | backblaze-b2 | garage | s3-compatible
# See docs/image-shrinking/BUCKET-PROVIDERS.md
BUCKET_PROVIDER=
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_REGION=
BUCKET_NAME=
BUCKET_CDN_BASE_URL=
# BUCKET_ENDPOINT: required for garage and s3-compatible (S3 API base URL); optional override elsewhere.
BUCKET_ENDPOINT=
# BUCKET_FORCE_PATH_STYLE: true | false | unset (unset = provider default).
BUCKET_FORCE_PATH_STYLE=

#####
##### Image Shrink
#####

IMAGE_SHRINK_WIDTH_PX="400"
IMAGE_SHRINK_WEBP_QUALITY="92"
IMAGE_SHRINK_BATCH_SIZE="250"
IMAGE_SHRINK_CONCURRENCY="5"
IMAGE_SHRINK_RPS="2"
IMAGE_SHRINK_MAX_SOURCE_BYTES="20971520"
IMAGE_SHRINK_RECHECK_EXPIRATION="86400"
IMAGE_SHRINK_DEEP_RECHECK_EXPIRATION="604800"
IMAGE_SHRINK_SOURCE_PRUNE_EXPIRATION="2592000"

#####
##### Image Shrink Orphan Cleanup
#####

IMAGE_SHRINK_ORPHAN_CLEANUP_DRY_RUN="true"
IMAGE_SHRINK_ORPHAN_CLEANUP_MAX_DELETE=
IMAGE_SHRINK_ORPHAN_MIN_AGE_EXPIRATION="604800"
IMAGE_SHRINK_ORPHAN_CLEANUP_PAGE_SIZE="500"

#####
##### KeyValDB (Redis)
#####

KEYVALDB_HOST="localhost"
KEYVALDB_PORT="6379"
KEYVALDB_PASSWORD=
KEYVALDB_CACHE_EXPIRATION="86400"

#####
##### OPML Import
#####
# Max new feeds (Podcast Index enqueue / add-by-RSS) per account per hour. Default 50.
OPML_IMPORT_MAX_FEEDS_PER_HOUR="50"

#####
##### Web Configuration
#####

WEB_PROTOCOL="http"
WEB_DOMAIN="localhost:3000"
WEB_ICON_IMAGE_PATH="http://localhost:3002/favicon/web-app-manifest-192x192.png"

#####
##### Brand
#####
# Set from dev/env-overrides/local/brand.env by local_env_setup

BRAND_NAME=

#####
##### Google / Firebase (Optional, for push notifications)
#####

# Set to true to enable Firebase notifications
GOOGLE_FIREBASE_NOTIFICATIONS_ENABLED=
# Required if Firebase notifications enabled - absolute path to Firebase admin JSON key file
GOOGLE_FIREBASE_ADMIN_JSON_KEY_PATH=

#####
##### WebPush Notifications (Optional)
#####

# Set to true to enable WebPush notifications
WEBPUSH_ENABLED=
# Required if WebPush enabled - generate with: npx web-push generate-vapid-keys
WEBPUSH_VAPID_PUBLIC_KEY=
# Local/dev: set here. Kubernetes: store only in Secret `podverse-workers-webpush-opaque` (not ConfigMap)
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=

#####
##### Add-by-RSS
#####
# Required: 64 hex characters (32 bytes) for AES-256-GCM encryption of Basic Auth
# credentials at rest. Generate with: openssl rand -hex 32
ADD_BY_RSS_CREDENTIALS_ENCRYPTION_KEY=

#####
##### Default Account Settings
#####
# These are used as default values when creating new accounts.
DEFAULT_ACCOUNT_SETTINGS_LOCALE="en-US"

#####
##### Parser
#####

# When true, the parser will add remote items to the message queue for processing.
# The parser will recursively follow all remote items until it runs out.
PARSER_ADD_REMOTE_ITEMS_TO_MQ=

# Max parsed items or live-items before auto-flagging feed as Spam (non-SpamPermitted statuses).
PARSER_SPAM_FEED_ITEM_THRESHOLD_DEFAULT="10000"

# Higher threshold when feed flag status is SpamPermitted (id 7).
PARSER_SPAM_FEED_ITEM_THRESHOLD_SPAM_PERMITTED="100000"

# Max RSS/XML response body bytes for outbound fetch + parser body limit.
# Uses global default of 20 MiB when unset.
PARSER_MAX_FEED_BODY_BYTES=

# How long on-demand parse request records are kept before deleteOutdatedOnDemandParserEvent
# deletes them (default 30 days). A `-days` argument on that command overrides this for one run.
ON_DEMAND_PARSER_EVENT_RETENTION_DAYS="30"

#####
##### Notifications
#####
# How long delivered notification rows are kept before notificationsPlatformPurge deletes them
# (default 30 days). The inbox is a recent activity view, not an archive: every notification points
# at content that still exists elsewhere in the app. Applies to rows already stored, so shortening
# this takes effect on the next purge run.
NOTIFICATION_RETENTION_DAYS="30"

#####
##### Scheduled jobs
#####
# How long finished scheduled_job rows are kept before notificationsPlatformPurge deletes them
# (default 30 days). Separate from NOTIFICATION_RETENTION_DAYS because these are an operational
# record of work the platform did, not something a user reads.
SCHEDULED_JOB_RETENTION_DAYS="30"

#####
##### Stats
#####
# Raw listen track event retention before prune (default 30 days)
STATS_TRACK_EVENT_RETENTION_DAYS="30"

#####
##### Observability
#####
# Contract: docs/operations/observability/TRACING.md
# Template: infra/config/env-templates/observability.env.example
OTEL_SERVICE_NAME="podverse-worker"
OTEL_TRACES_EXPORT="none"
# Long-running Deployment commands only; CronJobs out of scope for v1
OTEL_EXPORTER_OTLP_ENDPOINT=

#####
##### Extensions (sidecar — separate container)
#####
# Shared keys: infra/config/env-templates/extensions.env.example
OTEL_RESOURCE_ATTRIBUTES=

#####
##### Prometheus extension
#####
# When true, set OTEL_* above.
PROMETHEUS_ENABLED=
