# Dependencies
node_modules/

# Build outputs
**/dist/
**/.next/
out/

# Lockfiles
package-lock.json

# TypeScript incremental build cache
**/*.tsbuildinfo

# i18n translation data (do not format; originals/overrides have special structure, compiled is generated)
**/i18n/originals/**
**/i18n/overrides/**
**/i18n/compiled/**

# Generated reports (bundle analyzer, etc.)
**/reports/

# Test assets (generated feeds, chapters, transcripts, media)
tools/test-assets/assets/

# Test coverage
coverage/

# Logs
*.log
npm-debug.log*
logs/*

# Infra config (secrets)
infra/config/local/
infra/config/alpha/

# Env files (secrets)
.env
.env.*
**/.env
**/.env.*

# Misc
*.tgz
.cache/
.llm/plans/

# Mobile native / Expo output (also in apps/mobile/.gitignore).
# Prettier only reads root .gitignore and .prettierignore — not nested gitignores —
# so without these entries `prettier --write .` walks Pods, Gradle, and .cxx trees.
apps/mobile/ios/
apps/mobile/android/
apps/mobile/.expo/
apps/mobile/dist/
apps/mobile/web-build/
apps/mobile/modules/*/android/.gradle/
apps/mobile/modules/*/android/build/
apps/mobile/modules/*/ios/build/
