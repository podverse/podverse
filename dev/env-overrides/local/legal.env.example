# Legal entity (API `config.legal` — e.g. HTML email footer, future terms/UX).
# Prepared by local_env_prepare; applied by local_env_setup. Copy to legal.env and adjust.
# See apps/api/ENV.md.

LEGAL_NAME=
LEGAL_ADDRESS=
# Date-shaped id. Required on API when ACCOUNT_SIGNUP_MODE=user_signup_email.
# Stored on accept. A new value re-prompts every account and is shown as Valid since.
TERMS_OF_SERVICE_VERSION="2026-05-28"
TERMS_OF_SERVICE_CONTENT_DIR=
CONTACT_EMAIL=
STATS_TRACK_EVENT_RETENTION_DAYS="30"
# Date-shaped id. Always required on API. A new value re-prompts accounts that already
# accepted and is shown as the agreement date.
POPULARITY_TRACKING_AGREEMENT_VERSION="2026-09-11"
# Optional mount. Empty uses the Markdown bundled with the API image.
POPULARITY_TRACKING_CONTENT_DIR=
