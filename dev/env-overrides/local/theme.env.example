# UI theme defaults for web and management-web runtime-config sidecars.
# Prepared by local_env_prepare; edit in ~/.config/podverse/local-env-overrides/ after link.
# Maps to NEXT_PUBLIC_DEFAULT_THEME and NEXT_PUBLIC_SUPPORTED_THEMES in both sidecars (see scripts/local-env/setup.sh).

DEFAULT_UI_THEME="dark"
SUPPORTED_UI_THEMES="all-available"
# Optional remote custom themes JSON URL for both sidecars.
CUSTOM_THEMES_URL=
