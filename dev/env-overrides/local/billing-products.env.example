# Processor store ids for the Premium products (workers: billingSeedProcessorProductsFromEnv)
# Leave a processor's keys empty until it is configured; the seed command skips empty keys.
# PayPal subscription plan ids
BILLING_PRODUCT_PAYPAL_AUTO_RENEW_MONTHLY_PLAN_ID=
BILLING_PRODUCT_PAYPAL_AUTO_RENEW_ANNUAL_PLAN_ID=
# App Store Connect product ids
BILLING_PRODUCT_APPLE_AUTO_RENEW_MONTHLY_ID=
BILLING_PRODUCT_APPLE_AUTO_RENEW_ANNUAL_ID=
BILLING_PRODUCT_APPLE_ONE_TIME_MONTHLY_ID=
BILLING_PRODUCT_APPLE_ONE_TIME_ANNUAL_ID=
# Google Play subscription id and its base plan ids
BILLING_PRODUCT_GOOGLE_SUBSCRIPTION_ID=
BILLING_PRODUCT_GOOGLE_AUTO_RENEW_MONTHLY_BASE_PLAN_ID=
BILLING_PRODUCT_GOOGLE_AUTO_RENEW_ANNUAL_BASE_PLAN_ID=
BILLING_PRODUCT_GOOGLE_PREPAID_MONTHLY_BASE_PLAN_ID=
BILLING_PRODUCT_GOOGLE_PREPAID_ANNUAL_BASE_PLAN_ID=
