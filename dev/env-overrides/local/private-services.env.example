# Optional email provider settings (used when ACCOUNT_SIGNUP_MODE="sign-up")
MAILER_SERVICE=
MAILER_HOST=
MAILER_PORT=
MAILER_USERNAME=
MAILER_PASSWORD=
MAILER_FROM=

# Add-by-RSS feed credentials encryption (64 hex chars; generate with: openssl rand -hex 32)
# Set manually in private-services.env; not generated by setup.
ADD_BY_RSS_CREDENTIALS_ENCRYPTION_KEY=

# Optional payment provider settings
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
