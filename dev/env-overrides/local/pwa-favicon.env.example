# PWA web app manifest + head favicon links. Prepared by local_env_prepare; applied by local_env_setup
# to web and management-web sidecars (matches app/manifest.ts and Head/FavIcons fallbacks).
# Path-absolute values use files under public/favicon/ in the image; set https://… to white-label.
# Manifest `name` and `short_name` follow NEXT_PUBLIC_BRAND_NAME (set via brand.env / sidecar).

#####
##### PWA manifest (icons + theme; defaults = embedded assets)
#####
NEXT_PUBLIC_PWA_ICON_192_URL="/favicon/web-app-manifest-192x192.png"
NEXT_PUBLIC_PWA_ICON_512_URL="/favicon/web-app-manifest-512x512.png"
NEXT_PUBLIC_PWA_THEME_COLOR="#ffffff"
NEXT_PUBLIC_PWA_BACKGROUND_COLOR="#ffffff"

#####
##### Document head – favicon / touch icon
#####
NEXT_PUBLIC_FAVICON_ICO_URL="/favicon/favicon.ico"
NEXT_PUBLIC_FAVICON_SVG_URL="/favicon/favicon.svg"
NEXT_PUBLIC_FAVICON_PNG_96_URL="/favicon/favicon-96x96.png"
NEXT_PUBLIC_APPLE_TOUCH_ICON_URL="/favicon/apple-touch-icon.png"
