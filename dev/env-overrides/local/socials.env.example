# Contact and social links. Prepared by local_env_prepare; applied by local_env_setup.
# Shared between web (footer/contact), API (email templates), and mobile (error-log email).
# Edit socials.env and run make local_env_setup.

#####
##### API / email templates – social (page URL + image URL per platform)
#####
SOCIAL_FACEBOOK_PAGE_URL=
SOCIAL_FACEBOOK_IMAGE_URL=
SOCIAL_GITHUB_PAGE_URL=
SOCIAL_GITHUB_IMAGE_URL=
SOCIAL_TWITTER_PAGE_URL=
SOCIAL_TWITTER_IMAGE_URL=
SOCIAL_REDDIT_PAGE_URL=
SOCIAL_REDDIT_IMAGE_URL=

#####
##### Contact
#####
NEXT_PUBLIC_CONTACT_EMAIL=

#####
##### Web – social links (footer / contact page)
#####
# Leave empty to hide a link
NEXT_PUBLIC_SOCIAL_ACTIVITY_PUB=
NEXT_PUBLIC_SOCIAL_DISCORD=
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_MATRIX=
NEXT_PUBLIC_SOCIAL_X=
