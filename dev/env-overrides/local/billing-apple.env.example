# Apple App Store Server credentials (API + workers)
# "true" turns Apple In-App Purchase on (credentials below are then required); empty keeps it off
BILLING_APPLE_IAP_ENABLED=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY_PATH=
APPLE_IAP_BUNDLE_ID="com.podverse.app.next"
APPLE_IAP_APP_APPLE_ID=
# Optional override: sandbox or production. Defaults to NODE_ENV-based resolution when blank.
# "xcode" grants membership for Xcode StoreKit Testing purchases in the simulator and needs only
# APPLE_IAP_BUNDLE_ID (issuer, key id, and .p8 path may stay empty). Local only.
APPLE_IAP_ENVIRONMENT=
