# MetaBoost (MB1). Prepared by local_env_prepare; applied by local_env_setup.
# Optional: set web vars when testing MetaBoost flows locally (e.g. Donate page).
# Optional: set API vars when testing AppAssertion mint (POST .../metaboost/mbrss-v1/mint-app-assertion); set both or neither.

#####
##### API MetaBoost (Optional — AppAssertion signing)
#####
METABOOST_SIGNING_KEY_PEM=
METABOOST_APP_ASSERTION_ISS=

#####
##### App MetaBoost (Optional — Web runtime config)
#####
NEXT_PUBLIC_APP_VALUE_METABOOST_STANDARD=
NEXT_PUBLIC_APP_VALUE_METABOOST_NODE=
