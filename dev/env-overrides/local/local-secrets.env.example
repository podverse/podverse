# Auto-generated local infrastructure secrets (DB, MQ, Valkey, JWT).
# Stored in ~/.config/podverse/local-env-overrides/local-secrets.env (via make local_env_link).
# setup.sh reads these values for every work tree; newly generated secrets are written here once.
# Do not commit the real file — only this example is in git.

# App Postgres (podverse_app)
DB_APP_OWNER_PASSWORD=
DB_APP_MIGRATOR_PASSWORD=
DB_APP_READ_PASSWORD=
DB_APP_READ_WRITE_PASSWORD=

# Management Postgres (podverse_management)
DB_MANAGEMENT_OWNER_PASSWORD=
DB_MANAGEMENT_MIGRATOR_PASSWORD=
DB_MANAGEMENT_READ_PASSWORD=
DB_MANAGEMENT_READ_WRITE_PASSWORD=

# Message queue (Artemis)
ARTEMIS_PASSWORD=

# Valkey / Redis
KEYVALDB_PASSWORD=

# JWT (main API vs management API — distinct secrets)
AUTH_JWT_SECRET_API=
AUTH_JWT_SECRET_MANAGEMENT=
