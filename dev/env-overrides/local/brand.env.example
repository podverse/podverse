# Brand name, domain, user-agent, optional logos, app shell + document head assets. Prepared by local_env_prepare; applied by local_env_setup.
# api/web = BRAND_NAME, BRAND_DOMAIN. mgmt api/mgmt web = MANAGEMENT_BRAND_NAME. Do not set NEXT_PUBLIC_BRAND_NAME in overrides (local_env_setup sets it from BRAND_NAME / MANAGEMENT_BRAND_NAME).
# Path-absolute values use files under public/favicon/; set https://… to white-label. Installable app `name` / `short_name` use NEXT_PUBLIC_BRAND_NAME (from BRAND_NAME via setup; matches app/manifest.ts and head fallbacks).

BRAND_NAME="Podverse"
BRAND_DOMAIN="podverse.fm"
MANAGEMENT_BRAND_NAME="Podverse Management"

# Primary brand accent (CSS hex). API (e.g. email CTA). When `NEXT_PUBLIC_BRAND_THEME_COLOR` is unset, local_env_setup copies `BRAND_COLOR_PRIMARY` to the web sidecar; set `NEXT_PUBLIC_BRAND_THEME_COLOR` in this file to use a different UI tint.
BRAND_COLOR_PRIMARY="#2968B1"
# App / shell background; local_env_setup writes NEXT_PUBLIC_BRAND_BACKGROUND_COLOR to web/management sidecars. Legacy: BRAND_COLOR_BACKGROUND.
BRAND_BACKGROUND_COLOR="#ffffff"

# Brand logo image paths (web header). Override for white-label.
BRAND_LOGO_DARK="/branding/logo-dark.svg"
BRAND_LOGO_LIGHT="/branding/logo.svg"

# Absolute URL for the 3:1 brand banner (API HTML email template; other uses may follow). Example: public web host.
BRAND_BANNER_IMAGE_3X1_URL="http://localhost:3002/branding/banner_3x1.png"

#####
##### Brand: app + document chrome (install icons, theme, tab/touch icons; optional — defaults = embedded assets)
#####
NEXT_PUBLIC_BRAND_APP_ICON_192_URL="/favicon/web-app-manifest-192x192.png"
NEXT_PUBLIC_BRAND_APP_ICON_512_URL="/favicon/web-app-manifest-512x512.png"
NEXT_PUBLIC_BRAND_FAVICON_ICO_URL="/favicon/favicon.ico"
NEXT_PUBLIC_BRAND_FAVICON_SVG_URL="/favicon/favicon.svg"
NEXT_PUBLIC_BRAND_FAVICON_PNG_96_URL="/favicon/favicon-96x96.png"
NEXT_PUBLIC_BRAND_APPLE_TOUCH_ICON_URL="/favicon/apple-touch-icon.png"
