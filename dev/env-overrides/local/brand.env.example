# Brand name, domain, and user-agent. Prepared by local_env_prepare.
# api/web = BRAND_NAME, BRAND_DOMAIN. mgmt api/mgmt web = MANAGEMENT_BRAND_NAME. Do not set NEXT_PUBLIC_* in overrides.

BRAND_NAME="Podverse"
BRAND_DOMAIN="podverse.fm"
MANAGEMENT_BRAND_NAME="Podverse Management"

# Brand logo image paths (optional). Override to use custom logos instead of the default SVGs.
# BRAND_LOGO_DARK= Logo for dark backgrounds (defaults to /branding/podverse-brand-white.svg)
# BRAND_LOGO_LIGHT= Logo for light backgrounds (defaults to /branding/podverse-brand-black.svg)
