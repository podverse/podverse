# API HTTP rate-limit knobs (window encoded in suffix; no separate window env vars).
# Keep production defaults conservative unless intentionally changing abuse controls.

AUTH_LOGIN_MAX_PER_MINUTE="5"
ACCOUNT_CREATE_MAX_PER_10_MINUTES="3"
ACCOUNT_SEND_VERIFICATION_EMAIL_MAX_PER_10_MINUTES="4"
ACCOUNT_VERIFY_EMAIL_MAX_PER_10_MINUTES="10"
ACCOUNT_SEND_CHANGE_EMAIL_MAX_PER_10_MINUTES="4"
ACCOUNT_VERIFY_EMAIL_CHANGE_MAX_PER_10_MINUTES="10"
ACCOUNT_SEND_RESET_PASSWORD_EMAIL_MAX_PER_10_MINUTES="4"
ACCOUNT_RESET_PASSWORD_MAX_PER_10_MINUTES="4"
ACCOUNT_SET_PASSWORD_MAX_PER_10_MINUTES="4"
ACCOUNT_DOWNLOAD_DATA_MAX_PER_DAY="3"
ACCOUNT_OPML_EXPORT_MAX_PER_HOUR="10"
ACCOUNT_OPML_IMPORT_ENQUEUE_MAX_PER_HOUR="10"
ACCOUNT_ADD_BY_RSS_PARSE_ENQUEUE_MAX_PER_HOUR="20"
ACCOUNT_ADD_BY_RSS_CHAPTERS_TRANSCRIPT_MAX_PER_MINUTE="30"
ACCOUNT_ADD_BY_RSS_REMOTE_ITEM_RESOLVE_MAX_PER_MINUTE="30"
ACCOUNT_CHANNEL_SEEN_READ_MAX_PER_MINUTE="60"
STATS_TRACK_MAX_PER_MINUTE="60"
MQ_RSS_ON_DEMAND_MAX_PER_HOUR="20"

# Per-listener stats write limits (not HTTP limits).
STATS_LISTEN_DAILY_STORED_CAP="300"
STATS_LISTEN_MIN_INTERVAL_SECONDS="20"
STATS_LISTEN_DAILY_POPULARITY_CAP="100"
STATS_OPEN_DAILY_CAP="10"
STATS_ALL_TIME_RECOUNT_DAYS="90"
STATS_FLAG_TOO_SOON_MINUTES="30"
STATS_FLAG_STORED_CAP_WITHIN_HOURS="3"

# OPML soft cap shared by API + workers (distinct from HTTP enqueue 429 limits).
OPML_IMPORT_MAX_FEEDS_PER_HOUR="50"
