# Billing settings shared by every payment processor (API + workers)
# Public HTTPS base that forwards to the local API, so processors can deliver webhooks.
# No trailing slash. Webhook URLs are <base>/api/v2/billing/webhooks/<paypal|apple|google>.
BILLING_WEBHOOK_PUBLIC_BASE_URL=
# Seconds access continues past an auto-renew period end while the renewal webhook arrives (48 hours)
BILLING_RENEWAL_ENTITLEMENT_BUFFER_EXPIRATION="172800"
# Seconds access continues after a failed renewal charge while the processor retries (7 days)
BILLING_PAYMENT_FAILURE_GRACE_EXPIRATION="604800"
# Comma-separated account ids or id_text values whose sandbox purchases count in production
BILLING_SANDBOX_ALLOWED_ACCOUNT_IDS=
