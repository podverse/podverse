# Shared local API endpoint for web + mobile.
# Define once; scripts/local-env/setup.sh derives:
# - web sidecar NEXT_PUBLIC_API_* vars
# - mobile EXPO_PUBLIC_MOBILE_API_BASE_URL_{IOS,ANDROID}
# Android emulator host auto-derives to 10.0.2.2 when host is localhost/127.0.0.1.

LOCAL_API_PROTOCOL="http"
LOCAL_API_HOST="localhost"
LOCAL_API_PORT="3000"
LOCAL_API_PREFIX="/api"
LOCAL_API_VERSION="/v2"
