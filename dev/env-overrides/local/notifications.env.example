# Optional Firebase/WebPush notification settings
GOOGLE_FIREBASE_NOTIFICATIONS_ENABLED=
GOOGLE_FIREBASE_ADMIN_JSON_KEY_PATH=
WEBPUSH_ENABLED=
WEBPUSH_VAPID_SUBJECT="mailto:contact@example.com"

# WebPush VAPID keys (fill manually; generate with: npx web-push generate-vapid-keys)
# Not auto-filled by setup.
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
