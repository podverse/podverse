# Docker Network
.PHONY: local_network_create
local_network_create:
	docker network create podverse_local_network 2>/dev/null || true

.PHONY: local_network_remove
local_network_remove:
	docker network rm podverse_local_network 2>/dev/null || true

# Database
.PHONY: local_db_up
local_db_up: local_network_create infra/config/local/db.env
	docker compose -f infra/docker/local/db/docker-compose.yml up podverse_local_db -d

.PHONY: local_db_down
local_db_down:
	docker compose -f infra/docker/local/db/docker-compose.yml down --remove-orphans

.PHONY: local_db_reset
local_db_reset:
	@echo "Dropping and recreating public schema..."
	docker exec -i podverse_local_db psql -U postgres -d postgres -c "DROP SCHEMA public CASCADE; CREATE SCHEMA public; GRANT ALL ON SCHEMA public TO postgres; GRANT ALL ON SCHEMA public TO public;"

.PHONY: local_db_init
local_db_init: infra/config/local/db.env
	@echo "Waiting for database to be ready..."
	@until docker exec podverse_local_db pg_isready -U postgres > /dev/null 2>&1; do \
		echo "  Database not ready, waiting..."; \
		sleep 2; \
	done
	@echo "Creating read/read_write roles (idempotent)..."
	@set -a; . infra/config/local/db.env; set +a; \
	docker compose -f infra/docker/local/db/docker-compose.yml exec podverse_local_db bash -c "POSTGRES_READ_PASSWORD=$$POSTGRES_READ_PASSWORD POSTGRES_READ_WRITE_PASSWORD=$$POSTGRES_READ_WRITE_PASSWORD /opt/database/init-scripts/01-create-users.sh"
	docker exec -i podverse_local_db psql -U postgres -d postgres -f /opt/database/combined/init_database.sql
	@echo "Seeding local dev account..."
	docker exec -i podverse_local_db psql -U postgres -d postgres -f /opt/database/seed-scripts/local-dev-account.sql

# Message Queue
.PHONY: local_mq_up
local_mq_up: local_network_create infra/config/local/mq.env
	docker compose -f infra/docker/local/mq/docker-compose.yml up podverse_local_mq -d
	@./scripts/mq/provision_queues.sh podverse_local_mq infra/config/local/mq.env

.PHONY: local_mq_down
local_mq_down:
	docker compose -f infra/docker/local/mq/docker-compose.yml down --remove-orphans

# Key-Value Database
.PHONY: local_keyvaldb_up
local_keyvaldb_up: local_network_create infra/config/local/keyvaldb.env
	docker compose -f infra/docker/local/keyvaldb/docker-compose.yml up podverse_local_keyvaldb -d
	docker compose -f infra/docker/local/keyvaldb/docker-compose.yml up podverse_local_keyvaldb_gui -d

.PHONY: local_keyvaldb_down
local_keyvaldb_down:
	docker compose -f infra/docker/local/keyvaldb/docker-compose.yml down --remove-orphans

# Boostbox (V4V boost metadata API; repo is sibling to podverse - see docs/infra/LOCAL-BOOSTBOX.md)
.PHONY: local_build_boostbox
local_build_boostbox:
	@if [ ! -d "../boostbox" ]; then \
		echo "ERROR: ../boostbox is not a directory. Clone the boostbox repo as a sibling of the podverse monorepo (see docs/infra/LOCAL-BOOSTBOX.md)."; \
		exit 1; \
	fi
	@if [ ! -f "../boostbox/Dockerfile" ]; then \
		echo "ERROR: ../boostbox/Dockerfile not found. Add a Dockerfile to the boostbox repo."; \
		exit 1; \
	fi
	docker build -f ../boostbox/Dockerfile -t boostbox:latest ../boostbox

.PHONY: local_boostbox_up
local_boostbox_up: local_network_create infra/config/local/boostbox.env
	docker compose -f infra/docker/local/boostbox/docker-compose.yml up podverse_local_boostbox -d

.PHONY: local_boostbox_down
local_boostbox_down:
	docker compose -f infra/docker/local/boostbox/docker-compose.yml down --remove-orphans

# Test-assets server (tools/test-assets). Serves feeds/media at http://localhost:2111. Workers local image uses an entrypoint that proxies localhost:2111 to podverse_local_test_assets:2111 (see infra/docker/local/workers/).
.PHONY: local_build_test_assets
local_build_test_assets:
	docker build -f infra/docker/local/test-assets/Dockerfile -t podverse-test-assets:latest .

.PHONY: local_test_assets_up
local_test_assets_up: local_network_create infra/config/local/test-assets.env
	docker compose -f infra/docker/local/test-assets/docker-compose.yml up podverse_local_test_assets -d

.PHONY: local_test_assets_down
local_test_assets_down:
	docker compose -f infra/docker/local/test-assets/docker-compose.yml down --remove-orphans

# Management Database
.PHONY: local_management_db_up
local_management_db_up: local_network_create infra/config/local/management-db.env
	docker compose -f infra/docker/local/management-db/docker-compose.yml up podverse_local_management_db -d

.PHONY: local_management_db_down
local_management_db_down:
	docker compose -f infra/docker/local/management-db/docker-compose.yml down --remove-orphans

.PHONY: local_workers_down
local_workers_down:
	docker compose -f infra/docker/local/workers/docker-compose.yml down --remove-orphans

.PHONY: local_management_db_reset
local_management_db_reset:
	@echo "Dropping and recreating public schema..."
	docker exec -i podverse_local_management_db psql -U postgres -d postgres -c "DROP SCHEMA public CASCADE; CREATE SCHEMA public; GRANT ALL ON SCHEMA public TO postgres; GRANT ALL ON SCHEMA public TO public;"

.PHONY: local_management_db_init
local_management_db_init: infra/config/local/management-db.env
	@echo "Validating required environment variables..."
	@set -a; . infra/config/local/management-db.env; set +a; \
	: "$${SUPERUSER_EMAIL:?Missing SUPERUSER_EMAIL}" \
	: "$${SUPERUSER_PASSWORD:?Missing SUPERUSER_PASSWORD}"
	@echo "Waiting for management database to be ready..."
	@until docker exec podverse_local_management_db pg_isready -U postgres > /dev/null 2>&1; do \
		echo "  Management database not ready, waiting..."; \
		sleep 2; \
	done
	@echo "Creating read/read_write roles (idempotent)..."
	@set -a; . infra/config/local/management-db.env; set +a; \
	docker compose -f infra/docker/local/management-db/docker-compose.yml exec podverse_local_management_db bash -c "POSTGRES_READ_PASSWORD=$$POSTGRES_READ_PASSWORD POSTGRES_READ_WRITE_PASSWORD=$$POSTGRES_READ_WRITE_PASSWORD /opt/database/management/init-scripts/01-create-users.sh"
	docker exec -i podverse_local_management_db psql -U postgres -d postgres -f /opt/database/management/init_management_database.sql
	@echo "Creating superuser account..."
	@set -a; . infra/config/local/management-db.env; set +a; \
	docker run --rm \
	  --network podverse_local_network \
	  -v "$$(pwd)/scripts/management:/opt/scripts/management" \
	  -w /opt/scripts/management \
	  -e SUPERUSER_EMAIL="$$SUPERUSER_EMAIL" \
	  -e SUPERUSER_PASSWORD="$$SUPERUSER_PASSWORD" \
	  -e DB_HOST="podverse_local_management_db" \
	  -e DB_PORT="5432" \
	  -e DB_DATABASE="$${POSTGRES_DB:-postgres}" \
	  -e POSTGRES_USER="$${POSTGRES_USER:-postgres}" \
	  -e POSTGRES_PASSWORD="$$POSTGRES_PASSWORD" \
	  node:24-slim \
	  sh -c "npm install && node create-superuser.mjs"

# Start all local infrastructure services (use this to restart after local_all_down)
.PHONY: local_infra_up
local_infra_up: local_db_up local_mq_up local_keyvaldb_up local_management_db_up local_boostbox_up local_test_assets_up
	@echo "All local infrastructure services started"

# Complete local setup (infrastructure + database initialization)
# Only run this once for initial setup, or after local_clean
.PHONY: local_setup
local_setup: local_infra_up local_db_init local_management_db_init
	@echo ""
	@echo "============================================"
	@echo "Local environment ready!"
	@echo "============================================"
	@echo ""
	@echo "Next steps:"
	@echo "  1. npm run build:packages"
	@echo "  2. npm run dev:main:all (or dev:all for everything)"
	@echo ""
	@echo "To restart services later: make local_infra_up"
	@echo ""

# Stop all local infrastructure services
.PHONY: local_all_down
local_all_down:
	-$(MAKE) local_workers_down
	-$(MAKE) local_boostbox_down
	-$(MAKE) local_test_assets_down
	-$(MAKE) local_keyvaldb_down
	-$(MAKE) local_mq_down
	-$(MAKE) local_db_down
	-$(MAKE) local_management_db_down

# Clean local environment (containers + volumes), but preserve images for faster restart.
# Tear down app stacks first so the network has no endpoints, then remove and recreate network on next setup.
.PHONY: local_clean
local_clean:
	docker compose -f infra/docker/local/db/docker-compose.yml down -v 2>/dev/null || true
	docker compose -f infra/docker/local/mq/docker-compose.yml down -v 2>/dev/null || true
	docker compose -f infra/docker/local/keyvaldb/docker-compose.yml down -v 2>/dev/null || true
	docker compose -f infra/docker/local/management-db/docker-compose.yml down -v 2>/dev/null || true
	docker compose -f infra/docker/local/boostbox/docker-compose.yml down --remove-orphans 2>/dev/null || true
	docker compose -f infra/docker/local/test-assets/docker-compose.yml down --remove-orphans 2>/dev/null || true
	-$(MAKE) local_workers_down
	docker compose -f infra/docker/local/api/docker-compose.yml down --remove-orphans 2>/dev/null || true
	docker compose -f infra/docker/local/web/docker-compose.yml down --remove-orphans 2>/dev/null || true
	docker compose -f infra/docker/local/management-api/docker-compose.yml down --remove-orphans 2>/dev/null || true
	docker compose -f infra/docker/local/management-web/docker-compose.yml down --remove-orphans 2>/dev/null || true
	$(MAKE) local_network_remove
	@echo "Local environment cleaned. Images preserved for faster restart."

# Remove only Podverse-specific images and build cache, preserving external images (postgres, valkey, artemis)
.PHONY: local_prune_podverse_images
local_prune_podverse_images:
	@echo "Removing Podverse-specific images..."
	docker images --filter=reference='*podverse*' -q | xargs -r docker rmi 2>/dev/null || true
	docker images --filter=reference='ghcr.io/podverse/*' -q | xargs -r docker rmi 2>/dev/null || true
	@echo "Clearing Docker build cache..."
	docker builder prune -f 2>/dev/null || true
	@echo "Done. External images (postgres, valkey, artemis) preserved."

# Stop all app containers and remove Podverse images; volumes are retained.
.PHONY: local_teardown_apps
local_teardown_apps:
	$(MAKE) local_stop_all_apps
	$(MAKE) local_prune_podverse_images
