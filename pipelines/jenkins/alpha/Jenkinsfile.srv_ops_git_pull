pipeline {
    // Maps to <assignedNode>pv-alpha-srv</assignedNode>
    agent {
        label 'pv-alpha-srv'
    }

    // Maps to <concurrentBuild>false</concurrentBuild>
    options {
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        string(
            name: 'GIT_BRANCH_NAME', 
            defaultValue: 'develop', 
            description: 'The git branch name to check out, before pulling the latest changes for the branch.'
        )
    }

    stages {
        stage('Update Ops Repo') {
            steps {
                script {
                    // Maps to 'pushd /opt/podverse'
                    dir('/opt/podverse') {
                        // Ensure sparse checkout is enabled
                        sh '''
                            git config core.sparseCheckout true
                        '''
                        
                        // Update sparse checkout paths to match current requirements
                        sh '''
cat > .git/info/sparse-checkout << 'EOF'
pipelines/jenkins/
infra/docker/
infra/config/
scripts/
database/
Makefile
Makefile.alpha
EOF
                        '''
                        
                        // Maps to the git commands using the parameter
                        sh """
                            rm /opt/podverse/infra/docker/alpha/api/docker-compose.yml || true
                            rm /opt/podverse/infra/docker/alpha/web/docker-compose.yml || true
                            git checkout ${params.GIT_BRANCH_NAME}
                            git pull origin ${params.GIT_BRANCH_NAME}
                            
                            # Reapply sparse checkout to ensure all paths are present
                            git sparse-checkout reapply || git read-tree -mu HEAD
                        """
                    }
                }
            }
        }
    }
}
